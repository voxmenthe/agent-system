{
  "cleanupPeriodDays": 99999,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5-5",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "365000",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "6",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "12",
    "OMEM_HOST": "claude",
    "CLAUDE_CODE_ARTIFACT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "skillOverrides": {
    "prepare-context": "off",
    "recent-commits-digest": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory hook claude",
            "timeout": 3,
            "statusMessage": "Loading memory turn context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "memory hook claude",
            "timeout": 3,
            "statusMessage": "Loading memory recovery checkpoint"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "hist hook claude SessionStart",
            "timeout": 5,
            "statusMessage": "Loading session history"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hist hook claude SubagentStart",
            "timeout": 5,
            "statusMessage": "Loading session history"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B @HOME@/.claude/hooks/persistent-guidance/projection_edit_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B @HOME@/.claude/hooks/persistent-guidance/piped_status_warning.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "printf '\\033[1;33m%s\\033[0m ' \"$(basename \"$(pwd)\")\""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "composio@composio": true
  },
  "extraKnownMarketplaces": {
    "huggingface-skills": {
      "source": {
        "source": "github",
        "repo": "huggingface/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "composio": {
      "source": {
        "source": "git",
        "url": "https://github.com/ComposioHQ/composio-plugin-cc.git"
      }
    }
  },
  "promptCacheTtl": "1h",
  "alwaysThinkingEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "idleCompaction": false,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
