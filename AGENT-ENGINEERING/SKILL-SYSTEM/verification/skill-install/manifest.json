    "sha256": "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
  },
  "checks": [
    {
      "config": "journal-stops.cfg",
      "expect": "pass",
      "quick": true,
      "what": "every property, two skills, three operations, stops after journal writes, newest-first rollbacks",
      "timeoutSeconds": 60
    },
    {
      "config": "one-skill-any-order.cfg",
      "expect": "pass",
      "quick": true,
      "what": "every property, one skill, four operations, any rollback order the code accepts",
      "timeoutSeconds": 60
    },
    {
      "config": "every-window.cfg",
      "expect": "pass",
      "quick": true,
      "what": "every property, two skills, three operations, a stop anywhere, any rollback order the code accepts",
      "timeoutSeconds": 60
    },
    {
      "config": "journal-stops-four.cfg",
      "expect": "pass",
      "quick": false,
      "what": "every property, two skills, four operations, stops after journal writes, newest-first rollbacks",
      "timeoutSeconds": 60
    },
    {
      "config": "every-window-four.cfg",
      "expect": "pass",
      "quick": false,
      "what": "every property, two skills, four operations, a stop anywhere, any rollback order the code accepts",
      "timeoutSeconds": 180
    },
    {
      "config": "mutations/a-rollback-crosses-newer.cfg",
      "expect": "NoStuckRollback",
      "quick": true,
      "what": "rollback without _ensure_no_newer_active_operation",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/c-rollback-keeps-state.cfg",
      "expect": "RollbackRestores",
      "quick": true,
      "what": "rollback without _restore_state_entry",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/d-quarantine-keeps-entry.cfg",
      "expect": "StatusAgrees",
      "quick": true,
      "what": "quarantine without removing the managed entry",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/f-rollback-skips-aside.cfg",
      "expect": "NoStuckRollback",
      "quick": true,
      "what": "rollback without moving the new tree aside",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/g-rollback-restores-whole-state.cfg",
      "expect": "RollbackStaysOnItsSkill",
      "quick": true,
      "what": "F1 before its fix: rollback writes back the whole saved install state",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/h-rollback-trusts-phase-for-new-tree.cfg",
      "expect": "NoStuckRollback",
      "quick": true,
      "what": "line 799 deciding from the journaled phase, as before F3's fix; the occupied-target check makes the rollback refuse",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/i-rollback-trusts-prepared-phase.cfg",
      "expect": "NoStuckRollback",
      "quick": true,
      "what": "F2 before its fix: a prepared operation is taken to have moved nothing",
      "timeoutSeconds": 60
    },
    {
      "config": "mutations/j-rollback-unjournaled.cfg",
      "expect": "StatusAgrees",
      "quick": true,
      "what": "F4 before its fix: rollback journals nothing until it ends",
      "timeoutSeconds": 60
    }
  ],
