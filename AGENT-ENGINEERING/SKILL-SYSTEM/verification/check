#!/usr/bin/env python3
"""Model-check one verification target with TLC, and check that the code its model
describes has not changed since the model was last confirmed against it.

    check TARGET                    every check in TARGET/manifest.json
    check TARGET --quick            only the checks marked quick
    check TARGET --update-coverage  re-record the covered code at HEAD, after
                                    confirming that the model describes it

TARGET is a directory beside this script, one per verified area. Exit 0: every
check passed, every mutation and finding was caught, and no covered code drifted.
Exit 1: a check failed, a mutation or finding was not caught, covered code
drifted, or the verify skill named in the manifest does not name the sync
commit. Exit 2: could not run (no Java, an unverified TLA+ jar, a TLC error, a
check over its timeoutSeconds, or a bad manifest). Full TLC output for each run
is written to TARGET/runs/.
"""
from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from dataclasses import dataclass
from pathlib import Path

HERE = Path(__file__).resolve().parent
_TOPLEVEL = subprocess.run(["git", "-C", str(HERE), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True)
REPO = Path(_TOPLEVEL.stdout.strip()) if _TOPLEVEL.returncode == 0 else None
JAVA_HOMES = (Path("/opt/homebrew/opt"), Path("/usr/local/opt"))
STATE = re.compile(r"^State (\d+): <([^\s>]+)", re.M)
ASSIGN = re.compile(r"^/\\ (\w+) = (.*)$", re.M)
# How a liveness counterexample ends: a loop back to an earlier state, or stuttering forever.
LOOP_BACK = re.compile(r"^Back to state (\d+): <([^\s>]+)", re.M)
STUTTERING = re.compile(r"^State (\d+): Stuttering$", re.M)
# Where a new verify skill names the sync commit; the first --update-coverage writes the commit there.
UNSYNCED = "<sync-commit>"


class CouldNotRun(Exception):
    pass


@dataclass(frozen=True)
class Outcome:
    violated: str | None    # the violated invariant or property, or None for a pass
    states: str
    seconds: float
    log: Path


def read_manifest(target: Path) -> dict:
    path = target / "manifest.json"
    if not path.is_file():
        raise CouldNotRun(f"no manifest at {path.relative_to(REPO)}")
    return json.loads(path.read_text())


def find_java() -> str:
    # Homebrew's openjdk is keg-only, so it is usually not on PATH; macOS's
    # /usr/bin/java is a stub that fails without a JDK.
    candidates = [shutil.which("java") or "java"]
    for root in JAVA_HOMES:
        if root.is_dir():
            candidates += sorted(str(p / "bin/java") for p in root.glob("openjdk*"))
    for candidate in candidates:
        try:
            probe = subprocess.run([candidate, "-version"], capture_output=True)
        except OSError:
            continue
        if probe.returncode == 0:
            return candidate
    raise CouldNotRun("no Java runtime (TLC needs Java 11+); install one, e.g. `brew install openjdk@21`")


def tla_jar(tools: dict) -> Path:
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    jar = cache / "tla2tools" / tools["version"] / "tla2tools.jar"
    if not jar.is_file():
        jar.parent.mkdir(parents=True, exist_ok=True)
        partial = jar.with_suffix(".part")
        try:
            with urllib.request.urlopen(tools["url"], timeout=120) as response:
                partial.write_bytes(response.read())
        except OSError as error:
            raise CouldNotRun(f"cannot download {tools['url']}: {error}") from error
        partial.replace(jar)
    digest = hashlib.sha256(jar.read_bytes()).hexdigest()
    if digest != tools["sha256"]:
        raise CouldNotRun(f"{jar} has sha256 {digest}, expected {tools['sha256']}; delete it and rerun")
    return jar


def run_tlc(java: str, jar: Path, target: Path, spec: str, config: str, timeout: float | None) -> Outcome:
    log = target / "runs" / (config.replace("/", "--").removesuffix(".cfg") + ".log")
    log.parent.mkdir(exist_ok=True)
    started = time.monotonic()
    with tempfile.TemporaryDirectory(prefix="tlc-") as metadir:
        try:
            result = subprocess.run(
                [java, "-XX:+UseParallelGC", "-cp", str(jar), "tlc2.TLC", "-workers", "auto",
                 "-metadir", metadir, "-config", config, spec],
                cwd=target, capture_output=True, text=True, timeout=timeout,
            )
        except subprocess.TimeoutExpired as expired:
            # On POSIX the partial output comes back as bytes, even with text=True.
            output = "".join(part.decode(errors="replace") if isinstance(part, bytes) else part or ""
                             for part in (expired.stdout, expired.stderr))
            log.write_text(output)
            found = re.findall(r"([\d,]+) distinct states found", output)
            progress = f"{found[-1]} distinct states" if found else "none printed"
            raise CouldNotRun(f"{config} exceeded its {timeout:g} s timeoutSeconds (last progress: {progress}); "
                              f"see {log.relative_to(REPO)}") from expired
    seconds = time.monotonic() - started
    output = result.stdout + result.stderr
    log.write_text(output)
    found = re.findall(r"([\d,]+) distinct states found", output)
    states = found[-1] if found else "?"
    if "Model checking completed. No error has been found." in output:
        return Outcome(None, states, seconds, log)
    violated = re.search(r"Error: (?:Invariant|Action property) (\w+) is violated", output)
    if violated:
        return Outcome(violated[1], states, seconds, log)
    if "Temporal properties were violated" in output:
        # TLC does not name the temporal property; a config checks only one.
        names = re.findall(r"^PROPERTY (\w+)$", (target / config).read_text(), re.M)
        return Outcome(names[0] if len(names) == 1 else "temporal", states, seconds, log)
    raise CouldNotRun(f"TLC did not finish {config}; see {log.relative_to(REPO)}")


def trace_steps(log: Path) -> list[str]:
    """The counterexample as one line per step: the action and the variables it changed."""
    text = log.read_text()
    blocks = STATE.split(text)[1:]
    steps, previous = [], {}
    for number, action, body in zip(blocks[::3], blocks[1::3], blocks[2::3]):
        # TLC prints a long value over several indented lines; join them onto the variable's line.
        state = dict(ASSIGN.findall(re.sub(r"\n(?!/\\ )\s*", " ", body.split("\n\n")[0].strip())))
        changed = [f"{k}={v}" for k, v in state.items() if previous.get(k) != v]
        line = f"  {number}. {action}: " + ", ".join(changed if previous else ["(initial)"] + changed)
        steps.append(line if len(line) <= 400 else line[:397] + "...")
        previous = state
    if loop := LOOP_BACK.search(text):
        steps.append(f"  then {loop[2]}: back to step {loop[1]}, and on from there forever")
    if stutter := STUTTERING.search(text):
        steps.append(f"  {stutter[1]}. Stuttering: nothing changes from here on")
    return steps


def covered_text(entry: dict) -> str:
    path = REPO / entry["file"]
    lines = path.read_text().splitlines(keepends=True)
    kind, unit = entry["kind"], entry["unit"]
    if kind == "sh-function":
        starts = [i for i, line in enumerate(lines) if line.startswith(f"{unit}() {{")]
        ends = [i for i, line in enumerate(lines) if line.rstrip("\n") == "}"]
        if len(starts) != 1:
            raise CouldNotRun(f"{entry['file']}: {len(starts)} definitions of {unit}(); expected one")
        end = next(i for i in ends if i > starts[0])
        return "".join(lines[starts[0]:end + 1])
    if kind == "sh-region":
        first, last = (
            [i for i, line in enumerate(lines) if line.rstrip("\n") == marker]
            for marker in (entry["from"], entry["to"])
        )
        if len(first) != 1 or len(last) != 1 or last[0] < first[0]:
            raise CouldNotRun(f"{entry['file']}: region {unit} needs one 'from' line before one 'to' line")
        return "".join(lines[first[0]:last[0] + 1])
    if kind == "py-function":
        tree = ast.parse("".join(lines))
        nodes = [node for node in _qualified(tree, "") if node[0] == unit]
        if len(nodes) != 1:
            raise CouldNotRun(f"{entry['file']}: {len(nodes)} definitions of {unit}; expected one")
        node = nodes[0][1]
        start = min([node.lineno] + [d.lineno for d in node.decorator_list])
        return "".join(lines[start - 1:node.end_lineno])
    raise CouldNotRun(f"unknown coverage kind {kind!r}")


def _qualified(node: ast.AST, prefix: str):
    for child in ast.iter_child_nodes(node):
        if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            name = f"{prefix}{child.name}"
            if not isinstance(child, ast.ClassDef):
                yield name, child
            yield from _qualified(child, f"{name}.")


def digest(entry: dict) -> str:
    return hashlib.sha256(covered_text(entry).encode()).hexdigest()


def update_coverage(target: Path, manifest: dict) -> None:
    head = subprocess.run(["git", "-C", str(REPO), "rev-parse", "HEAD"],
                          capture_output=True, text=True, check=True).stdout.strip()
    coverage = manifest["coverage"]
    files = sorted({entry["file"] for entry in coverage["code"]})
    if subprocess.run(["git", "-C", str(REPO), "diff", "--quiet", "HEAD", "--", *files]).returncode:
        raise CouldNotRun("covered files differ from HEAD; commit them first, so the sync commit holds the code")
    # The verify skill names the sync commit too, so it is rewritten with the manifest; check that it can be
    # before writing either.
    previous = coverage["syncCommit"][:12] or UNSYNCED
    skill = REPO / manifest["skill"]
    skill_text = skill.read_text() if skill.is_file() else ""
    if previous not in skill_text:
        raise CouldNotRun(f"{manifest['skill']} does not name the sync commit {previous}; write it where the "
                          "skill lists the coverage record, then rerun --update-coverage")
    coverage["syncCommit"] = head
    for entry in coverage["code"]:
        entry["sha256"] = digest(entry)
    (target / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    skill.write_text(skill_text.replace(previous, head[:12]))
    print(f"recorded {len(coverage['code'])} covered units at {head[:12]}")


def main() -> int:
    parser = argparse.ArgumentParser(prog="check", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="a verification directory beside this script")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--quick", action="store_true", help="run only the checks marked quick")
    mode.add_argument("--update-coverage", action="store_true",
                      help="re-record covered code at HEAD after confirming the model describes it")
    args = parser.parse_args()
    if REPO is None:
        raise CouldNotRun(f"{HERE} is not in a git repository; copy check into the repository's verification directory")
    target = HERE / args.target
    manifest = read_manifest(target)
    if args.update_coverage:
        update_coverage(target, manifest)
        return 0

    problems = []
    sync = manifest["coverage"]["syncCommit"][:12]
    for entry in manifest["coverage"]["code"]:
        if digest(entry) != entry["sha256"]:
            problems.append(f"covered code changed since {sync}: {entry['file']} {entry['unit']}")
    drifted = bool(problems)
    skill = REPO / manifest["skill"]
    if not skill.is_file() or sync not in skill.read_text():
        problems.append(f"{manifest['skill']} does not name the sync commit {sync}")

    selected = [check for check in manifest["checks"] if check.get("quick") or not args.quick]
    if selected:
        java, jar = find_java(), tla_jar(manifest["tlaTools"])
    for check in selected:
        outcome = run_tlc(java, jar, target, manifest["spec"], check["config"], check.get("timeoutSeconds"))
        expected = check["expect"]
        caught = outcome.violated == expected
        if expected == "pass":
            verdict = "pass" if outcome.violated is None else f"FAIL: {outcome.violated} violated"
        else:
            verdict = f"caught {expected}" if caught else (
                f"NOT CAUGHT: expected {expected}, got {outcome.violated or 'a pass'}")
        print(f"{check['config']}: {verdict} ({outcome.states} states, {outcome.seconds:.0f}s)")
        if expected == "pass" and outcome.violated is None or caught:
            continue
        problems.append(f"{check['config']}: {verdict}; {check['what']}")
        if outcome.violated:
            print(f"  counterexample ({outcome.log.relative_to(REPO)}):")
            print("\n".join(trace_steps(outcome.log)))

    if not problems:
        print(f"check {args.target}: passed")
        return 0
    sys.stdout.flush()
    print(f"check {args.target}: {len(problems)} problem(s)", file=sys.stderr)
    for problem in problems:
        print(f"  {problem}", file=sys.stderr)
    if drifted:
        print(f"Re-read the drifted code (git diff {sync} -- <file>) against {target.relative_to(REPO)} "
              "and update the model where the behavior changed. Once the model describes the committed "
              "code and the check passes, record it with --update-coverage.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except CouldNotRun as error:
        print(f"check: could not run: {error}", file=sys.stderr)
        sys.exit(2)
