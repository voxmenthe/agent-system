{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/personal-skill-system/install-state.schema.json",
  "title": "Personal skill-system install state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "managed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "managed": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "source_hash",
          "target",
          "target_hash",
          "operation_id",
          "installed_at",
          "registry_revision",
          "status"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "$ref": "#/$defs/hash"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "target_hash": {
            "$ref": "#/$defs/hash"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "installed_at": {
            "type": "string",
            "format": "date-time"
          },
          "registry_revision": {
            "$ref": "#/$defs/hash"
          },
          "status": {
            "const": "committed"
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
