#!/bin/bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
CHECKER="$ROOT/scripts/check_public_hygiene.py"
ZERO="0000000000000000000000000000000000000000"

# Always verify the tracked working tree.
python3 -B "$CHECKER" --repo "$ROOT" --all

# Also verify commit messages and diffs for every pushed ref update.
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z ${local_sha:-} || $local_sha == "$ZERO" ]] && continue
  if [[ $remote_sha == "$ZERO" ]]; then
    # New remote branch: check commits since origin/main if reachable, else full branch.
    if git -C "$ROOT" merge-base --is-ancestor origin/main "$local_sha" 2>/dev/null; then
      python3 -B "$CHECKER" --repo "$ROOT" --commits "origin/main..${local_sha}"
    else
      python3 -B "$CHECKER" --repo "$ROOT" --commits "$local_sha"
    fi
  else
    python3 -B "$CHECKER" --repo "$ROOT" --commits "${remote_sha}..${local_sha}"
  fi
done
