# --------------------------------------------------------------------

# ====================================================================
# Command Code wrappers
# ====================================================================

_cmd_bin() {
  local cmd_bin
  cmd_bin="$(type -P cmd)"

  if [[ -z "$cmd_bin" ]]; then
    echo "cmd is not on PATH" >&2
    return 127
  fi

  printf '%s\n' "$cmd_bin"
}

# Shared base for the Command Code wrappers. The only things that vary
# across cmg/cmds/cmm26p/cmqh/cmqx/cms/cm62h/cm62x/cm62mm/cmcm/cmch/cmnh/cmnx/
# cmhy/cmdglyph/cmdflint are two axes:
#   $1 model  : model id (exact /model catalog id)
#   $2 effort : reasoning effort ("" = omit and use the provider default)
# All wrappers launch in YOLO mode (--yolo bypasses all permission prompts)
# and pass --max-turns 9999: raises the /goal loop turn budget (default 100,
# clamped to a 500 ceiling -> effective max) and caps headless -p runs.
_cmd_launch() (
  local cmd_bin
  cmd_bin="$(_cmd_bin)" || return

  local model="$1"; shift
  local effort="$1"; shift

  local args=(--model "$model" --max-turns 9999)
  [[ -n "$effort" ]] && args+=(--effort "$effort")

  "$cmd_bin" "${args[@]}" --yolo "$@"
)

cmg()    ( _cmd_launch "zai-org/GLM-5.3"                "max"    "$@" )
cmds()   ( _cmd_launch "deepseek/deepseek-v4.1-flash"   "max"    "$@" )
cmm26p() ( _cmd_launch "xiaomi/mimo-v2.6-pro"           ""       "$@" )
cmqh()   ( _cmd_launch "Qwen/Qwen4-Max"                 "high"   "$@" )
cmqx()   ( _cmd_launch "Qwen/Qwen4-Max"                 "xhigh"  "$@" )
cms()    ( _cmd_launch "meta/muse-spark-1.3-contributor" ""      "$@" )
cm62h()  ( _cmd_launch "gpt-6.2-sol"                    "high"   "$@" )
cm62x()  ( _cmd_launch "gpt-6.2-sol"                    "xhigh"  "$@" )
cm62mm() ( _cmd_launch "gpt-6.2-sol"                    "max"    "$@" )
cmcm()   ( _cmd_launch "google/gemini-4-carbon"         "medium" "$@" )
cmch()   ( _cmd_launch "google/gemini-4-carbon"         "high"   "$@" )
cmnh()   ( _cmd_launch "google/gemini-4-neon"           "high"   "$@" )
cmnx()   ( _cmd_launch "google/gemini-4-neon"           "xhigh"  "$@" )
cmhy()   ( _cmd_launch "tencent/hy4"                    "high"   "$@" )
cmdglyph() ( _cmd_launch "stealth/glyph-cluster:free"   "xhigh"  "$@" )
cmdflint() ( _cmd_launch "recursive/flint-v1.0:free"    ""       "$@" )
# --------------------------------------------------------------------

# Live model discovery; the helper resolves data, never shell source.
am() (
  local helper="${AGENT_MODELS_HELPER:-agent-models}" record value
  local -a resolved=()
  command -v "$helper" >/dev/null 2>&1 || {
    echo 'am: install agent_models.py and its companion module (see SHELL/README.md)' >&2
    return 127
  }
  command -v jq >/dev/null 2>&1 || { echo 'am: jq is required' >&2; return 127; }
  record="$(mktemp "${TMPDIR:-/tmp}/agent-model-resolution.XXXXXX")" || return
  trap 'rm -f -- "$record"' EXIT
  "$helper" --resolve-to "$record" "$@" || return
  [[ -s "$record" ]] || return 0
  while IFS= read -r -d '' value; do resolved+=("$value"); done < <(
    jq -j '[.cli, .native_id, .effort, .session, .native[]] | .[] + "\u0000"' "$record"
  )
  case "${resolved[0]}" in
    cmd) _cmd_launch "${resolved[1]}" "${resolved[2]}" "${resolved[@]:4}" ;;
    devin) local devin_bin; devin_bin="$(_devin)" || return
      "$devin_bin" --model "${resolved[1]}" --permission-mode dangerous "${resolved[@]:4}" ;;
    oc) _oc_invoke "${resolved[1]}" "${resolved[2]}" "${resolved[3]}" "${resolved[@]:4}" ;;
    *) echo 'am: invalid resolution record' >&2; return 2 ;;
  esac
)

# ====================================================================
# OpenCode wrappers
# ====================================================================

_oc_bin() {
  local oc_bin
  oc_bin="$(type -P opencode)"

  if [[ -z "$oc_bin" ]]; then
    echo "opencode is not on PATH" >&2
    return 127
  fi

  printf '%s\n' "$oc_bin"
}

_ox_bin() { _oc_bin "$@"; }

# The TUI has no --variant flag; it seeds the active variant from the persisted
# choice in ~/.local/state/opencode/model.json, so upsert it before launching.
# (The same file's .variant map shape is unchanged in v2.)
_oc_pin_variant() {
  local model="$1" variant="$2"
  local state_dir="$HOME/.local/state/opencode"
  local state_file="${state_dir}/model.json"
  local current temp_file

  [[ -z "$variant" ]] && return 0

  mkdir -p "$state_dir" || return
  if [[ -f "$state_file" ]]; then
    current="$(cat "$state_file")"
  else
    current="{}"
  fi

  temp_file="$(mktemp "${state_dir}/.model.json.XXXXXX")" || return
  if printf '%s' "$current" |
      jq --arg model "$model" --arg variant "$variant" \
        '.variant = ((.variant // {}) + { ($model): $variant })' >"$temp_file" &&
      mv "$temp_file" "$state_file"; then
    return 0
  fi

  rm -f "$temp_file"
  echo "failed to pin ${model} variant '${variant}' in ${state_file}" >&2
  return 1
}

# v2 removed --model from the interactive root command (it now fails with
# "Unrecognized flag: --model"), so the TUI startup model is pinned the same
# way the TUI itself remembers it: most-recent entry in
# ~/.local/state/opencode/model.json (.recent[0]). Prepend the wrapper model
# (deduped, capped) before launching.
_oc_pin_model() {
  local model="$1"
  local provider="${model%%/*}" model_id="${model#*/}"
  local state_dir="$HOME/.local/state/opencode"
  local state_file="${state_dir}/model.json"
  local current temp_file

  if [[ "$provider" == "$model" ]]; then
    echo "_oc_pin_model: skipping malformed model id ${model@Q} (want provider/model)" >&2
    return 0
  fi

  mkdir -p "$state_dir" || return
  if [[ -f "$state_file" ]]; then
    current="$(cat "$state_file")"
  else
    current="{}"
  fi

  temp_file="$(mktemp "${state_dir}/.model.json.XXXXXX")" || return
  if printf '%s' "$current" |
      jq --arg provider "$provider" --arg model_id "$model_id" '
        .recent = ([{providerID: $provider, modelID: $model_id}]
          + ((.recent // []) | map(select(.providerID != $provider or .modelID != $model_id))))
          | .recent |= .[0:20]' >"$temp_file" &&
      mv "$temp_file" "$state_file"; then
    return 0
  fi

  rm -f "$temp_file"
  echo "failed to pin ${model} as most-recent model in ${state_file}" >&2
  return 1
}

# Normalize native completion evidence before the shared final-text selector.
_oc_complete_stream() (
  local oc_bin="$1" output metadata identity session message ended
  shift
  output="$(mktemp "${TMPDIR:-/tmp}/opencode-events.XXXXXX")" || return
  metadata="$(mktemp "${TMPDIR:-/tmp}/opencode-completion.XXXXXX")" || { rm -f -- "$output"; return 1; }
  trap 'rm -f -- "$output" "$metadata"' EXIT
  "$oc_bin" "$@" >"$output" || return
  if jq -es '[.[] | select(.type == "step_finish")] | last | .part.reason == "stop"' "$output" >/dev/null 2>&1; then
    cat "$output"
    return
  fi
  # Some v2 runs omit step_finish; successful native session state is required.
  identity="$(jq -ers '
    select(all(.[]; .type != "error"))
    | [.[] | select(.type == "text")] | last
    | select((.sessionID | type == "string") and (.part.messageID | type == "string")
      and (.part.time.end | type == "number"))
    | [.sessionID, .part.messageID, .part.time.end] | @tsv
  ' "$output" 2>/dev/null)" || return 1
  IFS=$'\t' read -r session message ended <<<"$identity"
  "$oc_bin" api session.get --param "sessionID=$session" >"$metadata" || return
  jq -e --arg session "$session" --argjson ended "$ended" '
    .data.id == $session and .data.outcome == "succeeded" and .data.time.idle >= $ended
  ' "$metadata" >/dev/null 2>&1 || return 1
  cat "$output"
  jq -cn --arg message "$message" '{type:"step_finish", part:{messageID:$message, reason:"stop"}}'
)

# Shared base for pinned OpenCode wrappers: preserve their global TUI pins.
# Headless runs pass the explicit provider/model#variant to the shared invoker.
_oc_launch() (
  _oc_bin >/dev/null || return
  local model="$1"; shift
  local variant="${1:-}"
  shift || true

  [[ -n "$variant" ]] && _oc_pin_variant "$model" "$variant"
  _oc_pin_model "$model"

  _oc_invoke "$model" "$variant" "" "$@"
)

# The dynamic picker supplies a session ID for TUI launch, never global pins.
_oc_invoke() (
  local oc_bin
  oc_bin="$(_oc_bin)" || return
  local model="$1" variant="$2" session="$3"
  shift 3
  local run_model="$model"
  [[ -n "$variant" ]] && run_model="${model}#${variant}"

  local argument print_mode="no" output_format="default" native_mode="no"
  local -a original=("$@") forwarded=() messages=() output_args=()
  if [[ "${1:-}" == run ]]; then print_mode="yes"; shift; fi
  while (( $# )); do
    argument="$1"
    shift
    case "$argument" in
      --) messages+=("$@"); break ;;
      -p|--prompt)
        (( $# )) || { printf 'OpenCode %s requires a value\n' "$argument" >&2; return 2; }
        print_mode="yes"; messages+=("$1"); shift
        ;;
      -p?*|--prompt=*)
        print_mode="yes"
        if [[ "$argument" == --prompt=* || "$argument" == -p=* ]]; then
          messages+=("${argument#*=}")
        else
          messages+=("${argument#-p}")
        fi
        ;;
      --format)
        (( $# )) || { echo 'OpenCode --format requires a value' >&2; return 2; }
        output_format="$1"; shift
        output_args=(--format "$output_format")
        ;;
      --format=*)
        output_format="${argument#*=}"
        output_args=(--format "$output_format")
        ;;
      --server|-s|--session|-m|--model|--agent|-f|--file|--title|--log-level|--completions)
        forwarded+=("$argument")
        if (( $# )); then forwarded+=("$1"); shift; fi
        ;;
      -h|--help|-v|--version)
        native_mode="yes"; forwarded+=("$argument")
        ;;
      -*) forwarded+=("$argument") ;;
      *) messages+=("$argument") ;;
    esac
  done
  if [[ "$print_mode" == yes ]]; then
    if [[ "$output_format" == default && "$native_mode" == no ]]; then
      _agent_final_print OpenCode '
        if any(.[]; .type == "error") then empty else
          ([.[] | select(.type == "step_finish")] | last | .part) as $end
          | select($end.reason == "stop" and ($end.messageID | type == "string"))
          | [.[] | select(.type == "text" and .part.messageID == $end.messageID) | .part.text]
          | join("")
        end
      ' _oc_complete_stream "$oc_bin" run --model "$run_model" --auto --format json "${forwarded[@]}" -- "${messages[@]}"
    else
      "$oc_bin" run --model "$run_model" --auto "${output_args[@]}" "${forwarded[@]}" -- "${messages[@]}"
    fi
  elif [[ -n "$session" ]]; then
    "$oc_bin" --auto --session "$session" "${original[@]}"
  else
    "$oc_bin" --auto "${original[@]}"
  fi
)

ocs()  ( _oc_launch "opencode-go/muse-spark-1.3-contributor"   "xhigh" "$@" )
ocargh() ( _oc_launch "opencode-go/gemini-4-argon" "high" "$@" )
ocnm()   ( _oc_launch "google/gemini-4-neon"      "medium" "$@" )
ocnh()   ( _oc_launch "google/gemini-4-neon"      "high" "$@" )
ochy()   ( _oc_launch "opencode-go/hy4"             "high" "$@" )
ocq4h()  ( _oc_launch "opencode-go/qwen4-max"       "high" "$@" )
ocq4x()  ( _oc_launch "opencode-go/qwen4-max"       "xhigh" "$@" )
# Go free / low-cost models: Hy4 Flash Free's highest effort is high;
# LongCat 2.5 (Go deprecated -free) and Iceman Contributor Free advertise no selectable variant.
ochy4flash() ( _oc_launch "opencode-go/hy4-flash-free"          "high" "$@" )
oclongcat()  ( _oc_launch "opencode-go/longcat-2.5"             ""     "$@" )
ociceman()   ( _oc_launch "opencode-go/iceman-contributor-free" ""     "$@" )
# Zen free models (provider `opencode`); no effort variant is pinned.
oclc()  ( _oc_launch "opencode/longcat-2.5-preview-free"    ""     "$@" )
ocmf()  ( _oc_launch "opencode/mimo-v2.6-flash-free"        ""     "$@" )
ocmm26() ( _oc_launch "opencode/mimo-v2.6-flash-free"       ""     "$@" )
ocnu()  ( _oc_launch "opencode/nemotron-3-ultra-free"       ""     "$@" )
ocbp()  ( _oc_launch "opencode/big-pickle"                  ""     "$@" )
ommp()  ( _oc_launch "opencode-go/mimo-v2.6-pro"            ""     "$@" )
# Direct vendor API-key models (providers openai/anthropic/google): billed to
# the user's own OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY, never via
# OpenRouter or the Go/Zen subscriptions. ocnl/ocnm/ocnh (above)
# also use the direct google provider since 2026-11-20.
ocs62x()  ( _oc_launch "openai/gpt-6.2-sol"        "xhigh"  "$@" )
ocs62mm() ( _oc_launch "openai/gpt-6.2-sol"        "max"    "$@" )
oca62m()  ( _oc_launch "openai/gpt-6.2-astra"      "medium" "$@" )
oca62h()  ( _oc_launch "openai/gpt-6.2-astra"      "high"   "$@" )
oca62x()  ( _oc_launch "openai/gpt-6.2-astra"      "xhigh"  "$@" )
oca62mm() ( _oc_launch "openai/gpt-6.2-astra"      "max"    "$@" )
ocopm()   ( _oc_launch "anthropic/claude-opus-5-5" "medium" "$@" )
ocoph()   ( _oc_launch "anthropic/claude-opus-5-5" "high"   "$@" )
ocopx()   ( _oc_launch "anthropic/claude-opus-5-5" "xhigh"  "$@" )
ocopmm()  ( _oc_launch "anthropic/claude-opus-5-5" "max"    "$@" )
ochl()    ( _oc_launch "google/gemini-4-hydrogen"  "low"    "$@" )
ochm()    ( _oc_launch "google/gemini-4-hydrogen"  "medium" "$@" )
ochh()    ( _oc_launch "google/gemini-4-hydrogen"  "high"   "$@" )
ochx()    ( _oc_launch "google/gemini-4-hydrogen"  "xhigh"  "$@" )
ocnl()    ( _oc_launch "google/gemini-4-neon"      "low"    "$@" )
ocnx()    ( _oc_launch "google/gemini-4-neon"      "xhigh"  "$@" )
# Carbon advertises only low/medium/high on the direct google catalog; there
# is no xhigh variant, so no occx wrapper exists.
occl()    ( _oc_launch "google/gemini-4-carbon"    "low"    "$@" )
occm()    ( _oc_launch "google/gemini-4-carbon"    "medium" "$@" )
occh()    ( _oc_launch "google/gemini-4-carbon"    "high"   "$@" )
# --------------------------------------------------------------------

# ====================================================================
# Pi wrappers
# ====================================================================

# Shared base for the Pi wrappers. The only things that vary across
# pms/par/phy/pqh/pqx/pmm/pihy4flash/pilongcat/piiceman are two axes:
#   $1 model  : provider/model id
#   $2 effort : thinking level (empty = pin none)
# Pi has no permission prompts and no sandbox (YOLO by design), so the
# wrappers only pin model and effort. The lineup mirrors the opencode Go oc
# wrappers (same models and efforts); all models route through the opencode Go
# subscription (provider opencode-go).
# POLICY: whenever an opencode Go wrapper is added or its model/effort changes,
# port the same model/effort to this pi lineup so the two stay in sync.
_pi_launch() (
  local model="$1"; shift
  local effort="$1"; shift
  if [[ -n "$effort" ]]; then
    pi --model "$model" --thinking "$effort" "$@"
  else
    pi --model "$model" "$@"
  fi
)

pms() ( _pi_launch "opencode-go/muse-spark-1.3-contributor" "xhigh" "$@" )
par() ( _pi_launch "opencode-go/gemini-4-argon"             "high"  "$@" )
phy() ( _pi_launch "opencode-go/hy4"                        "high"  "$@" )
pqh() ( _pi_launch "opencode-go/qwen4-max"                  "high"  "$@" )
pqx() ( _pi_launch "opencode-go/qwen4-max"                  "xhigh" "$@" )
pmm() ( _pi_launch "opencode-go/mimo-v2.6-pro"              ""      "$@" )
pihy4flash() ( _pi_launch "opencode-go/hy4-flash-free"          "high" "$@" )
pilongcat()  ( _pi_launch "opencode-go/longcat-2.5"             ""     "$@" )
piiceman()   ( _pi_launch "opencode-go/iceman-contributor-free" ""     "$@" )
# --------------------------------------------------------------------

# ---- Travel mode ---------------------------------------------------
# `travel <claude|codex|launcher> [args]` adds the travel MCP servers to one
# launch only (e.g. travel ccm, travel cdx). It lives in another checkout
# (TRAVEL/travel-mode, with TRAVEL/README.md); set TRAVEL_MODE_SH to its
# travel-mode.sh in ~/.config/agent-system/shell.local.sh to enable it.
[[ -n "${TRAVEL_MODE_SH:-}" && -r "$TRAVEL_MODE_SH" ]] && . "$TRAVEL_MODE_SH"
# --------------------------------------------------------------------

# ---- Persistent-guidance drift notice ------------------------------
# Interactive shells print one line, at most hourly, when a CLI has rewritten
# a managed config or a canonical edit is waiting to sync; silent otherwise.
# The checkout is the one ~/.config/agent-system/machine.json names;
# PERSISTENT_GUIDANCE_DIR overrides it.
_guidance_drift_notice() {
  local stamp="$HOME/.local/state/persistent-guidance/notice.stamp"
  [[ -d "${stamp%/*}" ]] || return 0
  [[ -n "$(find "$stamp" -mmin -60 2>/dev/null)" ]] && return 0
  local dir="${PERSISTENT_GUIDANCE_DIR:-}" checkout
  if [[ -z "$dir" ]]; then
    checkout=$(jq -r '.checkout // empty' "$HOME/.config/agent-system/machine.json" 2>/dev/null)
    [[ -n "$checkout" ]] || return 0
    dir="$checkout/AGENT-ENGINEERING/PERSISTENT-GUIDANCE"
  fi
  [[ -x "$dir/guidance" ]] || return 0
  touch "$stamp"
  "$dir/guidance" status --brief >&2
  return 0
}
if [[ $- == *i* ]]; then
  _guidance_drift_notice
fi
# --------------------------------------------------------------------
