  local -a order=(claude grok antigravity codex kimi devin cmd opencode pi)
  local -a selected=()
  local prov w selected_w
  if (( ${#want[@]} == 0 )); then
    selected=("${order[@]}")
  else
    for prov in "${order[@]}"; do
      for w in "${want[@]}"; do
        if [[ "$w" == "$prov" ]]; then
          selected+=("$prov")
          break
        fi
      done
    done
  fi

  _agents_title() {
    case "$1" in
      claude) printf 'Claude' ;;
      grok) printf 'Grok' ;;
      antigravity) printf 'Antigravity' ;;
      codex) printf 'Codex' ;;
      kimi) printf 'Kimi' ;;
      devin) printf 'Devin' ;;
      cmd) printf 'Command Code' ;;
      opencode) printf 'OpenCode' ;;
      pi) printf 'Pi' ;;
    esac
  }

  local first=1
  local line p wrap model effort mode
  for prov in "${selected[@]}"; do
    (( first )) || printf '\n'
    first=0
    printf '%s:\n' "$(_agents_title "$prov")"
    printf '  %-12s %-43s %-9s %s\n' WRAPPER MODEL EFFORT MODE
    while IFS='|' read -r p wrap model effort mode; do
      [[ "$p" == "$prov" ]] || continue
      printf '  %-12s %-43s %-9s %s\n' "$wrap" "$model" "$effort" "$mode"
    done <<<"$table"
    case "$prov" in
      claude)
        printf '  sub = subscription/OAuth auth; key = API-key failover auth (--api-key / -ak on any wrapper);\n'
        printf '  +safe keeps login with minimal config; +bare is native --bare. --code-mode opts into Code Mode\n'
        printf '  (--no-chrome, Agent Teams off, narrower opt-outs). All skip permissions.\n'
        ;;
      grok)
        printf '  plain `grok` is the raw binary (primary home), not a wrapper.\n'
        printf '  Headless text is final-only; explicit structured output stays native.\n'
        ;;
      antigravity)
        printf '  Every wrapper also has a `2`-suffixed twin on the second account (~/.agy2).\n'
        printf '  Use agk (e.g. agk aghx) or --api-key / -ak on any Gemini wrapper for GEMINI_API_KEY auth (excludes agom/agoh and *2).\n'
        ;;
      codex)
        printf '  Every wrapper also has a `2`-suffixed twin on the secondary account (~/.codex2).\n'
        printf '  Main-account launches default to Standard; add -f (Fast) or -uf (Ultrafast). Fast aliases still default to Fast.\n'
        printf '  Use cdxk (e.g. cdxk cdx) or --api-key / -ak on any wrapper for ~/.codex-api API-key auth.\n'
        printf '  Stream wrappers double as headless launchers: add -p/--print or a leading exec.\n'
        ;;
      opencode)
        printf '  TUI model/variant pin via persisted state; headless runs use model#variant.\n'
        printf '  Headless text is final-only; --format json stays native.\n'
        ;;
      kimi)
        printf '  Headless text is final-only; --output-format stream-json stays native.\n'
        ;;
    esac
  done
}


# ====================================================================
# Claude Code wrappers
# ====================================================================

_claude_bin() {
  local claude_bin
  claude_bin="$(type -P claude)"

  if [[ -z "$claude_bin" ]]; then
    echo "claude is not on PATH" >&2
    return 127
  fi

  printf '%s\n' "$claude_bin"
}

# Shared base for Claude Code wrappers, with four configurable axes:
#   $1 auth    : "sub" (subscription/OAuth) | "key" (API key via apiKeyHelper reading ~/.env)
#   $2 mode    : "" | "safe" (--safe-mode) | "bare" (--bare)
#   $3 model   : "" | model alias or name (e.g. opus, fable)
#   $4 effort  : "" | effort level (e.g. max, xhigh, high)
# safe-mode = bare-like minimal config (no CLAUDE.md/hooks/plugins/MCP/skills) but,
# unlike --bare, keeps subscription/OAuth (keychain) auth; tradeoff: skills off too.
# "key" auth (cck family or --api-key / -ak) reads ANTHROPIC_API_KEY from
# ${CLAUDE_ENV_FILE:-$HOME/.env} via an inline apiKeyHelper so ANTHROPIC_API_KEY
# stays unset in Claude's process environment and no secret enters argv.
_cc_api_key_helper='f="${CLAUDE_ENV_FILE:-$HOME/.env}"; if [ -r "$f" ]; then k="$(env -i HOME="$HOME" PATH="/usr/bin:/bin" /bin/bash -c '\''set -a; set +e; . "$1" >/dev/null 2>&1; printf "%s" "${ANTHROPIC_API_KEY:-}"'\'' _ "$f")"; if [ -n "$k" ]; then printf "%s\n" "$k"; exit 0; fi; fi; printf "Missing ANTHROPIC_API_KEY in %s\n" "$f" >&2; exit 1'

_agent_read_settings_json() {
  local label="$1" spec="$2" trimmed
  [[ -n "$spec" ]] || {
    printf '%s --settings value cannot be empty\n' "$label" >&2
    return 2
  }
  trimmed="${spec#"${spec%%[![:space:]]*}"}"
  if [[ -f "$spec" ]]; then
    jq -ec 'if type == "object" then . else error("settings must be a JSON object") end' "$spec"
  elif [[ "$trimmed" == \{* ]]; then
    jq -ec 'if type == "object" then . else error("settings must be a JSON object") end' <<<"$spec"
  else
    printf '%s settings file not found: %s\n' "$label" "$spec" >&2
    return 1
  fi
}

_agent_merge_settings_json() {
  local label="$1"; shift
  local settings_stream="" settings_obj spec
  command -v jq >/dev/null 2>&1 || {
    printf '%s --settings merge requires jq\n' "$label" >&2
    return 127
  }
  for spec in "$@"; do
    settings_obj="$(_agent_read_settings_json "$label" "$spec")" || return
    settings_stream+="${settings_stream:+$'\n'}${settings_obj}"
  done
  jq -sc 'reduce .[] as $item ({}; . * $item)' <<<"$settings_stream" || return 1
}

_cc_launch() (
  unset ANTHROPIC_API_KEY
  unset ANTHROPIC_AUTH_TOKEN
  export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=0

  local claude_bin
  claude_bin="$(_claude_bin)" || return

  local auth="$1"; shift
  local mode="$1"; shift
  local model="$1"; shift
  local effort="$1"; shift

  # Clear inherited provider/model overrides so both subscription and API-key
  # launches reach Anthropic cleanly with wrapper-selected settings.
  unset ANTHROPIC_BASE_URL ANTHROPIC_MODEL
  unset ANTHROPIC_DEFAULT_FABLE_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL
  unset ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
  unset CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_AUTO_COMPACT_WINDOW
  unset CLAUDE_CODE_MAX_CONTEXT_TOKENS CLAUDE_CODE_API_KEY_HELPER_TTL_MS
  # The environment takes precedence over --effort; let the wrapper/CLI choose.
  [[ -n "$effort" ]] && unset CLAUDE_CODE_EFFORT_LEVEL
  # A Claude worker's hist hook sees only its own session id, so name the parent
  # when this is plainly a Claude Code shell; otherwise drop any inherited one.
  if [[ -n "${CLAUDE_CODE_SESSION_ID:-}" && -z "${CODEX_THREAD_ID:-}" ]]; then
    export HIST_PARENT="claude:${CLAUDE_CODE_SESSION_ID}"
  else
    unset HIST_PARENT
  fi

  local -a forwarded=() extra_settings=()
  local stop_scan="no" code_mode="no" explicit_chrome="no" arg
  while (( $# )); do
    arg="$1"; shift
    if [[ "$stop_scan" == "yes" ]]; then
      forwarded+=("$arg")
      continue
    fi
    case "$arg" in
      --)
        stop_scan="yes"
        forwarded+=("$arg")
        ;;
      --api-key|-ak)
        auth="key"
        ;;
      --code-mode)
        code_mode="yes"
        ;;
      --chrome)
        explicit_chrome="yes"
        forwarded+=("$arg")
        ;;
      --settings)
        (( $# )) || { echo 'Claude --settings requires a value' >&2; return 2; }
        extra_settings+=("$1")
        shift
        ;;
      --settings=*)
        extra_settings+=("${arg#*=}")
        ;;
      *)
        forwarded+=("$arg")
        ;;
    esac
  done

  if [[ "$code_mode" == "yes" ]]; then
    if [[ "$auth" == "key" ]]; then
      echo 'Claude --code-mode cannot be combined with API-key mode (apiKeyHelper blocks Code Mode)' >&2
      return 2
    fi
    if [[ "$explicit_chrome" == "yes" ]]; then
      echo 'Claude --code-mode cannot be combined with --chrome' >&2
      return 2
    fi
    # Replace global nonessential-traffic suppression with narrower opt-outs for
    # this session so feature-flag fetching stays on (Code Mode requirement).
    unset CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
    export DISABLE_AUTOUPDATER=1 DISABLE_ERROR_REPORTING=1 DISABLE_FEEDBACK_COMMAND=1
    export CLAUDE_CODE_EXPERIMENTAL_CODE_MODE=1
    extra_settings+=('{"env":{"CLAUDE_CODE_EXPERIMENTAL_CODE_MODE":"1","CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":""}}')
  fi

  local args=()
  if [[ "$auth" == "key" ]]; then
    [[ "$mode" == "safe" ]] && mode="bare"
    command -v jq >/dev/null 2>&1 || {
      echo 'Claude API-key mode requires jq' >&2
      return 127
    }
    local cc_env_file="${CLAUDE_ENV_FILE:-$HOME/.env}"
    [[ -n "${CLAUDE_ENV_FILE:-}" ]] && export CLAUDE_ENV_FILE
    local api_settings_json merged_settings
    api_settings_json="$(jq -nc --arg helper "$_cc_api_key_helper" '{
      apiKeyHelper: $helper,
      env: {
        CLAUDE_CODE_SUBPROCESS_ENV_SCRUB: "0",
        CLAUDE_CODE_API_KEY_HELPER_TTL_MS: "300000"
      },
      includeCoAuthoredBy: false
    }')" || return 1
    if (( ${#extra_settings[@]} > 0 )); then
      merged_settings="$(_agent_merge_settings_json "Claude" "${extra_settings[@]}" "$api_settings_json")" || return
      api_settings_json="$merged_settings"
    fi
    if ! CLAUDE_ENV_FILE="$cc_env_file" /bin/sh -c "$_cc_api_key_helper" >/dev/null 2>&1; then
      printf 'Claude API-key mode requires ANTHROPIC_API_KEY in %s\n' "$cc_env_file" >&2
      return 2
    fi
    args+=(--settings "$api_settings_json")
  elif [[ "$code_mode" == "yes" && ${#extra_settings[@]} -gt 1 ]]; then
    local merged_settings
    merged_settings="$(_agent_merge_settings_json "Claude" "${extra_settings[@]}")" || return
    args+=(--settings "$merged_settings")
  elif (( ${#extra_settings[@]} > 0 )); then
    local spec
    for spec in "${extra_settings[@]}"; do
      args+=(--settings "$spec")
    done
  fi

  [[ "$code_mode" == "yes" ]] && args+=(--no-chrome)
  [[ "$mode" == "safe" ]] && args+=(--safe-mode)
  [[ "$mode" == "bare" ]] && args+=(--bare)
  [[ -n "$model" ]] && args+=(--model "$model")
  [[ -n "$effort" ]] && args+=(--effort "$effort")
  args+=(--dangerously-skip-permissions)
  (( ${#forwarded[@]} )) && args+=("${forwarded[@]}")

  "$claude_bin" "${args[@]}"
)

ccm()   ( _cc_launch "sub" ""     "opus[1m]" "max"       "$@" )
ccu()   ( _cc_launch "sub" ""     "opus[1m]" "ultracode" "$@" )
ccx()   ( _cc_launch "sub" ""     "opus[1m]" "xhigh"     "$@" )
cch()   ( _cc_launch "sub" ""     "opus[1m]" "high"      "$@" )
ccmm()  ( _cc_launch "sub" ""     "opus[1m]" "medium"    "$@" )

# A CLI settings overlay overrides the baseline env without editing settings.json.
_cc_boost_settings='{"env":{
  "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS":"16",
  "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH":"2",
  "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY":"16",
  "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS":"18"
}}'
ccmM() { ccm --settings "$_cc_boost_settings" "$@"; }
ccxX() { ccx --settings "$_cc_boost_settings" "$@"; }

# Bare subscription launches: safe-mode preserves the logged-in account.
ccbm()  ( _cc_launch "sub" "safe" "opus[1m]" "max"       "$@" )
ccbu()  ( _cc_launch "sub" "safe" "opus[1m]" "ultracode" "$@" )
ccbx()  ( _cc_launch "sub" "safe" "opus[1m]" "xhigh"     "$@" )
ccbh()  ( _cc_launch "sub" "safe" "opus[1m]" "high"      "$@" )
ccbmm() ( _cc_launch "sub" "safe" "opus[1m]" "medium"    "$@" )

# Fable subscription launches.
ccfm()  ( _cc_launch "sub" ""     "fable[1m]" "max"       "$@" )
ccfu()  ( _cc_launch "sub" ""     "fable[1m]" "ultracode" "$@" )
ccfx()  ( _cc_launch "sub" ""     "fable[1m]" "xhigh"     "$@" )
ccfh()  ( _cc_launch "sub" ""     "fable[1m]" "high"      "$@" )
ccfmm() ( _cc_launch "sub" ""     "fable[1m]" "medium"    "$@" )

# Bare Fable subscription launches.
ccbfm()  ( _cc_launch "sub" "safe" "fable[1m]" "max"       "$@" )
ccbfu()  ( _cc_launch "sub" "safe" "fable[1m]" "ultracode" "$@" )
ccbfx()  ( _cc_launch "sub" "safe" "fable[1m]" "xhigh"     "$@" )
ccbfh()  ( _cc_launch "sub" "safe" "fable[1m]" "high"      "$@" )
ccbfmm() ( _cc_launch "sub" "safe" "fable[1m]" "medium"    "$@" )

# Sonnet subscription launches (cs*). High is cshh because csh is /bin/csh.
# Pinned ID, not the sonnet alias: ~/.claude/settings.json env remaps
# ANTHROPIC_DEFAULT_SONNET_MODEL to opus, and settings env beats the wrapper.
csm()   ( _cc_launch "sub" ""     "claude-sonnet-5-5[1m]" "max"       "$@" )
csu()   ( _cc_launch "sub" ""     "claude-sonnet-5-5[1m]" "ultracode" "$@" )
csx()   ( _cc_launch "sub" ""     "claude-sonnet-5-5[1m]" "xhigh"     "$@" )
cshh()  ( _cc_launch "sub" ""     "claude-sonnet-5-5[1m]" "high"      "$@" )
csmm()  ( _cc_launch "sub" ""     "claude-sonnet-5-5[1m]" "medium"    "$@" )

# Bare Sonnet subscription launches.
csbm()  ( _cc_launch "sub" "safe" "claude-sonnet-5-5[1m]" "max"       "$@" )
csbu()  ( _cc_launch "sub" "safe" "claude-sonnet-5-5[1m]" "ultracode" "$@" )
csbx()  ( _cc_launch "sub" "safe" "claude-sonnet-5-5[1m]" "xhigh"     "$@" )
csbh()  ( _cc_launch "sub" "safe" "claude-sonnet-5-5[1m]" "high"      "$@" )
csbmm() ( _cc_launch "sub" "safe" "claude-sonnet-5-5[1m]" "medium"    "$@" )

# Haiku subscription launches (ch*). Pinned ID, not the haiku alias, for the
# same reason as cs*: settings env remaps ANTHROPIC_DEFAULT_HAIKU_MODEL to
# sonnet, and settings env beats the wrapper.
chm()   ( _cc_launch "sub" ""     "claude-haiku-5-5[1m]" "max"       "$@" )
chu()   ( _cc_launch "sub" ""     "claude-haiku-5-5[1m]" "ultracode" "$@" )
chx()   ( _cc_launch "sub" ""     "claude-haiku-5-5[1m]" "xhigh"     "$@" )
chh()   ( _cc_launch "sub" ""     "claude-haiku-5-5[1m]" "high"      "$@" )
chmm()  ( _cc_launch "sub" ""     "claude-haiku-5-5[1m]" "medium"    "$@" )

# Bare Haiku subscription launches.
chbm()  ( _cc_launch "sub" "safe" "claude-haiku-5-5[1m]" "max"       "$@" )
chbu()  ( _cc_launch "sub" "safe" "claude-haiku-5-5[1m]" "ultracode" "$@" )
chbx()  ( _cc_launch "sub" "safe" "claude-haiku-5-5[1m]" "xhigh"     "$@" )
chbh()  ( _cc_launch "sub" "safe" "claude-haiku-5-5[1m]" "high"      "$@" )
chbmm() ( _cc_launch "sub" "safe" "claude-haiku-5-5[1m]" "medium"    "$@" )

# Key-auth family (cck*): uses the opus[1m]/fable[1m] aliases (same as the sub
# family, so they track latest) with API-key auth reading ANTHROPIC_API_KEY
# from ~/.env. Minimal variants use --bare (key auth survives bare
# mode, unlike subscription/OAuth) instead of the sub family's --safe-mode.
# So cckbm = cck + bare + max, cckbfm = cck + bare + fable + max, etc.
cck()   ( _cc_launch "key" ""     ""      ""          "$@" )
cckm()  ( _cc_launch "key" ""     "opus[1m]" "max"       "$@" )
ccku()  ( _cc_launch "key" ""     "opus[1m]" "ultracode" "$@" )
cckx()  ( _cc_launch "key" ""     "opus[1m]" "xhigh"     "$@" )
cckh()  ( _cc_launch "key" ""     "opus[1m]" "high"      "$@" )
cckmm() ( _cc_launch "key" ""     "opus[1m]" "medium"    "$@" )
cckbm() ( _cc_launch "key" "bare" "opus[1m]" "max"       "$@" )
cckbu() ( _cc_launch "key" "bare" "opus[1m]" "ultracode" "$@" )
cckbx() ( _cc_launch "key" "bare" "opus[1m]" "xhigh"     "$@" )
cckbh() ( _cc_launch "key" "bare" "opus[1m]" "high"      "$@" )
cckbmm() ( _cc_launch "key" "bare" "opus[1m]" "medium"   "$@" )
cckfm() ( _cc_launch "key" ""     "fable[1m]" "max"       "$@" )
cckfu() ( _cc_launch "key" ""     "fable[1m]" "ultracode" "$@" )
cckfx() ( _cc_launch "key" ""     "fable[1m]" "xhigh"     "$@" )
cckfh() ( _cc_launch "key" ""     "fable[1m]" "high"      "$@" )
cckfmm() ( _cc_launch "key" ""    "fable[1m]" "medium"    "$@" )
cckbfm() ( _cc_launch "key" "bare" "fable[1m]" "max"      "$@" )
cckbfu() ( _cc_launch "key" "bare" "fable[1m]" "ultracode" "$@" )
cckbfx() ( _cc_launch "key" "bare" "fable[1m]" "xhigh"    "$@" )
cckbfh() ( _cc_launch "key" "bare" "fable[1m]" "high"     "$@" )
cckbfmm() ( _cc_launch "key" "bare" "fable[1m]" "medium"  "$@" )

# ====================================================================
# Grok wrappers
# ====================================================================

# Buffer stdout until the CLI succeeds and a final response is validated.
_agent_final_print() (
  local provider="$1" selector="$2" output_file final_text status
  shift 2
  command -v jq >/dev/null 2>&1 || {
    printf '%s final output: jq is required\n' "$provider" >&2
    return 127
  }
  output_file="$(mktemp "${TMPDIR:-/tmp}/agent-final-output.XXXXXX")" || return
  trap 'rm -f -- "$output_file"' EXIT
  if "$@" >"$output_file"; then
    :
  else
    status=$?
    printf '%s final output: process exited with status %s\n' "$provider" "$status" >&2
    return "$status"
  fi
  if ! final_text="$(command jq -ers \
      "$selector | select(type == \"string\" and test(\"\\\\S\"))" \
      "$output_file" 2>/dev/null)"; then
    printf '%s final output: no parseable final assistant text\n' "$provider" >&2
    return 1
  fi
  printf '%s\n' "$final_text"
)

_grok_bin() {
  local grok_bin
  grok_bin="$(type -P grok)"

  if [[ -z "$grok_bin" ]]; then
    echo "grok is not on PATH" >&2
    return 127
  fi

  printf '%s\n' "$grok_bin"
}

_grok_launch() (
  local grok_bin argument print_mode="no" output_format="plain" native_mode="no"
  local -a forwarded=() output_args=()
  grok_bin="$(_grok_bin)" || return
  while (( $# )); do
    argument="$1"
    shift
    case "$argument" in
      --) forwarded+=(-- "$@"); break ;;
      --output-format)
        (( $# )) || { echo 'Grok --output-format requires a value' >&2; return 2; }
        output_format="$1"; shift
        output_args=(--output-format "$output_format")
        ;;
      --output-format=*)
        output_format="${argument#*=}"
        output_args=(--output-format "$output_format")
        ;;
      -p|--single|--prompt-file|--prompt-json)
        (( $# )) || { printf 'Grok %s requires a value\n' "$argument" >&2; return 2; }
        print_mode="yes"; forwarded+=("$argument" "$1"); shift
        ;;
      -p?*|--single=*|--prompt-file=*|--prompt-json=*)
        print_mode="yes"; forwarded+=("$argument")
        ;;
      --json-schema|--json-schema=*)
        native_mode="yes"; forwarded+=("$argument")
        if [[ "$argument" == --json-schema && $# -gt 0 ]]; then
          forwarded+=("$1"); shift
        fi
        ;;
      -h|--help|-v|--version)
        native_mode="yes"; forwarded+=("$argument")
        ;;
      -r|--resume|-w|--worktree)
        forwarded+=("$argument")
        if (( $# )) && [[ "$1" != -* ]]; then forwarded+=("$1"); shift; fi
        ;;
      --agent|--agents|--allow|--allowedTools|--allowed-tools|--cwd|--debug-file|--deny|--disallowed-tools|--disallowedTools|--leader-socket|-m|--model|--max-turns|--permission-mode|--reasoning-effort|--effort|--rules|-s|--session-id|--sandbox|--system-prompt-override|--system-prompt|--tools|--worktree-ref|--ref)
        forwarded+=("$argument")
        if (( $# )); then forwarded+=("$1"); shift; fi
        ;;
      *) forwarded+=("$argument") ;;
    esac
  done
  if [[ "$print_mode" == yes && "$output_format" == plain && "$native_mode" == no ]]; then
    _agent_final_print Grok '
      if length == 1 then .[0] | select(.stopReason == "end_turn") | .text else empty end
    ' \
      "$grok_bin" --output-format json "${forwarded[@]}"
  else
    "$grok_bin" "${output_args[@]}" "${forwarded[@]}"
  fi
)

grokxh() (
  _grok_launch --model grok-4.6 --effort xhigh --always-approve "$@"
)

# Grok secondary profile wrappers (GROK_HOME=~/.grok2)
grok2() (
  export GROK_HOME="${GROK2_HOME:-$HOME/.grok2}"
  _grok_launch "$@"
)

grok2xh() (
  export GROK_HOME="${GROK2_HOME:-$HOME/.grok2}"
  _grok_launch --model grok-4.6 --effort xhigh --always-approve "$@"
)

# Grok third profile wrappers (GROK_HOME=~/.grok3)
grok3() (
  export GROK_HOME="${GROK3_HOME:-$HOME/.grok3}"
  _grok_launch "$@"
)

grok3xh() (
  export GROK_HOME="${GROK3_HOME:-$HOME/.grok3}"
  _grok_launch --model grok-4.6 --effort xhigh --always-approve "$@"
)

# ====================================================================
# Antigravity (agy) wrappers
# ====================================================================

_agy_bin() {
  local agy_bin
  agy_bin="$(type -P agy)"

  if [[ -z "$agy_bin" ]]; then
    echo "agy is not on PATH" >&2
    return 127
  fi

  printf '%s\n' "$agy_bin"
}

# Under the second account's HOME (see _agy_prepare_home) there is no keychain,
# so saving each refreshed token (about hourly) raises macOS's "Keychain Not
# Found" dialog. AGY skips the keychain for its token file in an SSH session, so
# account-2 runs present this SSH_CONNECTION (a real one wins); the .zshenv
# drops the stand-in again for the commands AGY runs.
_agy2_ssh_connection() {
  printf '%s\n' "${SSH_CONNECTION:-127.0.0.1 0 127.0.0.1 0}"
}

# AGY has no home setting: it finds ~/.gemini and its login (the macOS login
# keychain, else a token file) through $HOME. The second account runs AGY with
# HOME at its own folder, which has no keychain, so its login stays separate;
# its .gemini/config links the primary one (plugins, agents, skills). AGY runs
# commands with `zsh -c`, and the folder's ZDOTDIR .zshenv gives them the real
# HOME back, so git, gh and skills see the usual home.
_agy_prepare_home() {
  local agy_home="$1"
  local config="$1/.gemini/config" zshenv="$1/.zdotdir/.zshenv" body

  mkdir -p "$agy_home/.gemini" "$agy_home/.zdotdir" || return
  if [[ ! -e "$config" && ! -L "$config" ]]; then
    ln -s "$HOME/.gemini/config" "$config" || return
  elif [[ "$(readlink "$config")" != "$HOME/.gemini/config" ]]; then
    echo "$config must be a link to $HOME/.gemini/config, the shared Antigravity config" >&2
    return 1
  fi
  body='# Written by ~/.bash_agents: commands on the second Antigravity account get the real HOME back.
[[ -n "$AGY_USER_HOME" ]] && export HOME="$AGY_USER_HOME"
[[ -n "$AGY_FAKE_SSH" ]] && unset SSH_CONNECTION
unset ZDOTDIR AGY_USER_HOME AGY_FAKE_SSH
[[ -r "$HOME/.zshenv" ]] && source "$HOME/.zshenv"'
  [[ "$(cat "$zshenv" 2>/dev/null)" == "$body" ]] || printf '%s\n' "$body" >"$zshenv"
}

_agy_trust_workspace() {
  local workspace settings temp_settings

  workspace="${1:-$(pwd -P)}"
  workspace="$(cd "$workspace" 2>/dev/null && pwd -P)" || return
  settings="${2:-$HOME}/.gemini/antigravity-cli/settings.json"

  if ! type -P jq >/dev/null; then
    echo "jq is required to add the current workspace to AGY's trust list" >&2
    return 127
  fi
  if [[ ! -f "$settings" ]]; then
    echo "AGY settings file not found: $settings" >&2
    return 1
  fi
  if jq -e --arg workspace "$workspace" \
      '(.trustedWorkspaces // []) | index($workspace) != null' \
      "$settings" >/dev/null 2>&1; then
    return 0
  fi

  temp_settings="$(mktemp "${settings}.tmp.XXXXXX")" || return
  if jq --arg workspace "$workspace" \
      '.trustedWorkspaces = ((.trustedWorkspaces // []) + [$workspace])' \
      "$settings" >"$temp_settings" &&
     chmod 600 "$temp_settings" &&
     mv "$temp_settings" "$settings"; then
    return 0
  fi

  rm -f "$temp_settings"
  echo "Failed to add $workspace to AGY's trusted workspaces" >&2
  return 1
}

_agy_launch() {
  local customization_mode="$1"
  local model="$2"
  local effort="$3"
  local headless_output="$4"
  local workflow_mode="${5:-}"
  local agy_bin workspace repo_root argument review_seam
  local review_requested="no" headless="no" api_key="no"
  [[ "${_agy_api_mode:-}" == "1" ]] && api_key="yes"
  local agy_home="${_agy_account_home:-$HOME}"
  local runtime_home="${ANTIGRAVITY_RUNTIME_HOME:-$HOME/.gemini/antigravity-cli}"
  local -A review_selection=()
  local -a args review_forwarded=() agy_env=() pre_kept=() extra_settings=()
  shift $(( $# >= 5 ? 5 : 4 ))

  unset REVIEW_AFTER_COMMIT_MODE
  unset ANTIGRAVITY_HOOK_STATE_DIR
  unset ANTIGRAVITY_HOOK_REVIEW_AFTER_COMMIT_STANDARD_EVERY
  unset ANTIGRAVITY_HOOK_REVIEW_AFTER_COMMIT_BRANCH_EVERY
  local stop_scan="no"
  while (( $# )); do
    argument="$1"
    shift
    if [[ "$stop_scan" == "yes" ]]; then
      pre_kept+=("$argument")
      continue
    fi
    case "$argument" in
      --)
        stop_scan="yes"
        pre_kept+=("$argument")
        ;;
      --api-key|-ak)
        api_key="yes"
        ;;
      --settings)
        (( $# )) || { echo 'Antigravity --settings requires a value' >&2; return 2; }
        extra_settings+=("$1")
        shift
        ;;
      --settings=*)
        extra_settings+=("${argument#*=}")
        ;;
      -p|--print|--prompt|-p=*|--print=*|--prompt=*)
        headless="yes"
        pre_kept+=("$argument")
        ;;
      --review-mode|--review-mode=*|--review-standard-every|--review-standard-every=*|--review-branch-every|--review-branch-every=*|--hook|--hook=*|--hook-option|--hook-option=*)
        review_requested="yes"
        pre_kept+=("$argument")
        ;;
      *)
        pre_kept+=("$argument")
        ;;
    esac
  done
  set -- "${pre_kept[@]}"

  if [[ "$api_key" == "yes" ]]; then
    if [[ -n "${_agy_account_home:-}" ]]; then
      echo "Antigravity API-key mode cannot be combined with secondary account ($_agy_account_home)" >&2
      return 2
    fi
    if [[ "$model" != gemini-* ]]; then
      echo "Antigravity API-key mode supports Gemini models only (not $model)" >&2
      return 2
    fi
    [[ "${AGY_KEEP_BASE_URL:-}" == "1" ]] || unset GOOGLE_GEMINI_BASE_URL
    local agy_env_file="${AGY_ENV_FILE:-$HOME/.env}"
    if [[ -z "${GEMINI_API_KEY:-}" && -r "$agy_env_file" ]]; then
      GEMINI_API_KEY="$(set -a; set +e; . "$agy_env_file" 2>/dev/null; printf '%s' "${GEMINI_API_KEY:-}")"
    fi
    if [[ -z "${GEMINI_API_KEY:-}" ]]; then
      echo "Antigravity API-key mode requires GEMINI_API_KEY (in env or $agy_env_file)" >&2
      return 2
    fi
    export GEMINI_API_KEY
  fi

  if [[ -n "${_agy_account_home:-}" ]]; then
    _agy_prepare_home "$agy_home" || return
    runtime_home="$agy_home/.gemini/antigravity-cli"
    # A signed-out headless AGY opens a browser login and waits; refuse instead.
    if [[ "$headless" == "yes" && ! -s "$runtime_home/antigravity-oauth-token" ]]; then
      echo "Antigravity account 2 is not signed in ($agy_home); run agg2 in a terminal once to log in" >&2
      return 1
    fi
    agy_env=(HOME="$agy_home" ZDOTDIR="$agy_home/.zdotdir" AGY_USER_HOME="$HOME")
    [[ -n "${SSH_CONNECTION:-}" ]] ||
      agy_env+=(SSH_CONNECTION="$(_agy2_ssh_connection)" AGY_FAKE_SSH=1)
  fi
  if [[ "$review_requested" == "yes" ]]; then
    review_seam="${ANTIGRAVITY_CONFIG_HOME:-$HOME/.gemini/config}/plugins/review-after-commit/shell/review-after-commit.bash"
    [[ -r "$review_seam" ]] || {
      echo "review-after-commit launcher seam is not readable: $review_seam" >&2
      return 1
    }
    # shellcheck disable=SC1090
    source "$review_seam" || return
    review_after_commit_parse antigravity review_selection review_forwarded "$@" || return
    set -- "${review_forwarded[@]}"
    review_after_commit_export_environment \
      antigravity \
      "$runtime_home" \
      review_selection || return
  fi

  agy_bin="$(_agy_bin)" || return

  # Resolve the enclosing Git repository root or fallback to the current directory.
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  workspace="${repo_root:-$(pwd -P)}"

  # AGY's permission-skipping flag does not bypass its separate folder-trust
  # gate, so YOLO launchers explicitly trust the target workspace first.
  _agy_trust_workspace "$workspace" "$agy_home" || return
  args=(
    --model "$model"
    --mode accept-edits
    --dangerously-skip-permissions
    --add-dir "$workspace"
  )

  # Some AGY models encode effort in the model ID instead.
  [[ -n "$effort" ]] && args+=(--effort "$effort")

  # inheritCustomizations=false keeps automatic project/global context out of
  # the prompt while AGY's skill registry remains available for explicit use.
  [[ "$customization_mode" == "bare" ]] && args+=(--agent agy-bare)

  if [[ "$api_key" == "yes" ]]; then
    if (( ${#extra_settings[@]} == 0 )); then
      args+=(--settings '{"modelProvider":"gemini"}')
    else
      local merged_settings
      merged_settings="$(_agent_merge_settings_json "Antigravity" "${extra_settings[@]}" '{"modelProvider":"gemini"}')" || return
      args+=(--settings "$merged_settings")
    fi
  elif (( ${#extra_settings[@]} > 0 )); then
    local spec
    for spec in "${extra_settings[@]}"; do
      args+=(--settings "$spec")
    done
  fi

  # Boost and teamwork-preview modes are engaged via their slash commands.
  # For headless (-p/--print) or initial prompts (-i/--prompt-interactive), prefix the
  # slash command to the prompt so the requested mode is engaged. For bare interactive
  # launches without prompt arguments, pass --prompt-interactive "/$workflow_mode".
  local forwarded=()
  local prompt_seen="no"
  while [[ $# -gt 0 ]]; do
    argument="$1"
    shift
    case "$argument" in
      --)
        forwarded+=(--)
        forwarded+=("$@")
        break
        ;;
      -p|--print|--prompt|-i|--prompt-interactive)
        if [[ -n "$workflow_mode" && $# -gt 0 ]]; then
          prompt_seen="yes"
          local prompt_val="$1"
          shift
          if [[ "$prompt_val" =~ ^/[a-zA-Z0-9_-]+ ]]; then
            forwarded+=("$argument" "$prompt_val")
          else
            forwarded+=("$argument" "/${workflow_mode} ${prompt_val}")
          fi
        else
          forwarded+=("$argument")
        fi
        ;;
      -p=*|--print=*|--prompt=*|-i=*|--prompt-interactive=*)
        local flag_name="${argument%%=*}"
        local flag_val="${argument#*=}"
        if [[ -n "$workflow_mode" ]]; then
          prompt_seen="yes"
          if [[ "$flag_val" =~ ^/[a-zA-Z0-9_-]+ ]]; then
            forwarded+=("${flag_name}=${flag_val}")
          else
            forwarded+=("${flag_name}=/${workflow_mode} ${flag_val}")
          fi
        else
          forwarded+=("$argument")
        fi
        ;;
      *)
        forwarded+=("$argument")
        ;;
    esac
  done

  if [[ -n "$workflow_mode" && "$prompt_seen" == "no" ]]; then
    args+=(--prompt-interactive "/$workflow_mode")
  fi

  if [[ "$headless_output" == "final" ]]; then
    # Text and JSON responses both concatenate progress with the final answer.
    # The filter reconstructs the last completed response from stream-json;
    # interactive calls exec AGY unchanged. Never fall back to unfiltered text.
    env "${agy_env[@]}" python3 "$HOME/.agents/skills/delegate/scripts/agy-final-output.py" \
      "$agy_bin" "${args[@]}" "${forwarded[@]}"
  else
    env "${agy_env[@]}" "$agy_bin" "${args[@]}" "${forwarded[@]}"
  fi
}

agg()    ( _agy_launch "normal" "gemini-3.8-flash-high"       "high" "final"  ""                 "$@" )
aggbs()  ( _agy_launch "normal" "gemini-3.8-flash-high"       "high" "final"  "boost"            "$@" )
aggtp()  ( _agy_launch "normal" "gemini-3.8-flash-high"       "high" "final"  "teamwork-preview" "$@" )
aggb()   ( _agy_launch "bare"   "gemini-3.8-flash-high"       "high" "final"  ""                 "$@" )
aggbbs() ( _agy_launch "bare"   "gemini-3.8-flash-high"       "high" "final"  "boost"            "$@" )
aggbtp() ( _agy_launch "bare"   "gemini-3.8-flash-high"       "high" "final"  "teamwork-preview" "$@" )
agom()   ( _agy_launch "normal" "claude-opus-5-5-medium"      ""     "final"  ""                 "$@" )
agoh()   ( _agy_launch "normal" "claude-opus-5-5-high"        ""     "final"  ""                 "$@" )
argm()   ( _agy_launch "normal" "gemini-4-argon-medium"      ""     "final"  ""                 "$@" )
argh()   ( _agy_launch "normal" "gemini-4-argon-high"        ""     "final"  ""                 "$@" )
aghh()   ( _agy_launch "normal" "gemini-4-hydrogen-high"     ""     "final"  ""                 "$@" )
aghhb()  ( _agy_launch "bare"   "gemini-4-hydrogen-high"     ""     "final"  ""                 "$@" )
aghx()   ( _agy_launch "normal" "gemini-4-hydrogen-xhigh"    ""     "final"  ""                 "$@" )
aghxb()  ( _agy_launch "bare"   "gemini-4-hydrogen-xhigh"    ""     "final"  ""                 "$@" )
agcm()   ( _agy_launch "normal" "gemini-4-carbon-medium"     ""     "final"  ""                 "$@" )
agcmb()  ( _agy_launch "bare"   "gemini-4-carbon-medium"     ""     "final"  ""                 "$@" )
agch()   ( _agy_launch "normal" "gemini-4-carbon-high"       ""     "final"  ""                 "$@" )
agchb()  ( _agy_launch "bare"   "gemini-4-carbon-high"       ""     "final"  ""                 "$@" )
agnm()   ( _agy_launch "normal" "gemini-4-neon-medium"       ""     "final"  ""                 "$@" )
agnmb()  ( _agy_launch "bare"   "gemini-4-neon-medium"       ""     "final"  ""                 "$@" )
agnh()   ( _agy_launch "normal" "gemini-4-neon-high"         ""     "final"  ""                 "$@" )
agnhb()  ( _agy_launch "bare"   "gemini-4-neon-high"         ""     "final"  ""                 "$@" )
agnx()   ( _agy_launch "normal" "gemini-4-neon-xhigh"        ""     "final"  ""                 "$@" )
agnxb()  ( _agy_launch "bare"   "gemini-4-neon-xhigh"        ""     "final"  ""                 "$@" )

# Second Antigravity account (HOME=~/.agy2). The subshell keeps the account
# choice local to each invocation; agent commands never see it.
_agy_secondary() (
  _agy_account_home="${AGY2_HOME:-$HOME/.agy2}"
  "$@"
)

agg2()    { _agy_secondary agg "$@"; }
aggbs2()  { _agy_secondary aggbs "$@"; }
aggtp2()  { _agy_secondary aggtp "$@"; }
aggb2()   { _agy_secondary aggb "$@"; }
aggbbs2() { _agy_secondary aggbbs "$@"; }
aggbtp2() { _agy_secondary aggbtp "$@"; }
agom2()   { _agy_secondary agom "$@"; }
agoh2()   { _agy_secondary agoh "$@"; }
argm2()   { _agy_secondary argm "$@"; }
argh2()   { _agy_secondary argh "$@"; }
aghh2()   { _agy_secondary aghh "$@"; }
aghhb2()  { _agy_secondary aghhb "$@"; }
aghx2()   { _agy_secondary aghx "$@"; }
aghxb2()  { _agy_secondary aghxb "$@"; }
agcm2()   { _agy_secondary agcm "$@"; }
agcmb2()  { _agy_secondary agcmb "$@"; }
agch2()   { _agy_secondary agch "$@"; }
agchb2()  { _agy_secondary agchb "$@"; }
agnm2()   { _agy_secondary agnm "$@"; }
agnmb2()  { _agy_secondary agnmb "$@"; }
agnh2()   { _agy_secondary agnh "$@"; }
agnhb2()  { _agy_secondary agnhb "$@"; }
agnx2()   { _agy_secondary agnx "$@"; }
agnxb2()  { _agy_secondary agnxb "$@"; }

# API-key Antigravity mode (GEMINI_API_KEY + modelProvider: "gemini").
# Subshell isolation keeps API-key selection local to each invocation.
_agy_api() (
  _agy_api_mode=1
  "$@"
)

agk() {
  if (( $# == 0 )); then
    _agy_api aghh
    return
  fi
  case "$1" in
    -*)
      _agy_api aghh "$@"
      ;;
    *2|agom|agoh)
      printf 'agk(): cannot use %s with GEMINI_API_KEY mode\n' "$1" >&2
      return 2
      ;;
    *)
      _agy_api "$@"
      ;;
  esac
}

# ====================================================================
# Codex wrappers
# ====================================================================

_codex_safe_path_segment() {
  printf '%s' "$1" | sed 's|[^A-Za-z0-9._-]|_|g'
}

_codex_error() {
  printf '%s\n' "$*" >&2
}

_codex_link_shared_entry() {
  local source_path="$1"
  local dest_path="$2"

  [[ -e "$source_path" || -L "$source_path" ]] || return 0

  if [[ -e "$dest_path" || -L "$dest_path" ]]; then
    return 0
  fi

  if ln -s "$source_path" "$dest_path" 2>/dev/null; then
    return 0
  fi

  if [[ -e "$dest_path" || -L "$dest_path" ]]; then
    return 0
  fi

  _codex_error "_codex_link_shared_entry(): failed to link $dest_path -> $source_path"
  return 1
}

_codex_check_required_entry() {
  local source_path="$1"
  local dest_path="$2"

  if [[ ! -e "$source_path" && ! -L "$source_path" ]]; then
    _codex_error "_codex_check_required_entry(): required source does not exist: $source_path"
    return 1
  fi

  [[ "$source_path" == "$dest_path" ]] && return 0

  if [[ -L "$dest_path" && "$(readlink "$dest_path" 2>/dev/null)" == "$source_path" ]]; then
    return 0
  fi
  if [[ -e "$dest_path" || -L "$dest_path" ]]; then
    _codex_error "_codex_check_required_entry(): refusing to replace conflicting path $dest_path"
    return 1
  fi
}

_codex_link_required_entry() {
  local source_path="$1"
  local dest_path="$2"

  _codex_check_required_entry "$source_path" "$dest_path" || return 1

  [[ "$source_path" == "$dest_path" ]] && return 0
  if [[ -L "$dest_path" && "$(readlink "$dest_path" 2>/dev/null)" == "$source_path" ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$dest_path")" || {
    _codex_error "_codex_link_required_entry(): failed to create the parent of $dest_path"
    return 1
  }
  if ln -s "$source_path" "$dest_path" 2>/dev/null; then
    return 0
  fi
  if [[ -L "$dest_path" && "$(readlink "$dest_path" 2>/dev/null)" == "$source_path" ]]; then
    return 0
  fi

  _codex_error "_codex_link_required_entry(): failed to link $dest_path -> $source_path"
  return 1
}

_codex_activate_hook() {
  local codex_home="$1"
  local hook_name="$2"
  local canonical_home="${CODEX_CANONICAL_HOME:-$HOME/.codex}"
  local hook_source manager

  case "$hook_name" in
    review-after-commit)
      hook_source="${canonical_home}/hooks/review-after-commit"
      manager="${hook_source}/scripts/review_hook.py"
      ;;
    *)
      _codex_error "_codex_activate_hook(): unsupported hook '$hook_name'"
      return 2
      ;;
  esac

  _codex_check_required_entry \
    "$hook_source" \
    "${codex_home}/hooks/${hook_name}" || return 1

  _codex_link_required_entry \
    "$hook_source" \
    "${codex_home}/hooks/${hook_name}" || return 1
  [[ -f "$manager" && ! -L "$manager" ]] || {
    _codex_error "installed review-after-commit manager is unavailable: $manager"
    return 1
  }
  /usr/bin/python3 -B "$manager" materialize-profile \
    --canonical-home "$canonical_home" \
    --selected-home "$codex_home" \
    --apply >/dev/null || {
      _codex_error "failed to materialize the selected review-after-commit profile"
      return 1
    }
}

_codex_prepare_home() {
  local canonical_home="${CODEX_CANONICAL_HOME:-$HOME/.codex}"
  local state_root="${CODEX_STATE_ROOT:-$HOME/.codex-state}"
  local scope="${CODEX_WRAPPER_SCOPE:-repo}"
  local repo_root repo_identity repo_label repo_hash repo_key branch_key codex_home
  local shared_entry
  local shared_entries=(
    "AGENTS.md"
    "auth.json"
    "config.toml"
    "prompts"
    "rules"
    "skills"
  )

  case "$scope" in
    global)
      printf '%s\n' "$canonical_home"
      return 0
      ;;
    repo|project|branch)
      ;;
    *)
      _codex_error "_codex_prepare_home(): unsupported CODEX_WRAPPER_SCOPE '$scope' (expected global, repo, project, or branch)"
      return 1
      ;;
  esac

  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' "$canonical_home"
    return 0
  }

  if [[ "$scope" == "branch" ]]; then
    repo_key=$(_codex_safe_path_segment "${repo_root#/}")
    branch_key=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || \
      branch_key="detached-$(git rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    branch_key=$(_codex_safe_path_segment "$branch_key")
    codex_home="${state_root}/${repo_key}/${branch_key}"
  else
    repo_identity=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
      _codex_error "_codex_prepare_home(): failed to resolve the Git common directory for $repo_root"
      return 1
    }
    if [[ "$(basename "$repo_identity")" == ".git" ]]; then
      repo_label=$(basename "$(dirname "$repo_identity")")
    else
      repo_label=$(basename "$repo_identity")
      repo_label="${repo_label%.git}"
    fi
    repo_label=$(_codex_safe_path_segment "$repo_label")
    repo_hash=$(printf '%s' "$repo_identity" | git hash-object --stdin 2>/dev/null) || {
      _codex_error "_codex_prepare_home(): failed to hash the repository identity $repo_identity"
      return 1
    }
    codex_home="${state_root}/repos/${repo_label}-${repo_hash:0:12}"
  fi

  mkdir -p "$codex_home" || {
    _codex_error "_codex_prepare_home(): failed to create $codex_home"
    return 1
  }

  for shared_entry in "${shared_entries[@]}"; do
    _codex_link_shared_entry "${canonical_home}/${shared_entry}" "${codex_home}/${shared_entry}" || return 1
  done

  printf '%s\n' "$codex_home"
}

_codex_prepare_fresh_home() {
  local canonical_home="${CODEX_CANONICAL_HOME:-$HOME/.codex}"
  local state_root="${CODEX_FRESH_STATE_ROOT:-${CODEX_STATE_ROOT:-$HOME/.codex-state}/fresh}"
  local codex_home
  local shared_entry
  local shared_entries=(
    "AGENTS.md"
    "auth.json"
    "config.toml"
    "prompts"
    "rules"
    "skills"
  )

  mkdir -p "$state_root" || {
    _codex_error "_codex_prepare_fresh_home(): failed to create $state_root"
    return 1
  }

  codex_home=$(mktemp -d "${state_root}/codex-fresh.$(date +%Y%m%d%H%M%S).$$.XXXXXX") || {
    _codex_error "_codex_prepare_fresh_home(): failed to create isolated CODEX_HOME under $state_root"
    return 1
  }

  for shared_entry in "${shared_entries[@]}"; do
    _codex_link_shared_entry "${canonical_home}/${shared_entry}" "${codex_home}/${shared_entry}" || return 1
  done

  printf '%s\n' "$codex_home"
}

_codex_resolve_launch_dir() {
  local candidate="$PWD"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        break
        ;;
      -C|--cd)
        if [[ $# -lt 2 || -z "$2" ]]; then
          _codex_error "_codex_resolve_launch_dir(): $1 requires a directory"
          return 2
        fi
        candidate="$2"
        shift 2
        ;;
      --cd=*)
        candidate="${1#--cd=}"
        if [[ -z "$candidate" ]]; then
          _codex_error "_codex_resolve_launch_dir(): --cd requires a directory"
          return 2
        fi
        shift
        ;;
      -C?*)
        candidate="${1#-C}"
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  if [[ "$candidate" != /* ]]; then
    candidate="$PWD/$candidate"
  fi

  (cd -- "$candidate" 2>/dev/null && pwd -P) || {
    _codex_error "_codex_resolve_launch_dir(): directory does not exist: $candidate"
    return 2
  }
}

_codex_toml_basic_string() {
  local value="$1"

  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\b'/\\b}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\f'/\\f}"
  value="${value//$'\r'/\\r}"
  printf '%s' "$value"
}

# Appends the canonical home's node_repl MCP server (the ChatGPT app writes it,
# with version-pinned paths) to a bare config, restricted to the external
# Chrome backend so bare sessions keep browser use without the in-app browser
# or computer use. Without a canonical node_repl entry, warns and adds nothing.
_codex_append_bare_browser() {
  python3 - "$1" "$2" <<'PY'
import json
import pathlib
import sys
import tomllib

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
server = None
if source.is_file():
    server = tomllib.loads(source.read_text(encoding="utf-8")).get("mcp_servers", {}).get("node_repl")
if not isinstance(server, dict):
    print(f"codex bare: no [mcp_servers.node_repl] in {source}; browser use unavailable", file=sys.stderr)
    raise SystemExit(0)


def value(item):
    if isinstance(item, bool):
        return "true" if item else "false"
    if isinstance(item, (int, float)):
        return str(item)
    if isinstance(item, str):
        return json.dumps(item)
    if isinstance(item, list):
        return "[" + ", ".join(value(element) for element in item) + "]"
    raise SystemExit(f"unsupported node_repl config value in {source}: {item!r}")


env = dict(server.get("env", {}), BROWSER_USE_AVAILABLE_BACKENDS="chrome")
lines = ["", "[mcp_servers.node_repl]"]
lines += [f"{key} = {value(item)}" for key, item in server.items() if key != "env"]
lines += ["", "[mcp_servers.node_repl.env]"]
lines += [f"{json.dumps(key)} = {value(item)}" for key, item in env.items()]
with destination.open("a", encoding="utf-8") as handle:
    handle.write("\n".join(lines) + "\n")
tomllib.loads(destination.read_text(encoding="utf-8"))
PY
}

# Persistent low-context homes, separate from normal homes and other hook variants.
# Keeps the core coding loop plus external-Chrome browser use and arXiv MCP
# (injected by _codex_launch); every other optional tool family is off.
# project_doc_max_bytes does not suppress home-level AGENTS files: reject those.
# Machine-managed requirements outside CODEX_HOME still apply.
_codex_prepare_bare_home() {
  local launch_dir="${1:-$PWD}"
  local variant="${2:-plain}"
  local canonical_home="${CODEX_CANONICAL_HOME:-$HOME/.codex}"
  local state_root="${CODEX_BARE_STATE_ROOT:-${CODEX_STATE_ROOT:-$HOME/.codex-state}/bare}"
  local codex_home project_root project_root_toml project_key project_hash entry temp_config

  case "$variant" in
    plain|review-after-commit) ;;
    *) _codex_error "unsupported bare-home variant: $variant"; return 2 ;;
  esac

  project_root=$(git -C "$launch_dir" rev-parse --show-toplevel 2>/dev/null) || \
    project_root="$launch_dir"
  project_root=$(cd -- "$project_root" 2>/dev/null && pwd -P) || {
    _codex_error "_codex_prepare_bare_home(): failed to resolve project root for $launch_dir"
    return 1
  }
  project_root_toml=$(_codex_toml_basic_string "$project_root") || return 1

  project_key=$(_codex_safe_path_segment "$(basename "$project_root")")
  project_hash=$(printf '%s' "$project_root" | git hash-object --stdin) || return 1
  codex_home="${state_root}/repos/${project_key}-${project_hash:0:12}/${variant}"
  mkdir -p "$codex_home" || return 1
  for entry in AGENTS.md AGENTS.override.md; do
    if [[ -e "$codex_home/$entry" || -L "$codex_home/$entry" ]]; then
      _codex_error "bare home contains automatic instructions: $codex_home/$entry (relocate this file before launching)"
      return 1
    fi
  done
  if [[ -L "$codex_home/config.toml" || ( -e "$codex_home/config.toml" && ! -f "$codex_home/config.toml" ) ]]; then
    _codex_error "bare-home config must be an ordinary file: $codex_home/config.toml"
    return 1
  fi

  _codex_link_shared_entry "${canonical_home}/auth.json" "${codex_home}/auth.json" || return 1
  _codex_link_shared_entry "${canonical_home}/skills" "${codex_home}/skills" || return 1

  temp_config=$(mktemp "${codex_home}/.config.toml.XXXXXX") || return 1
  if ! cat >"$temp_config" <<EOF
# Written by the bare Codex launcher. Project customizations and automatic
# skill/plugin context are intentionally disabled; explicit \$skill mentions still work.
# The untrusted trust_level below derives a strict command-approval policy; the
# explicit approval_policy overrides it so bare launches run full access without
# prompts (matching the scoped/fresh wrappers, which inherit this from ~/.codex).
approval_policy = "never"
sandbox_mode = "danger-full-access"
project_doc_max_bytes = 0
include_apps_instructions = false

[skills]
include_instructions = false

[features]
apps = false
browser_use = true
browser_use_external = true
computer_use = false
goals = false
image_generation = false
in_app_browser = false
memories = false
plugin_sharing = false
plugins = false
remote_plugin = false
skill_mcp_dependency_install = false
skill_search = false
tool_suggest = false
workspace_dependencies = false

[memories]
use_memories = false
generate_memories = false

[projects."${project_root_toml}"]
trust_level = "untrusted"
EOF
  then
    rm -f "$temp_config"
    _codex_error "_codex_prepare_bare_home(): failed to write ${codex_home}/config.toml"
    return 1
  fi
  if ! _codex_append_bare_browser "${canonical_home}/config.toml" "$temp_config"; then
    rm -f "$temp_config"
    _codex_error "_codex_prepare_bare_home(): failed to add browser use to ${codex_home}/config.toml"
    return 1
  fi
  if cmp -s "$temp_config" "$codex_home/config.toml"; then
    rm -f "$temp_config"
  else
    mv -f "$temp_config" "$codex_home/config.toml" || { rm -f "$temp_config"; return 1; }
  fi

  printf '%s\n' "$codex_home"
}

# Shared base for Codex wrapper configurations:
#   $1 home   : "scoped" (repository state) | "fresh" (isolated, customized) | "bare" (isolated, mention-only skills)
#   $2 output : "stream" (normal terminal output) | "final" (cdxe-style last message only)
#   $3 model  : "" to inherit config | model name
#   $4 effort : "" to inherit config | reasoning effort
# Stream mode accepts additional Codex flags after these axes, and doubles as
# headless mode: `-p`/`--print`/`--prompt` (with `=`/attached/separate values,
# bare with piped stdin) or a leading `exec`/`e` subcommand runs cdxe-style
# final-only output, so every stream wrapper works as a launcher and headlessly
# (like agg/aggb). `-p` is print, not --profile: spell profiles `--profile`.
# Explicit --json/-o keeps streaming exec output; review flags and exec
# subcommands (resume/fork/review/help) stay native-streaming. Final mode
# treats all remaining arguments as prompt input, matching cdxe (leading print
# flags are accepted and stripped for uniformity).
_codex_sync_api_auth() {
  local api_home="$1"
  local auth_file="${api_home}/auth.json"
  local key="${OPENAI_API_KEY:-}"

  [[ -n "$key" ]] || return 0
  if [[ -L "$auth_file" ]]; then
    _codex_error "_codex_use_api_env(): refusing to overwrite symlinked auth file: $auth_file"
    return 1
  fi
  if [[ ! -d "$api_home" ]]; then
    ( umask 077 && mkdir -p "$api_home" ) || {
      _codex_error "_codex_use_api_env(): failed to create $api_home"
      return 1
    }
  fi

  python3 - "$auth_file" <<'PY' || return 1
import json
import os
import pathlib
import sys
import tempfile

path = pathlib.Path(sys.argv[1])
key = os.environ.get("OPENAI_API_KEY", "")
if not key:
    sys.exit(0)

if path.is_symlink():
    sys.stderr.write(f"_codex_use_api_env(): refusing to overwrite symlinked auth file: {path}\n")
    sys.exit(1)

if path.exists():
    try:
        existing = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        sys.stderr.write(f"_codex_use_api_env(): failed to read existing {path}: {exc}\n")
        sys.exit(1)
    if not isinstance(existing, dict):
        sys.stderr.write(f"_codex_use_api_env(): unexpected JSON in {path}\n")
        sys.exit(1)
    if existing.get("auth_mode") == "chatgpt" or "tokens" in existing:
        sys.stderr.write(
            f"_codex_use_api_env(): refusing to overwrite ChatGPT OAuth credentials in {path}\n"
        )
        sys.exit(1)
    if existing.get("auth_mode") == "apikey" and existing.get("OPENAI_API_KEY") == key:
        sys.exit(0)

os.umask(0o077)
fd, temp_name = tempfile.mkstemp(prefix=".auth.json.", dir=path.parent)
try:
    os.chmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump({"auth_mode": "apikey", "OPENAI_API_KEY": key}, handle, indent=2)
        handle.write("\n")
    os.chmod(temp_name, 0o600)
    os.replace(temp_name, path)
finally:
    if os.path.exists(temp_name):
        os.unlink(temp_name)
PY
}

_codex_use_api_env() {
  local api_home="${CODEX_API_HOME:-$HOME/.codex-api}"
  _codex_sync_api_auth "$api_home" || return 1
  export CODEX_HOME="$api_home"
  export CODEX_CANONICAL_HOME="$CODEX_HOME"
  export CODEX_STATE_ROOT="${CODEX_API_STATE_ROOT:-$HOME/.codex-state-api}"
  unset CODEX_FRESH_STATE_ROOT CODEX_BARE_STATE_ROOT
  unset OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN
}

_codex_launch() (
  if [[ $# -lt 4 ]]; then
    _codex_error "_codex_launch(): expected home, output, model, and effort"
    return 2
  fi

  local home_mode="$1"; shift
  local output_mode="$1"; shift
  local model="$1"; shift
  local effort="$1"; shift
  local codex_home
  local launch_dir="$PWD"
  local hook_name=""
  local argument review_seam
  local review_requested="no"
  local -A review_selection=()
  local forwarded_args=()

  # Experimental context-manager and API-key opt-ins, shared by all Codex wrappers:
  #   cdx --ctx-mgmt ... | cax -cm ... | cdx --api-key ... | cam -ak ...
  # Consumed here and never forwarded to codex; `-cm` translates to
  #   -c 'features.context_management.experimental_mode=true'
  # (`--no-ctx-mgmt` / `--ctx-mgmt=false` force-disable). `-m` is
  # intentionally not used here -- it stays codex `-m/--model`.
  local ctx_mgmt="unset"
  local api_key="no"
  local service_tier=""
  local -a ctx_mgmt_kept=()
  local ctx_arg ctx_stop="no"
  if [[ "$output_mode" == "final" ]]; then
    # Final mode treats arguments as prompt text: strip only leading flags
    # so prompt wording is never mangled. Leading print flags are accepted
    # for uniformity with stream dual-mode (`cdxe -p "prompt"`); the flag is
    # dropped and its value kept as prompt text.
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --ctx-mgmt|--ctx-mgmt=true|--ctx-mgmt=1|--ctx-mgmt=yes|--ctx-mgmt=on)
          ctx_mgmt="yes"; shift ;;
        --no-ctx-mgmt|--ctx-mgmt=false|--ctx-mgmt=0|--ctx-mgmt=no|--ctx-mgmt=off)
          ctx_mgmt="no"; shift ;;
        -cm) ctx_mgmt="yes"; shift ;;
        --api-key|-ak) api_key="yes"; shift ;;
        -f) service_tier="fast"; shift ;;
        -uf) service_tier="ultrafast"; shift ;;
        --print|--prompt|-p)
          shift
          if [[ $# -gt 0 && "$1" != "--" ]]; then ctx_mgmt_kept+=("$1"); shift; fi ;;
        --print=*|--prompt=*)
          [[ -n "${1#*=}" ]] && ctx_mgmt_kept+=("${1#*=}")
          shift ;;
        -p=*)
          [[ -n "${1#-p=}" ]] && ctx_mgmt_kept+=("${1#-p=}")
          shift ;;
        -p?*)
          ctx_mgmt_kept+=("${1#-p}"); shift ;;
        --)
          ctx_mgmt_kept+=("$1"); shift
          while [[ $# -gt 0 ]]; do ctx_mgmt_kept+=("$1"); shift; done ;;
        -*) break ;;
        *) break ;;
      esac
    done
    while [[ $# -gt 0 ]]; do ctx_mgmt_kept+=("$1"); shift; done
  else
    # Stream mode: strip our flags anywhere before `--`; keep the rest.
    while [[ $# -gt 0 ]]; do
      ctx_arg="$1"; shift
      if [[ "$ctx_stop" == "yes" ]]; then ctx_mgmt_kept+=("$ctx_arg"); continue; fi
      case "$ctx_arg" in
        --) ctx_stop="yes"; ctx_mgmt_kept+=("$ctx_arg") ;;
        --ctx-mgmt|--ctx-mgmt=true|--ctx-mgmt=1|--ctx-mgmt=yes|--ctx-mgmt=on)
          ctx_mgmt="yes" ;;
        --no-ctx-mgmt|--ctx-mgmt=false|--ctx-mgmt=0|--ctx-mgmt=no|--ctx-mgmt=off)
          ctx_mgmt="no" ;;
        -cm) ctx_mgmt="yes" ;;
        --api-key|-ak) api_key="yes" ;;
        --print|--prompt|-p)
          ctx_mgmt_kept+=("$ctx_arg")
          # A speed flag in print's value position is literal prompt text.
          case "${1-}" in -f|-uf) ctx_mgmt_kept+=("$1"); shift ;; esac ;;
        -f) service_tier="fast" ;;
        -uf) service_tier="ultrafast" ;;
        *) ctx_mgmt_kept+=("$ctx_arg") ;;
      esac
    done
  fi
  set -- "${ctx_mgmt_kept[@]}"
  local canonical_home="${CODEX_CANONICAL_HOME:-$HOME/.codex}"
  if [[ "$api_key" == "yes" || "$canonical_home" == "${CODEX_API_HOME:-$HOME/.codex-api}" ||
        "$canonical_home" == "${CODEX2_HOME:-$HOME/.codex2}" ]]; then
    if [[ -n "$service_tier" ]]; then
      _codex_error "-f and -uf are only supported on the main Codex account"
      return 2
    fi
  else
    service_tier="${service_tier:-default}"
  fi
  if [[ "$api_key" == "yes" ]]; then
    _codex_use_api_env || return 1
  fi

  case "$output_mode" in
    stream|final) ;;
    *)
      _codex_error "_codex_launch(): unsupported output mode '$output_mode' (expected stream or final)"
      return 2
      ;;
  esac

  if [[ "$output_mode" == "stream" ]]; then
    for argument in "$@"; do
      case "$argument" in
        --) break ;;
        --review-mode|--review-mode=*|--review-standard-every|--review-standard-every=*|--review-branch-every|--review-branch-every=*|--hook|--hook=*|--hook-option|--hook-option=*)
          review_requested="yes"
          ;;
      esac
    done
    if [[ "$review_requested" == "yes" ]]; then
      review_seam="${CODEX_CANONICAL_HOME:-$HOME/.codex}/hooks/review-after-commit/shell/review-after-commit.bash"
      [[ -r "$review_seam" ]] || {
        _codex_error "review-after-commit launcher seam is not readable: $review_seam"
        return 1
      }
      # shellcheck disable=SC1090
      source "$review_seam" || return
      review_after_commit_parse codex review_selection forwarded_args "$@" || return
      set -- "${forwarded_args[@]}"
      if [[ "${review_selection[enabled]}" == "1" ]]; then
        hook_name="review-after-commit"
      fi
    fi
  fi

  # Dual-mode headless for the stream wrappers: every cdx/cdxb/... wrapper
  # works as an interactive launcher and headlessly (like agg/aggb), so no
  # per-permutation headless wrapper is needed. Codex spells headless `exec`
  # and uses `-p` for `--profile`, so a Claude-style print flag (`-p`,
  # `--print`, `--prompt`, with `=`/attached/separate values, or bare with
  # piped stdin) or a leading `exec`/`e` subcommand reroutes to an exec run.
  # `-p` means print here; spell config profiles `--profile`. Skipped for
  # review-hook runs (hooks only apply to stream mode) and for native
  # `exec <resume|fork|review|help>` subcommands. Without explicit --json/-o
  # output control the run uses cdxe-style final-only capture; with it, native
  # streaming exec output is preserved.
  local headless_active="no"
  local -a headless_top_opts=() headless_exec_opts=()
  if [[ "$output_mode" == "stream" && "$review_requested" == "no" ]]; then
    local -a scan_args=()
    [[ $# -gt 0 ]] && scan_args=("$@")
    local -a scan_top=() scan_exec=() scan_prompt=()
    local scan_headless="no" scan_stop="no" scan_pending="" scan_first="yes"
    local scan_post_exec_first="no" scan_saw_print="no" scan_explicit="no"
    local scan_abort="no" scan_token scan_value scan_i
    for (( scan_i = 0; scan_i < ${#scan_args[@]}; scan_i = scan_i + 1 )); do
      scan_token="${scan_args[scan_i]}"
      if [[ "$scan_stop" == "yes" ]]; then scan_prompt+=("$scan_token"); continue; fi
      if [[ -n "$scan_pending" ]]; then
        if [[ "$scan_pending" == "exec" ]]; then scan_exec+=("$scan_token"); else scan_top+=("$scan_token"); fi
        scan_pending=""
        continue
      fi
      case "$scan_token" in
        --)
          scan_stop="yes"; scan_first="no" ;;
        --print|--prompt|-p)
          scan_headless="yes"; scan_saw_print="yes"
          if (( scan_i + 1 < ${#scan_args[@]} )) && [[ "${scan_args[scan_i + 1]}" != "--" ]]; then
            scan_i=$(( scan_i + 1 )); scan_prompt+=("${scan_args[scan_i]}")
          fi ;;
        --print=*|--prompt=*)
          scan_headless="yes"; scan_saw_print="yes"
          scan_value="${scan_token#*=}"
          [[ -n "$scan_value" ]] && scan_prompt+=("$scan_value") ;;
        -p=*)
          scan_headless="yes"; scan_saw_print="yes"
          scan_value="${scan_token#-p=}"
          [[ -n "$scan_value" ]] && scan_prompt+=("$scan_value") ;;
        -p?*)
          scan_headless="yes"; scan_saw_print="yes"
          scan_prompt+=("${scan_token#-p}") ;;
        --json)
          scan_exec+=("$scan_token"); scan_explicit="yes" ;;
        -o|--output-last-message|--output-schema|--color|--thread-source)
          scan_exec+=("$scan_token"); scan_pending="exec"
          case "$scan_token" in -o|--output-last-message) scan_explicit="yes" ;; esac ;;
        --output-last-message=*|--output-schema=*|--color=*|--thread-source=*)
          scan_exec+=("$scan_token")
          case "$scan_token" in --output-last-message=*) scan_explicit="yes" ;; esac ;;
        -o?*)
          scan_exec+=("$scan_token"); scan_explicit="yes" ;;
        --skip-git-repo-check|--ephemeral|--ignore-user-config|--ignore-rules)
          scan_exec+=("$scan_token") ;;
        -c|--config|-m|--model|--profile|-s|--sandbox|-C|--cd|--add-dir|-a|--ask-for-approval|-i|--image|--remote|--remote-auth-token-env|--local-provider|--enable|--disable)
          scan_top+=("$scan_token"); scan_pending="top" ;;
        --config=*|--model=*|--profile=*|--sandbox=*|--cd=*|--add-dir=*|--ask-for-approval=*|--image=*|--remote=*|--remote-auth-token-env=*|--local-provider=*|--enable=*|--disable=*)
          scan_top+=("$scan_token") ;;
        -C?*|-c?*|-m?*|-s?*|-a?*|-i?*)
          scan_top+=("$scan_token") ;;
        -*)
          scan_top+=("$scan_token") ;;
        exec|e)
          if [[ "$scan_first" == "yes" ]]; then
            scan_headless="yes"; scan_post_exec_first="yes"
          else
            scan_prompt+=("$scan_token")
          fi
          scan_first="no" ;;
        *)
          if [[ "$scan_post_exec_first" == "yes" ]]; then
            scan_post_exec_first="no"
            if [[ "$scan_saw_print" == "no" ]]; then
              case "$scan_token" in
                resume|fork|review|help) scan_abort="yes" ;;
              esac
            fi
          fi
          scan_prompt+=("$scan_token"); scan_first="no" ;;
      esac
    done
    if [[ "$scan_abort" == "yes" ]]; then
      : # Native exec subcommand: leave stream passthrough untouched.
    elif [[ "$scan_headless" == "yes" ]]; then
      if [[ "$scan_explicit" == "yes" && "$scan_saw_print" == "no" ]]; then
        : # Explicit output control with native exec: leave streaming as-is.
      else
        headless_active="yes"
        [[ ${#scan_top[@]} -gt 0 ]] && headless_top_opts=("${scan_top[@]}")
        [[ ${#scan_exec[@]} -gt 0 ]] && headless_exec_opts=("${scan_exec[@]}")
        if [[ "$scan_explicit" == "yes" ]]; then
          output_mode="stream-exec"
        else
          output_mode="final"
        fi
        if [[ ${#scan_prompt[@]} -gt 0 ]]; then
          set -- "${scan_prompt[@]}"
        else
          set --
        fi
      fi
    fi
  fi

  if [[ "$home_mode" == "bare" ]]; then
    if [[ "$headless_active" == "yes" ]]; then
      if [[ ${#headless_top_opts[@]} -gt 0 ]]; then
        launch_dir=$(_codex_resolve_launch_dir "${headless_top_opts[@]}") || return 2
      else
        launch_dir="$PWD"
      fi
    elif [[ "$output_mode" == "stream" ]]; then
      launch_dir=$(_codex_resolve_launch_dir "$@") || return 2
    fi
  fi

  case "$home_mode" in
    scoped) codex_home=$(_codex_prepare_home) || return 1 ;;
    fresh) codex_home=$(_codex_prepare_fresh_home) || return 1 ;;
    bare) codex_home=$(_codex_prepare_bare_home "$launch_dir" "${hook_name:-plain}") || return 1 ;;
    *)
      _codex_error "_codex_launch(): unsupported home mode '$home_mode' (expected scoped, fresh, or bare)"
      return 2
      ;;
  esac

  if [[ -n "$hook_name" ]]; then
    _codex_activate_hook "$codex_home" "$hook_name" || return 1
  fi

  local codex_args=()
  [[ -n "$model" ]] && codex_args+=(-m "$model")
  [[ -n "$effort" ]] && codex_args+=(-c "model_reasoning_effort=$effort")
  # Injected before user args so an explicit user -c for the same key wins.
  [[ -n "$service_tier" ]] && codex_args+=(-c "service_tier=$service_tier")
  case "$ctx_mgmt" in
    yes) codex_args+=(-c 'features.context_management.experimental_mode=true') ;;
    no) codex_args+=(-c 'features.context_management.experimental_mode=false') ;;
  esac
  # Every home mode, bare included, gets arXiv.
  # Temporary MCP 1.x pin; remove once arxiv-mcp-server migrates to MCP 2.
  codex_args+=(
    -c 'mcp_servers.arxiv.command="uvx"'
    -c 'mcp_servers.arxiv.args=["--with", "mcp<2", "arxiv-mcp-server"]'
  )

  unset OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN
  unset OPENAI_BASE_URL
  unset REVIEW_AFTER_COMMIT_MODE
  unset CODEX_HOOK_REVIEW_AFTER_COMMIT_BRANCH_EVERY
  unset CODEX_HOOK_REVIEW_AFTER_COMMIT_STANDARD_EVERY CODEX_HOOK_STATE_DIR

  if [[ -n "$hook_name" ]]; then
    review_after_commit_export_environment codex "$codex_home" review_selection || return
    codex_args+=(--profile "$hook_name")
    if [[ "$home_mode" == "bare" ]]; then
      codex_args+=(--dangerously-bypass-hook-trust)
    fi
  fi

  if [[ "$output_mode" == "stream" ]]; then
    CODEX_HOME="$codex_home" command codex "${codex_args[@]}" "$@"
    return
  fi

  if [[ "$output_mode" == "stream-exec" ]]; then
    # Headless with explicit output control (--json/-o): native streaming exec
    # output, honoring the caller's format instead of final-only capture.
    # The fixed --skip-git-repo-check below would collide with a user copy
    # (codex rejects repeated options), so drop the user's; same value.
    local -a dedup_exec_opts=()
    if [[ ${#headless_exec_opts[@]} -gt 0 ]]; then
      local dedup_opt
      for dedup_opt in "${headless_exec_opts[@]}"; do
        [[ "$dedup_opt" == "--skip-git-repo-check" ]] || dedup_exec_opts+=("$dedup_opt")
      done
    fi
    local -a exec_cmd=()
    [[ ${#codex_args[@]} -gt 0 ]] && exec_cmd+=("${codex_args[@]}")
    [[ ${#headless_top_opts[@]} -gt 0 ]] && exec_cmd+=("${headless_top_opts[@]}")
    exec_cmd+=(exec --skip-git-repo-check)
    [[ ${#dedup_exec_opts[@]} -gt 0 ]] && exec_cmd+=("${dedup_exec_opts[@]}")
    if [[ $# -gt 0 ]]; then
      CODEX_HOME="$codex_home" command codex "${exec_cmd[@]}" -- "$@" </dev/null
      return $?
    fi
    CODEX_HOME="$codex_home" command codex "${exec_cmd[@]}"
    return $?
  fi

  local output_file log_file status
  local wrapper_name="${FUNCNAME[1]:-_codex_launch}"

  output_file=$(mktemp "${TMPDIR:-/tmp}/codex-final-last-message.XXXXXX") || return 1
  log_file=$(mktemp "${TMPDIR:-/tmp}/codex-final-output.XXXXXX") || {
    rm -f "$output_file"
    return 1
  }
  trap 'rm -f "$output_file" "$log_file"' EXIT

  # Headless reroutes from stream mode keep their Codex options: top-level
  # options ride before `exec`, exec-only options after it. The fixed capture
  # flags stay last so final-only behavior always wins here; callers wanting
  # their own output format take the stream-exec path instead. Options the
  # fixed flags shadow (-s, --color, -o, --skip-git-repo-check) are dropped
  # first -- codex rejects repeated single-value options.
  if [[ "$headless_active" == "yes" ]]; then
    local -a dedup_top=() dedup_exec=()
    local dedup_skip="no" dedup_opt
    if [[ ${#headless_top_opts[@]} -gt 0 ]]; then
      for dedup_opt in "${headless_top_opts[@]}"; do
        if [[ "$dedup_skip" == "yes" ]]; then dedup_skip="no"; continue; fi
        case "$dedup_opt" in
          -s|--sandbox) dedup_skip="yes" ;;
          -s?*|--sandbox=*) : ;;
          *) dedup_top+=("$dedup_opt") ;;
        esac
      done
    fi
    if [[ ${#headless_exec_opts[@]} -gt 0 ]]; then
      for dedup_opt in "${headless_exec_opts[@]}"; do
        if [[ "$dedup_skip" == "yes" ]]; then dedup_skip="no"; continue; fi
        case "$dedup_opt" in
          --skip-git-repo-check) : ;;
          -o|--output-last-message|--color) dedup_skip="yes" ;;
          -o?*|--output-last-message=*|--color=*) : ;;
          *) dedup_exec+=("$dedup_opt") ;;
        esac
      done
    fi
    headless_top_opts=()
    [[ ${#dedup_top[@]} -gt 0 ]] && headless_top_opts=("${dedup_top[@]}")
    headless_exec_opts=()
    [[ ${#dedup_exec[@]} -gt 0 ]] && headless_exec_opts=("${dedup_exec[@]}")
  fi
  [[ ${#headless_top_opts[@]} -gt 0 ]] && codex_args+=("${headless_top_opts[@]}")
  codex_args+=(
    -c hide_agent_reasoning=true
    -s danger-full-access
    exec
    --skip-git-repo-check
  )
  [[ ${#headless_exec_opts[@]} -gt 0 ]] && codex_args+=("${headless_exec_opts[@]}")
  codex_args+=(
    --output-last-message "$output_file"
    --color never
  )

  if [[ $# -gt 0 ]]; then
    CODEX_HOME="$codex_home" command codex "${codex_args[@]}" -- "$@" </dev/null >"$log_file" 2>&1
  else
    CODEX_HOME="$codex_home" command codex "${codex_args[@]}" >"$log_file" 2>&1
  fi
  status=$?

  if [[ -s "$output_file" ]]; then
    cat "$output_file"
    printf '\n'
  elif [[ $status -ne 0 ]]; then
    printf '%s(): codex exec failed with status %s\n' "$wrapper_name" "$status" >&2
    cat "$log_file" >&2
  fi

  return "$status"
)

# Raw scoped launcher retained for callers that already supply all Codex flags.
_codex() { _codex_launch "scoped" "stream" "" "" "$@"; }

ctx()   { _codex_launch "scoped" "stream" "gpt-6.1-terra" "xhigh" -s danger-full-access "$@"; }
ctxb()  { _codex_launch "bare" "stream" "gpt-6.1-terra" "xhigh"   -s danger-full-access "$@"; }
ctm()   { _codex_launch "scoped" "stream" "gpt-6.1-terra" "max"   -s danger-full-access "$@"; }
ctmb()  { _codex_launch "bare" "stream" "gpt-6.1-terra" "max"     -s danger-full-access "$@"; }

cdu()   { _codex_launch "scoped" "stream" "gpt-6.2-sol" "ultra"  -s danger-full-access "$@"; }
cdub()   { _codex_launch "bare" "stream" "gpt-6.2-sol" "ultra"  -s danger-full-access "$@"; }
cduf()  { _codex_launch "scoped" "stream" "gpt-6.2-sol" "ultra"  -s danger-full-access -c service_tier=fast "$@"; }

cdm()   { _codex_launch "scoped" "stream" "gpt-6.2-sol" "max"  -s danger-full-access "$@"; }
cdmb()   { _codex_launch "bare" "stream" "gpt-6.2-sol" "max"  -s danger-full-access "$@"; }
cdmf()  { _codex_launch "scoped" "stream" "gpt-6.2-sol" "max"  -s danger-full-access -c service_tier=fast "$@"; }

cdmM() {
  cdm -c agents.enabled=true \
    -c agents.max_concurrent_threads_per_session=16 \
    -c agents.max_depth=2 \
    -c 'agents.default_subagent_model="gpt-6.2-sol"' \
    -c 'agents.default_subagent_reasoning_effort="max"' "$@"
}

cdx()   { _codex_launch "scoped" "stream" "gpt-6.2-sol" "xhigh"  -s danger-full-access "$@"; }
cdx-fresh() { _codex_launch "fresh" "stream" "gpt-6.2-sol" "xhigh" -s danger-full-access "$@"; }
cdxb()   { _codex_launch "bare" "stream" "gpt-6.2-sol" "xhigh"  -s danger-full-access "$@"; }
cdxf()  { _codex_launch "scoped" "stream" "gpt-6.2-sol" "xhigh"  -s danger-full-access -c service_tier=fast "$@"; }

cdxX() {
  cdx -c agents.enabled=true \
    -c agents.max_concurrent_threads_per_session=16 \
    -c agents.max_depth=2 \
    -c 'agents.default_subagent_model="gpt-6.2-sol"' \
    -c 'agents.default_subagent_reasoning_effort="xhigh"' "$@"
}

cdh()  { _codex_launch "scoped" "stream" "gpt-6.2-sol" "high"   -s danger-full-access "$@"; }
cdhb()  { _codex_launch "bare" "stream" "gpt-6.2-sol" "high"   -s danger-full-access "$@"; }
cdhf() { _codex_launch "scoped" "stream" "gpt-6.2-sol" "high"   -s danger-full-access -c service_tier=fast "$@"; }

cdmm() { _codex_launch "scoped" "stream" "gpt-6.2-sol" "medium" -s danger-full-access "$@"; }
cdmmb() { _codex_launch "bare" "stream" "gpt-6.2-sol" "medium" -s danger-full-access "$@"; }
cdxmf() { _codex_launch "scoped" "stream" "gpt-6.2-sol" "medium" -s danger-full-access -c service_tier=fast "$@"; }

cdxl()  { _codex_launch "scoped" "stream" "gpt-6.2-sol" "low" -s danger-full-access "$@"; }

clu()   { _codex_launch "scoped" "stream" "gpt-6-luna" "ultra"  -s danger-full-access "$@"; }
club()   { _codex_launch "bare" "stream" "gpt-6-luna" "ultra"  -s danger-full-access "$@"; }

clm()   { _codex_launch "scoped" "stream" "gpt-6-luna" "max"  -s danger-full-access "$@"; }
clmb()   { _codex_launch "bare" "stream" "gpt-6-luna" "max"  -s danger-full-access "$@"; }

clx()   { _codex_launch "scoped" "stream" "gpt-6-luna" "xhigh"  -s danger-full-access "$@"; }
clxb()   { _codex_launch "bare" "stream" "gpt-6-luna" "xhigh"  -s danger-full-access "$@"; }

cau()   { _codex_launch "scoped" "stream" "gpt-6.2-astra" "ultra"  -s danger-full-access "$@"; }
caub()  { _codex_launch "bare" "stream" "gpt-6.2-astra" "ultra"  -s danger-full-access "$@"; }

cam()   { _codex_launch "scoped" "stream" "gpt-6.2-astra" "max"  -s danger-full-access "$@"; }
camb()  { _codex_launch "bare" "stream" "gpt-6.2-astra" "max"  -s danger-full-access "$@"; }

cax()   { _codex_launch "scoped" "stream" "gpt-6.2-astra" "xhigh"  -s danger-full-access "$@"; }
caxb()  { _codex_launch "bare" "stream" "gpt-6.2-astra" "xhigh"  -s danger-full-access "$@"; }

camM() {
  cam -c agents.enabled=true \
    -c agents.max_concurrent_threads_per_session=16 \
    -c agents.max_depth=2 \
    -c 'agents.default_subagent_model="gpt-6.2-astra"' \
    -c 'agents.default_subagent_reasoning_effort="max"' "$@"
}

caxX() {
  cax -c agents.enabled=true \
    -c agents.max_concurrent_threads_per_session=16 \
    -c agents.max_depth=2 \
    -c 'agents.default_subagent_model="gpt-6.2-astra"' \
    -c 'agents.default_subagent_reasoning_effort="xhigh"' "$@"
}

cah()   { _codex_launch "scoped" "stream" "gpt-6.2-astra" "high"   -s danger-full-access "$@"; }
cahb()  { _codex_launch "bare" "stream" "gpt-6.2-astra" "high"   -s danger-full-access "$@"; }

camm()  { _codex_launch "scoped" "stream" "gpt-6.2-astra" "medium" -s danger-full-access "$@"; }
cammb() { _codex_launch "bare" "stream" "gpt-6.2-astra" "medium" -s danger-full-access "$@"; }

cdal()  { _codex_launch "scoped" "stream" "gpt-6.2-astra" "low" -s danger-full-access "$@"; }
cdalb() { _codex_launch "bare" "stream" "gpt-6.2-astra" "low" -s danger-full-access "$@"; }

cdxe() { _codex_launch "scoped" "final" "gpt-6.2-sol" "xhigh" "$@"; }
cdxe-fresh() { _codex_launch "fresh" "final" "gpt-6.2-sol" "xhigh" "$@"; }
cdme() { _codex_launch "scoped" "final" "gpt-6.2-sol" "max" "$@"; }
clme() { _codex_launch "scoped" "final" "gpt-6-luna" "max" "$@"; }

cdube() { _codex_launch "bare" "final" "gpt-6.2-sol" "ultra" "$@"; }
cdmbe() { _codex_launch "bare" "final" "gpt-6.2-sol" "max" "$@"; }
clmbe() { _codex_launch "bare" "final" "gpt-6-luna" "max" "$@"; }
cdxbe() { _codex_launch "bare" "final" "gpt-6.2-sol" "xhigh" "$@"; }
cdhbe() { _codex_launch "bare" "final" "gpt-6.2-sol" "high" "$@"; }
cdmmbe() { _codex_launch "bare" "final" "gpt-6.2-sol" "medium" "$@"; }
cdlbe() { _codex_launch "bare" "final" "gpt-6.2-sol" "low" "$@"; }

# ---- Codex Resume Wrapper ------------------------------------------
# Discover both accounts; the selected session keeps its original home/account.
cdxr() (
  local launcher="${CODEX_RESUME_LAUNCHER:-${CODEX_SESSION_HELPER:-$HOME/.local/bin/codex-sessions}}"
  if [[ ! -x "$launcher" ]]; then
    echo "cdxr(): resume launcher not found or not executable: $launcher" >&2
    echo "Tip: install SHELL/codex_sessions.py to ~/.local/bin/codex-sessions" >&2
    return 1
  fi
  # Same --ctx-mgmt / -cm opt-in as the _codex_launch wrappers; the resume
  # launcher forwards trailing -c flags to codex.
  local ctx_mgmt="unset"
  local -a ctx_kept=()
  local ctx_stop="no"
  while [[ $# -gt 0 ]]; do
    if [[ "$ctx_stop" == "yes" ]]; then ctx_kept+=("$1"); shift; continue; fi
    case "$1" in
      --) ctx_stop="yes"; ctx_kept+=("$1"); shift ;;
      --ctx-mgmt) ctx_mgmt="yes"; shift ;;
      --no-ctx-mgmt) ctx_mgmt="no"; shift ;;
      -cm) ctx_mgmt="yes"; shift ;;
      *) ctx_kept+=("$1"); shift ;;
    esac
  done
  set -- "${ctx_kept[@]}"
  case "$ctx_mgmt" in
    yes) set -- -c 'features.context_management.experimental_mode=true' "$@" ;;
    no) set -- -c 'features.context_management.experimental_mode=false' "$@" ;;
  esac
  unset OPENAI_BASE_URL
  "$launcher" "$@"
)
# --------------------------------------------------------------------

# Secondary Codex account. The subshell keeps account selection local to each
# invocation, and the separate state root prevents repository-home collisions.
_codex_secondary() (
  export CODEX_HOME="${CODEX2_HOME:-$HOME/.codex2}"
  export CODEX_CANONICAL_HOME="$CODEX_HOME"
  export CODEX_STATE_ROOT="${CODEX2_STATE_ROOT:-$HOME/.codex-state2}"
  unset CODEX_FRESH_STATE_ROOT CODEX_BARE_STATE_ROOT
  unset OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN

  "$@"
)

_codex2() { _codex_secondary _codex "$@"; }

ctx2()  { _codex_secondary ctx "$@"; }
ctxb2() { _codex_secondary ctxb "$@"; }
ctm2()  { _codex_secondary ctm "$@"; }
ctmb2() { _codex_secondary ctmb "$@"; }

cdu2()   { _codex_secondary cdu "$@"; }
cdub2()  { _codex_secondary cdub "$@"; }
cduf2()  { _codex_secondary cduf "$@"; }

cdm2()   { _codex_secondary cdm "$@"; }
cdmM2()  { _codex_secondary cdmM "$@"; }
cdmb2()  { _codex_secondary cdmb "$@"; }
cdmf2()  { _codex_secondary cdmf "$@"; }

cdx2()       { _codex_secondary cdx "$@"; }
cdxX2()      { _codex_secondary cdxX "$@"; }
cdx-fresh2() { _codex_secondary cdx-fresh "$@"; }
cdxb2()      { _codex_secondary cdxb "$@"; }
cdxf2()      { _codex_secondary cdxf "$@"; }

cdh2()   { _codex_secondary cdh "$@"; }
cdhb2()  { _codex_secondary cdhb "$@"; }
cdhf2()  { _codex_secondary cdhf "$@"; }

cdmm2()  { _codex_secondary cdmm "$@"; }
cdmmb2() { _codex_secondary cdmmb "$@"; }
cdxmf2() { _codex_secondary cdxmf "$@"; }
cdxl2()  { _codex_secondary cdxl "$@"; }

clu2()  { _codex_secondary clu "$@"; }
club2() { _codex_secondary club "$@"; }
clm2()  { _codex_secondary clm "$@"; }
clmb2() { _codex_secondary clmb "$@"; }
clx2()  { _codex_secondary clx "$@"; }
clxb2() { _codex_secondary clxb "$@"; }

cau2()   { _codex_secondary cau "$@"; }
caub2()  { _codex_secondary caub "$@"; }
cam2()   { _codex_secondary cam "$@"; }
camM2()  { _codex_secondary camM "$@"; }
camb2()  { _codex_secondary camb "$@"; }
cax2()   { _codex_secondary cax "$@"; }
caxX2()  { _codex_secondary caxX "$@"; }
caxb2()  { _codex_secondary caxb "$@"; }
cah2()   { _codex_secondary cah "$@"; }
cahb2()  { _codex_secondary cahb "$@"; }
camm2()  { _codex_secondary camm "$@"; }
cammb2() { _codex_secondary cammb "$@"; }
cdal2()  { _codex_secondary cdal "$@"; }
cdalb2() { _codex_secondary cdalb "$@"; }

cdxe2()       { _codex_secondary cdxe "$@"; }
cdxe-fresh2() { _codex_secondary cdxe-fresh "$@"; }
cdme2()       { _codex_secondary cdme "$@"; }
clme2()       { _codex_secondary clme "$@"; }

cdube2()  { _codex_secondary cdube "$@"; }
cdmbe2()  { _codex_secondary cdmbe "$@"; }
clmbe2()  { _codex_secondary clmbe "$@"; }
cdxbe2()  { _codex_secondary cdxbe "$@"; }
cdhbe2()  { _codex_secondary cdhbe "$@"; }
cdmmbe2() { _codex_secondary cdmmbe "$@"; }
cdlbe2()  { _codex_secondary cdlbe "$@"; }

cdxr2()      { cdxr --account 2 "$@"; }

# API-key Codex account (~/.codex-api). Subshell isolation keeps account selection
# local to each invocation, with separate state under ~/.codex-state-api.
_codex_api() (
  _codex_use_api_env || return 1
  "$@"
)

cdxk() {
  if (( $# == 0 )); then
    _codex_api cdx
    return
  fi
  case "$1" in
    -*|exec|e)
      _codex_api cdx "$@"
      ;;
    *2)
      _codex_error "cdxk(): cannot combine API-key mode with secondary-account wrapper '$1'"
      return 2
      ;;
    *)
      _codex_api "$@"
      ;;
  esac
}
# --------------------------------------------------------------------

# ====================================================================
# Kimi Code wrappers
# ====================================================================

_kimi_error() {
  printf '%s\n' "$*" >&2
}

_kimi_bin() {
  local canonical_home="${KIMI_CANONICAL_HOME:-$HOME/.kimi-code}"
  local kimi_bin

  if [[ -x "${canonical_home}/bin/kimi" ]]; then
    printf '%s\n' "${canonical_home}/bin/kimi"
    return 0
  fi
  kimi_bin="$(type -P kimi)"
  if [[ -z "$kimi_bin" ]]; then
    _kimi_error "Kimi Code CLI was not found at ${canonical_home}/bin/kimi or on PATH"
    return 127
  fi
  printf '%s\n' "$kimi_bin"
}

_kimi_safe_path_segment() {
  printf '%s' "$1" | sed 's|[^A-Za-z0-9._-]|_|g'
}

_kimi_repo_key() {
  local identity label digest

  identity=$(git -C "$(pwd -P)" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || \
    identity="$(pwd -P)"
  identity=$(realpath "$identity" 2>/dev/null) || {
    _kimi_error "_kimi_repo_key(): failed to canonicalize repository identity $identity"
    return 1
  }
  if [[ "$(basename "$identity")" == ".git" ]]; then
    label=$(basename "$(dirname "$identity")")
  else
    label=$(basename "$identity")
    label="${label%.git}"
  fi
  label=$(_kimi_safe_path_segment "$label")
  [[ -n "$label" ]] || label="directory"
  digest=$(printf '%s' "$identity" | shasum -a 256 2>/dev/null) || {
    _kimi_error "_kimi_repo_key(): failed to hash repository identity $identity"
    return 1
  }
  digest="${digest%% *}"
  printf '%s-%s\n' "$label" "${digest:0:12}"
}

_kimi_check_link() {
  local source_path="$1"
  local dest_path="$2"
  local required="${3:-optional}"

  if [[ ! -e "$source_path" && ! -L "$source_path" ]]; then
    if [[ -e "$dest_path" || -L "$dest_path" ]]; then
      _kimi_error "_kimi_check_link(): destination persists after its source disappeared: $dest_path"
      return 1
    fi
    if [[ "$required" == "required" ]]; then
      _kimi_error "_kimi_check_link(): required source does not exist: $source_path"
      return 1
    fi
    return 0
  fi
  if [[ -L "$dest_path" && "$(readlink "$dest_path" 2>/dev/null)" == "$source_path" ]]; then
    return 0
  fi
  if [[ -e "$dest_path" || -L "$dest_path" ]]; then
    _kimi_error "_kimi_check_link(): refusing to replace conflicting path $dest_path"
    return 1
  fi
  mkdir -p "$(dirname "$dest_path")" || return 1
  ln -s "$source_path" "$dest_path" || {
    _kimi_error "_kimi_check_link(): failed to link $dest_path -> $source_path"
    return 1
  }
}

_kimi_lock_home() {
  local kimi_home="$1"
  local lock_dir="${kimi_home}/.kimi-launcher.lock"
  local attempt=0 owner_pid

  while ! mkdir "$lock_dir" 2>/dev/null; do
    if [[ -f "${lock_dir}/pid" ]]; then
      owner_pid=$(<"${lock_dir}/pid")
      if [[ "$owner_pid" =~ ^[1-9][0-9]*$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
        rm -f "${lock_dir}/pid"
        rmdir "$lock_dir" 2>/dev/null || true
        continue
      fi
    fi
    attempt=$((attempt + 1))
    if [[ $attempt -ge 200 ]]; then
      _kimi_error "timed out waiting for Kimi home initialization lock: $lock_dir"
      return 1
    fi
    sleep 0.05
  done
  printf '%s\n' "${BASHPID:-$$}" >"${lock_dir}/pid"
}

_kimi_unlock_home() {
  local kimi_home="$1"
  rm -f "${kimi_home}/.kimi-launcher.lock/pid"
  rmdir "${kimi_home}/.kimi-launcher.lock" 2>/dev/null || true
}

_kimi_validate_toml() {
  local config_path="$1"
  python3 -c 'import pathlib, sys, tomllib; tomllib.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' "$config_path" || {
    _kimi_error "generated Kimi configuration is invalid TOML: $config_path"
    return 1
  }
}

_kimi_write_selected_config() {
  local canonical_config="$1"
  local output_config="$2"
  local effort="$3"

  python3 - "$canonical_config" "$output_config" "$effort" <<'PY'
import json
import pathlib
import re
import sys
import tomllib


source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
effort = sys.argv[3]
if effort not in {"low", "high", "max"}:
    raise SystemExit(f"unsupported Kimi thinking effort: {effort!r}")

text = source.read_text(encoding="utf-8")
parsed = tomllib.loads(text)
thinking = parsed.get("thinking")
if not isinstance(thinking, dict) or not isinstance(thinking.get("effort"), str):
    raise SystemExit(f"canonical Kimi config has no string thinking.effort: {source}")

assignment = re.compile(
    r'^(\s*effort\s*=\s*)([^#\r\n]*?)(\s*(?:#.*)?(?:\r?\n)?)$'
)
lines = text.splitlines(keepends=True)
inside_thinking = False
changed = 0
for index, line in enumerate(lines):
    stripped = line.lstrip()
    if stripped.startswith("["):
        inside_thinking = re.fullmatch(
            r'\[thinking\]\s*(?:#.*)?(?:\r?\n)?', stripped
        ) is not None
        continue
    if not inside_thinking:
        continue
    match = assignment.fullmatch(line)
    if match is None:
        continue
    lines[index] = match.group(1) + json.dumps(effort) + match.group(3)
    changed += 1

if changed != 1:
    raise SystemExit(
        f"canonical Kimi config must contain one thinking.effort assignment: {source}"
    )
rendered = "".join(lines)
if tomllib.loads(rendered).get("thinking", {}).get("effort") != effort:
    raise SystemExit("generated Kimi thinking effort did not validate")
destination.write_text(rendered, encoding="utf-8")
PY
}

_kimi_trust_working_directory() {
  local kimi_home="$1"
  local work_dir status

  work_dir=$(pwd -P) || {
    _kimi_error "failed to resolve the current folder for Kimi trust"
    return 1
  }
  _kimi_lock_home "$kimi_home" || return 1
  if python3 - "$kimi_home" "$work_dir" <<'PY'
import hashlib
import json
import os
import pathlib
import re
import sys
import tempfile
import time


home = pathlib.Path(sys.argv[1])
root = sys.argv[2]
trust_dir = home / "workspace-trust"
if trust_dir.is_symlink() or (trust_dir.exists() and not trust_dir.is_dir()):
    raise SystemExit(f"Kimi folder-trust path is not an ordinary directory: {trust_dir}")
trust_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chmod(trust_dir, 0o700)

normalized = root.replace("\\", "/").rstrip("/")
name = normalized.rsplit("/", 1)[-1].lower()
slug = re.sub(r"[^a-z0-9._-]+", "-", name).strip("-")[:40].strip("-")
if slug in {"", ".", ".."}:
    slug = "workspace"
digest = hashlib.sha256(normalized.encode()).hexdigest()[:12]
record_path = trust_dir / f"wd_{slug}_{digest}"
if record_path.is_symlink() or (record_path.exists() and not record_path.is_file()):
    raise SystemExit(f"Kimi folder-trust record is not an ordinary file: {record_path}")
if record_path.exists():
    try:
        record = json.loads(record_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise SystemExit(f"refusing to replace malformed Kimi folder trust: {record_path}: {error}")
    if (
        not isinstance(record, dict)
        or record.get("root") != root
        or isinstance(record.get("trustedAt"), bool)
        or not isinstance(record.get("trustedAt"), int)
    ):
        raise SystemExit(f"refusing to replace unexpected Kimi folder trust: {record_path}")
    raise SystemExit(0)

record = {"root": root, "trustedAt": int(time.time() * 1000)}
handle, temp_name = tempfile.mkstemp(prefix=f".{record_path.name}.", dir=trust_dir)
try:
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        json.dump(record, stream, ensure_ascii=False, separators=(",", ":"))
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temp_name, 0o600)
    os.replace(temp_name, record_path)
finally:
    try:
        os.unlink(temp_name)
    except FileNotFoundError:
        pass
PY
  then
    status=0
  else
    status=$?
  fi
  _kimi_unlock_home "$kimi_home"
  [[ $status -eq 0 ]] || {
    _kimi_error "failed to trust the current folder for Kimi"
    return "$status"
  }
}

_kimi_append_hook_config() {
  local canonical_home="$1"
  local review_seam="${canonical_home}/hooks/review-after-commit/shell/review-after-commit.bash"
  [[ -r "$review_seam" ]] || {
    _kimi_error "review-after-commit launcher seam is not readable: $review_seam"
    return 1
  }
  # shellcheck disable=SC1090
  source "$review_seam" || return
  review_after_commit_append_kimi_config
}

_kimi_prepare_selected_home_unlocked() {
  local kimi_home="$1"
  local canonical_home="$2"
  local effort="$3"
  local hook_source="${canonical_home}/hooks/review-after-commit"
  local manager="${hook_source}/scripts/review_hook.py"
  local temp_canonical temp_config entry status

  _kimi_check_link "$hook_source" "${kimi_home}/hooks/review-after-commit" required || return 1
  for entry in credentials oauth tui.toml AGENTS.md mcp.json skills plugins bin; do
    _kimi_check_link "${canonical_home}/${entry}" "${kimi_home}/${entry}" || return 1
  done

  [[ -f "${canonical_home}/config.toml" ]] || {
    _kimi_error "canonical Kimi configuration does not exist: ${canonical_home}/config.toml"
    return 1
  }
  [[ -f "$manager" && ! -L "$manager" ]] || {
    _kimi_error "installed review-after-commit manager is unavailable: $manager"
    return 1
  }
  temp_canonical=$(mktemp "${kimi_home}/.canonical.toml.XXXXXX") || return 1
  temp_config=$(mktemp "${kimi_home}/.config.toml.XXXXXX") || {
    rm -f "$temp_canonical"
    return 1
  }
  if ! _kimi_write_selected_config \
       "${canonical_home}/config.toml" "$temp_canonical" "$effort" || \
     ! cp "$temp_canonical" "$temp_config" || \
     ! _kimi_append_hook_config "$canonical_home" >>"$temp_config" || \
     ! _kimi_validate_toml "$temp_config"; then
    rm -f "$temp_canonical" "$temp_config"
    return 1
  fi
  if /usr/bin/python3 -B "$manager" materialize-kimi-config \
       --canonical-config "$temp_canonical" \
       --selected-home "$kimi_home" \
       --desired-config "$temp_config" \
       --apply >/dev/null; then
    status=0
  else
    status=$?
  fi
  rm -f "$temp_canonical" "$temp_config"
  [[ $status -eq 0 ]] || {
    _kimi_error "failed to materialize the selected review-after-commit config"
    return "$status"
  }
}

_kimi_prepare_selected_home() {
  local canonical_home="$1"
  local state_root="$2"
  local effort="$3"
  local repo_key kimi_home status

  repo_key=$(_kimi_repo_key) || return 1
  kimi_home="${state_root}/repos/${repo_key}/review-after-commit"
  mkdir -p "$kimi_home" || return 1
  _kimi_lock_home "$kimi_home" || return 1
  _kimi_prepare_selected_home_unlocked "$kimi_home" "$canonical_home" "$effort"
  status=$?
  _kimi_unlock_home "$kimi_home"
  [[ $status -eq 0 ]] || return "$status"
  printf '%s\n' "$kimi_home"
}

_kimi_render_bare_config() {
  local canonical_config="$1"

  python3 - "$canonical_config" <<'PY'
import json
import math
import pathlib
import sys
import tomllib


config_path = pathlib.Path(sys.argv[1])
config = tomllib.loads(config_path.read_text(encoding="utf-8"))


def fail(message):
    raise SystemExit(f"canonical Kimi config {config_path}: {message}")


default_model = config.get("default_model")
if not isinstance(default_model, str) or not default_model:
    fail("default_model must be a non-empty string")

models = config.get("models")
if not isinstance(models, dict) or not isinstance(models.get(default_model), dict):
    fail(f'model {default_model!r} is not configured')
model_config = models[default_model]

provider_name = model_config.get("provider")
if not isinstance(provider_name, str) or not provider_name:
    fail(f'model {default_model!r} has no provider')
if not isinstance(model_config.get("model"), str) or not model_config["model"]:
    fail(f'model {default_model!r} has no upstream model name')
max_context_size = model_config.get("max_context_size")
if isinstance(max_context_size, bool) or not isinstance(max_context_size, int) or max_context_size <= 0:
    fail(f'model {default_model!r} has no positive max_context_size')

providers = config.get("providers")
if not isinstance(providers, dict) or not isinstance(providers.get(provider_name), dict):
    fail(f'provider {provider_name!r} for model {default_model!r} is not configured')
provider_config = providers[provider_name]
thinking_config = config.get("thinking")
if thinking_config is not None and not isinstance(thinking_config, dict):
    fail("thinking must be a table when configured")


def toml_value(value, location):
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float) and math.isfinite(value):
        return repr(value)
    if isinstance(value, list):
        return "[ " + ", ".join(
            toml_value(item, f"{location}[]") for item in value
        ) + " ]"
    fail(f"unsupported value at {location}: {type(value).__name__}")


def render_table(path, table):
    print()
    print("[" + ".".join(json.dumps(part, ensure_ascii=False) for part in path) + "]")
    nested_tables = []
    for key, value in table.items():
        if isinstance(value, dict):
            nested_tables.append((key, value))
        else:
            print(
                f"{json.dumps(key, ensure_ascii=False)} = "
                f"{toml_value(value, '.'.join((*path, key)))}"
            )
    for key, value in nested_tables:
        render_table((*path, key), value)


print(f"default_model = {json.dumps(default_model, ensure_ascii=False)}")
print('default_permission_mode = "auto"')
print("default_plan_mode = false")
print("merge_all_available_skills = false")
print("telemetry = false")
if thinking_config is not None:
    render_table(("thinking",), thinking_config)
render_table(("providers", provider_name), provider_config)
render_table(("models", default_model), model_config)
PY
}

_kimi_write_bare_config() {
  local config_path="$1"
  local with_hook="$2"
  local canonical_config="$3"

  if ! _kimi_render_bare_config "$canonical_config" >"$config_path"; then
    _kimi_error "failed to derive bare Kimi model configuration from $canonical_config"
    return 1
  fi
  if [[ "$with_hook" == "yes" ]]; then
    _kimi_append_hook_config "$(dirname "$canonical_config")" >>"$config_path"
  fi
}

_kimi_prepare_bare_home_unlocked() {
  local kimi_home="$1"
  local canonical_home="$2"
  local with_hook="$3"
  local marker="${kimi_home}/.kimi-launcher-schema"
  local checksum_file="${kimi_home}/.generated-config.sha256"
  local config_path="${kimi_home}/config.toml"
  local temp_config marker_value desired_checksum actual_checksum recorded_checksum managed_path

  for forbidden in AGENTS.md mcp.json skills plugins; do
    if [[ -e "${kimi_home}/${forbidden}" || -L "${kimi_home}/${forbidden}" ]]; then
      _kimi_error "bare Kimi home contains forbidden user customization: ${kimi_home}/${forbidden}"
      return 1
    fi
  done
  if [[ -e "${kimi_home}/empty-skills" && ! -d "${kimi_home}/empty-skills" ]] || [[ -L "${kimi_home}/empty-skills" ]]; then
    _kimi_error "bare Kimi empty-skills path is not an ordinary directory: ${kimi_home}/empty-skills"
    return 1
  fi
  mkdir -p "${kimi_home}/empty-skills" || return 1
  _kimi_check_link "${canonical_home}/credentials" "${kimi_home}/credentials" required || return 1
  _kimi_check_link "${canonical_home}/oauth" "${kimi_home}/oauth" || return 1
  if [[ "$with_hook" == "yes" ]]; then
    _kimi_check_link "${canonical_home}/hooks/review-after-commit" "${kimi_home}/hooks/review-after-commit" required || return 1
  elif [[ -e "${kimi_home}/hooks" || -L "${kimi_home}/hooks" ]]; then
    _kimi_error "plain bare Kimi home unexpectedly contains hooks: ${kimi_home}/hooks"
    return 1
  fi

  for managed_path in "$marker" "$checksum_file"; do
    if [[ -e "$managed_path" || -L "$managed_path" ]]; then
      if [[ ! -f "$managed_path" || -L "$managed_path" ]]; then
        _kimi_error "managed bare Kimi metadata is not an ordinary file: $managed_path"
        return 1
      fi
    fi
  done
  if [[ -f "$marker" ]]; then
    marker_value=$(<"$marker")
  else
    marker_value=""
  fi
  if [[ -n "$marker_value" && "$marker_value" != "1" && \
        "$marker_value" != "2" && "$marker_value" != "3" ]]; then
    _kimi_error "unsupported bare Kimi home schema '$marker_value' in $marker"
    return 1
  fi
  if [[ -e "$config_path" || -L "$config_path" ]]; then
    if [[ ! -f "$config_path" || -L "$config_path" ]]; then
      _kimi_error "managed bare Kimi config is not an ordinary file: $config_path"
      return 1
    fi
  fi
  temp_config=$(mktemp "${kimi_home}/.config.toml.XXXXXX") || return 1
  if ! _kimi_write_bare_config "$temp_config" "$with_hook" "${canonical_home}/config.toml" || \
     ! _kimi_validate_toml "$temp_config"; then
    rm -f "$temp_config"
    return 1
  fi
  desired_checksum=$(shasum -a 256 "$temp_config" 2>/dev/null) || {
    rm -f "$temp_config"
    _kimi_error "failed to checksum generated bare Kimi config: $temp_config"
    return 1
  }
  desired_checksum="${desired_checksum%% *}"

  if [[ -z "$marker_value" && -f "$config_path" ]]; then
    if [[ -f "$checksum_file" ]]; then
      actual_checksum=$(shasum -a 256 "$config_path" 2>/dev/null) || actual_checksum=""
      actual_checksum="${actual_checksum%% *}"
      recorded_checksum=$(<"$checksum_file")
    else
      actual_checksum=""
      recorded_checksum=""
    fi
    if [[ -z "$recorded_checksum" || "$actual_checksum" != "$recorded_checksum" ]]; then
      rm -f "$temp_config"
      _kimi_error "refusing to adopt unmarked bare Kimi config: $config_path"
      return 1
    fi
  fi

  printf '%s\n' "$desired_checksum" >"$checksum_file" || {
    rm -f "$temp_config"
    return 1
  }
  mv "$temp_config" "$config_path" || return 1
  printf '3\n' >"$marker"
}

_kimi_prepare_bare_home() {
  local canonical_home="$1"
  local state_root="$2"
  local variant="$3"
  local generic_agents="${HOME}/.agents/AGENTS.md"
  local bare_root repo_key kimi_home root_real home_parent_real status with_hook="no"

  if [[ -e "$generic_agents" || -L "$generic_agents" ]]; then
    _kimi_error "kimb/kimbs cannot exclude user instructions at $generic_agents; remove or relocate that entry before launching"
    return 1
  fi
  case "$variant" in
    plain|skills) ;;
    review-after-commit|skills-review-after-commit) with_hook="yes" ;;
    *)
      _kimi_error "_kimi_prepare_bare_home(): unsupported variant '$variant'"
      return 2
      ;;
  esac
  bare_root="${state_root}/bare/repos"
  mkdir -p "$bare_root" || return 1
  root_real=$(realpath "$bare_root") || return 1
  repo_key=$(_kimi_repo_key) || return 1
  kimi_home="${root_real}/${repo_key}/${variant}"
  home_parent_real=$(realpath "$(dirname "$kimi_home")" 2>/dev/null) || home_parent_real="$(dirname "$kimi_home")"
  case "${home_parent_real}/" in
    "${root_real}/"*) ;;
    *)
      _kimi_error "refusing to create bare Kimi home outside $root_real: $kimi_home"
      return 1
      ;;
  esac
  mkdir -p "$kimi_home" || return 1
  if [[ -e "${kimi_home}/AGENTS.md" || -L "${kimi_home}/AGENTS.md" ]]; then
    _kimi_error "bare Kimi home contains forbidden user instructions: ${kimi_home}/AGENTS.md"
    return 1
  fi
  _kimi_lock_home "$kimi_home" || return 1
  _kimi_prepare_bare_home_unlocked "$kimi_home" "$canonical_home" "$with_hook"
  status=$?
  _kimi_unlock_home "$kimi_home"
  [[ $status -eq 0 ]] || return "$status"
  printf '%s\n' "$kimi_home"
}

_kimi_launch() (
  local mode="$1"
  shift
  local canonical_home="${KIMI_CANONICAL_HOME:-$HOME/.kimi-code}"
  local state_root="${KIMI_STATE_ROOT:-$HOME/.kimi-code-state}"
  local print_mode="no" review_requested="no" output_format="text" native_mode="no"
  local has_auto="no" variant="plain"
  local kimi_bin kimi_home argument skills_dir review_seam
  local -A review_selection=()
  local review_forwarded=() forwarded=() launch_args=() output_args=()

  unset REVIEW_AFTER_COMMIT_MODE
  unset KIMI_HOOK_STATE_DIR
  unset KIMI_HOOK_REVIEW_AFTER_COMMIT_ENABLED
  unset KIMI_HOOK_REVIEW_AFTER_COMMIT_STANDARD_EVERY
  unset KIMI_HOOK_REVIEW_AFTER_COMMIT_BRANCH_EVERY
  for argument in "$@"; do
    case "$argument" in
      --) break ;;
      --review-mode|--review-mode=*|--review-standard-every|--review-standard-every=*|--review-branch-every|--review-branch-every=*|--hook|--hook=*|--hook-option|--hook-option=*)
        review_requested="yes"
        ;;
    esac
  done
  if [[ "$review_requested" == "yes" ]]; then
    review_seam="${canonical_home}/hooks/review-after-commit/shell/review-after-commit.bash"
    [[ -r "$review_seam" ]] || {
      _kimi_error "review-after-commit launcher seam is not readable: $review_seam"
      return 1
    }
    # shellcheck disable=SC1090
    source "$review_seam" || return
    review_after_commit_parse kimi review_selection review_forwarded "$@" || return
    set -- "${review_forwarded[@]}"
  fi
  while [[ $# -gt 0 ]]; do
    argument="$1"
    shift
    case "$argument" in
      --)
        forwarded+=(-- "$@")
        set --
        ;;
      --yolo|--yolo=*)
        _kimi_error "Kimi wrappers enforce Never Ask mode and do not accept --yolo"
        return 2
        ;;
      --auto)
        has_auto="yes"; forwarded+=("$argument")
        ;;
      -p|--prompt)
        (( $# )) || { _kimi_error "Kimi $argument requires a value"; return 2; }
        print_mode="yes"; forwarded+=("$argument" "$1"); shift
        ;;
      -p?*|--prompt=*)
        print_mode="yes"; forwarded+=("$argument")
        ;;
      --output-format)
        (( $# )) || { _kimi_error 'Kimi --output-format requires a value'; return 2; }
        output_format="$1"; shift
        output_args=(--output-format "$output_format")
        ;;
      --output-format=*)
        output_format="${argument#*=}"
        output_args=(--output-format "$output_format")
        ;;
      --skills-dir|--skills-dir=*)
        if [[ "$mode" == "bare" || "$mode" == "bare-skills" ]]; then
          _kimi_error "kimb/kimbs manage --skills-dir and do not accept a caller-supplied value"
          return 2
        fi
        forwarded+=("$argument")
        if [[ "$argument" == --skills-dir && $# -gt 0 ]]; then
          forwarded+=("$1"); shift
        fi
        ;;
      -m|--model|--agent|--agent-file|--add-dir)
        forwarded+=("$argument")
        if (( $# )); then forwarded+=("$1"); shift; fi
        ;;
      -S|--session)
        forwarded+=("$argument")
        if (( $# )) && [[ "$1" != -* ]]; then forwarded+=("$1"); shift; fi
        ;;
      -h|--help|-V|--version)
        native_mode="yes"; forwarded+=("$argument")
        ;;
      *) forwarded+=("$argument") ;;
    esac
  done

  kimi_bin=$(_kimi_bin) || return
  if [[ "$mode" == "bare" || "$mode" == "bare-skills" ]]; then
    if [[ "$mode" == "bare-skills" ]]; then
      skills_dir="${HOME}/.agents/skills"
      if [[ ! -d "$skills_dir" ]]; then
        _kimi_error "kimbs requires the skills directory to exist: $skills_dir"
        return 1
      fi
      variant="skills"
    fi
    if [[ "${review_selection[enabled]:-0}" == "1" ]]; then
      if [[ "$mode" == "bare-skills" ]]; then
        variant="skills-review-after-commit"
      else
        variant="review-after-commit"
      fi
    fi
    kimi_home=$(_kimi_prepare_bare_home "$canonical_home" "$state_root" "$variant") || return 1
    export KIMI_CODE_NO_AUTO_UPDATE=1
    export KIMI_DISABLE_TELEMETRY=1
    if [[ "$mode" == "bare-skills" ]]; then
      launch_args+=(--skills-dir "$skills_dir")
    else
      launch_args+=(--skills-dir "${kimi_home}/empty-skills")
    fi
  elif [[ "$mode" == "normal" ]]; then
    if [[ "${review_selection[enabled]:-0}" == "1" ]]; then
      kimi_home=$(_kimi_prepare_selected_home \
        "$canonical_home" "$state_root" "${KIMI_MODEL_THINKING_EFFORT:-}") || return 1
    else
      kimi_home="$canonical_home"
    fi
  else
    _kimi_error "_kimi_launch(): unsupported mode '$mode'"
    return 2
  fi

  _kimi_trust_working_directory "$kimi_home" || return 1

  if [[ "${review_selection[enabled]:-0}" == "1" ]]; then
    review_after_commit_export_environment kimi "$kimi_home" review_selection || return
  fi
  if [[ "$print_mode" != "yes" && "$has_auto" != "yes" ]]; then
    launch_args+=(--auto)
  fi
  if [[ "$print_mode" == yes && "$output_format" == text && "$native_mode" == no ]]; then
    KIMI_CODE_HOME="$kimi_home" _agent_final_print Kimi '
      [.[] | select(.role == "assistant" or .role == "tool")] | last
      | select(.role == "assistant" and ((.tool_calls // []) | length == 0)) | .content
    ' "$kimi_bin" --output-format stream-json "${launch_args[@]}" "${forwarded[@]}"
  else
    KIMI_CODE_HOME="$kimi_home" "$kimi_bin" "${output_args[@]}" "${launch_args[@]}" "${forwarded[@]}"
  fi
)

kimm() { KIMI_MODEL_THINKING_EFFORT=max _kimi_launch "normal" "$@"; }
kimh() { KIMI_MODEL_THINKING_EFFORT=high _kimi_launch "normal" "$@"; }
kiml() { KIMI_MODEL_THINKING_EFFORT=low _kimi_launch "normal" "$@"; }
kimb() { KIMI_MODEL_THINKING_EFFORT=max _kimi_launch "bare" "$@"; }
kimbs() { KIMI_MODEL_THINKING_EFFORT=max _kimi_launch "bare-skills" "$@"; }

# --------------------------------------------------------------------

# ====================================================================
# Devin wrappers
# ====================================================================
# All Devin launchers run in bypass mode (--permission-mode bypass).
# NOTE: Devin CLI has no launch-time flag/env/config for thinking level;
# Opt+T (macOS) cycles the thinking level after the session starts.
# Effort is pinned per wrapper via the model-id suffix (-medium/-high/
# -xhigh/-max); fusion ids also encode the sidekick and its effort.
_devin() {
  local devin_bin
  devin_bin="$(type -P devin)"
  if [[ -z "$devin_bin" ]]; then
    echo "devin is not on PATH" >&2
    return 127
  fi
  printf '%s\n' "$devin_bin"
}

