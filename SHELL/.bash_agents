# ---- Coding-Agent Launch Wrappers ----------------------------------
# Default to final-output-only for headless coding-agent wrappers wherever possible.
# All personal coding-agent launch wrappers live here:
#   * Claude Code: cch/ccx/ccm = Opus high/xhigh/max;
#                  ccxX/ccmM = xhigh/max with a per-launch parallel boost.
#                  ccfmm/ccfh/ccfx/ccfm = Fable medium/high/xhigh/max;
#                  csmm/cshh/csx/csm/csu = Sonnet medium/high/xhigh/max/ultracode
#                  (cshh, not csh, which is /bin/csh); bare: csbmm/csbh/csbx/csbm/csbu.
#                  chmm/chh/chx/chm/chu = Haiku medium/high/xhigh/max/ultracode;
#                  bare: chbmm/chbh/chbx/chbm/chbu.
#                  Add b after cc for bare subscription variants: ccbh/ccbx/ccbm,
#                  ccbfmm/ccbfh/ccbfx/ccbfm. These use --safe-mode to keep OAuth.
#                  Subscription wrappers use the current opus/fable aliases with
#                  [1m]; bare aliases get 200k behind a custom ANTHROPIC_BASE_URL.
#                  Existing medium/ultracode and explicit API-key (cck*) wrappers
#                  are also available; --api-key / -ak switches any Claude
#                  wrapper to API-key auth (upgrading --safe-mode to --bare), and
#                  --code-mode opts a subscription wrapper into Code Mode without
#                  Chrome/Agent Teams. Key-auth bare variants use --bare. All use
#                  _claude_bin and the shared _cc_launch base.
#   * Grok:        grokxh, grok2, grok2xh, grok3, grok3xh (plus the _grok_bin
#                  helper; "2" variants use GROK_HOME=~/.grok2 and "3" variants
#                  GROK_HOME=~/.grok3; plain `grok` is the default primary launcher)
#   * Antigravity: agg, aggbs, aggtp, aggb, aggbbs, aggbtp, agom, agoh, argm,
#                  argh, aghh, aghhb, aghx, aghxb, agcm, agcmb, agch, agchb,
#                  agnm, agnmb, agnh, agnhb, agnx, agnxb
#                  (plus _agy_bin and shared _agy_launch). All use
#                  accept-edits/YOLO mode. The "b" variants use the agy-bare
#                  agent, which omits inherited AGENTS.md, skills, rules,
#                  plugins, subagents, and MCP config.
#                  The "bs" and "tp" variants engage Boost (/boost) and
#                  Teamwork Preview (/teamwork-preview) modes respectively.
#                  Headless output is final-only, filtered from AGY's
#                  event stream by the delegate skill's agy-final-output.py.
#                  Every wrapper has a "2" twin (agg2 ... agnxb2) on the second
#                  account, run with HOME=~/.agy2 and the shared ~/.gemini/config.
#                  agk (prefix or standalone; defaults to aghh) or --api-key / -ak
#                  switches any Gemini wrapper to GEMINI_API_KEY mode
#                  (--settings '{"modelProvider":"gemini"}'; excludes agom/agoh/*2).
#   * Codex:       cdx, cdx-fresh, cdxf, cdxe, cdxe-fresh, cdxr,
#                  plus model/effort and bare variants
#                  (plus the _codex_* helpers and shared _codex_launch base)
#                  Model families: cd* = gpt-6.2-sol, cl* = gpt-6-luna,
#                  ca* = gpt-6.2-astra (astra low is cdal
#                  because `cal` collides with the calendar command).
#                  ctx/ctm = gpt-6.1-terra at xhigh/max effort.
#                  Configurable axes are home (repo/fresh/bare), output
#                  (stream/final), model, and reasoning effort. Final output
#                  uses cdxe-style last-message capture. Bare homes retain sessions
#                  but omit automatic customization context (skills are mention-only)
#                  and keep only core coding tools, external-Chrome browser use,
#                  and arXiv MCP.
#                  Every named wrapper also has a `2`-suffixed counterpart using
#                  ~/.codex2 with independent runtime state under ~/.codex-state2.
#                  cdxk (prefix or standalone) or --api-key / -ak switches any
#                  Codex wrapper to ~/.codex-api (~/.codex-state-api) API-key auth.
#                  cdxX/cdmM and caxX/camM boost subagents to 16, depth 2,
#                  matching the primary model and xhigh/max effort per launch.
#                  All Codex wrappers accept --ctx-mgmt / -cm to enable the
#                  experimental context manager
#                  (-c features.context_management.experimental_mode=true);
#                  --no-ctx-mgmt forces it off. (`-m` is left alone for
#                  codex `-m/--model`.)
#                  Stream wrappers double as headless launchers (like agg/aggb),
#                  so no per-permutation headless wrapper is needed: add a print
#                  flag or the exec subcommand and the wrapper runs cdxe-style
#                  final-only output --
#                    cdx -p "prompt" | cdx --print "prompt" | cdx exec "prompt"
#                  `-p` means print here (codex uses it for --profile), so config
#                  profiles must be spelled `--profile`. Explicit --json/-o keeps
#                  native streaming exec output; review/hook flags and exec
#                  subcommands (resume/fork/review/help) stay native-streaming.
#   * Kimi Code:   kimm, kimh, kiml, kimb, kimbs.
#                  All inherit the managed K3.1 Pro model default. kimm, kimb,
#                  and kimbs select max effort; kimh selects high, while kiml
#                  remains the explicit low-effort variant. All trust the
#                  current folder and use Never Ask mode (--auto); trusting allows
#                  project-defined MCP servers to start without an extra prompt.
#                  kimb uses a repository-scoped minimal home, while kimbs adds
#                  only ~/.agents/skills to that minimal profile.
#   * Devin:       dglm, dswe, dsweo, dargm, dargh, dnh, dnx, dfabx, dfabh,
#                  dfabmm, dfusx, dfush, dopmm, doph, dopx, dopm, dfuoh, dfuox,
#                  dfuom (plus the _devin helper)
#                  dswe = SWE-2.1 max; dsweo = legacy SWE-2 max;
#                  dargm/dargh = Gemini 4 Argon medium/high;
#                  dnh/dnx = Gemini 4 Neon high/xhigh;
#                  dfab* = Claude Fable 5.1 (x/h/mm = xhigh/high/medium);
#                  dfus* = Fusion, Fable 5.1 lead + SWE-2 high sidekick
#                  (x/h = xhigh/high lead effort);
#                  dop* = Claude Opus 5.5 (mm/h/x/m = medium/high/xhigh/max);
#                  dfuo* = Fusion, Opus 5.5 lead + SWE-2 high sidekick
#                  (h/x/m = high/xhigh/max lead effort).
#   * Command Code: cmg, cmds, cmm26p, cmqh, cmqx, cms, cm62h, cm62x, cm62mm,
#                  cmcm, cmch, cmnh, cmnx, cmhy, cmdglyph, cmdflint
#                  (plus the _cmd_bin
#                  helper and the shared _cmd_launch base). All launch in YOLO mode
#                  (--yolo); wrappers differ only in model and reasoning
#                  effort: cmg = GLM-5.3/max,
#                  cmds = DeepSeek V4.1 Flash/max,
#                  cmm26p = MiMo-V2.6-Pro (no adjustable effort),
#                  cmqh/cmqx = Qwen 4 Max high/xhigh,
#                  cms = Muse Spark 1.3 Contributor (provider-default effort),
#                  cm62h/cm62x/cm62mm = GPT-6.2 Sol high/xhigh/max,
#                  cmcm/cmch = Gemini 4 Carbon medium/high,
#                  cmnh/cmnx = Gemini 4 Neon high/xhigh,
#                  cmhy = Tencent Hy4/high,
#                  cmdglyph = Glyph Cluster free/xhigh (its highest effort),
#                  cmdflint = Flint v1.0 free (no adjustable effort).
#   * OpenCode:    ocs, ocmm26, ocargh, ocnm, ocnh, ochy, ocq4h, ocq4x, oclc, ocmf,
#                  ocnu, ocbp, ommp, ochy4flash, oclongcat, ociceman (Go/Zen),
#                  plus the direct vendor API-key
#                  family ocs62x, ocs62mm, oca62m, oca62h, oca62x, oca62mm,
#                  ocopm, ocoph, ocopx, ocopmm, ochl, ochm, ochh, ochx, ocnl,
#                  ocnx, occl, occm, occh (and the _oc_bin helper and shared
#                  _oc_launch base). All launch in YOLO mode (--auto).
#                  ocs uses the paid Muse Spark 1.3 Contributor model via
#                  opencode Go (opencode-go/muse-spark-1.3-contributor).
#                  Zen free models (provider opencode): oclc = LongCat 2.5 Preview Free,
#                  ocmf/ocmm26 = MiMo-V2.6-Flash Free,
#                  ocnu = Nemotron 3 Ultra Free,
#                  ocbp = Big Pickle. ommp = MiMo-V2.6-Pro via opencode Go
#                  (opencode-go/mimo-v2.6-pro); it declares no effort variant,
#                  so it pins none. ocargh = Gemini 4 Argon Contributor via
#                  opencode Go at high effort; ochy = Hy4 via opencode Go
#                  (opencode-go/hy4), also at high effort. ocq4h/ocq4x select
#                  Qwen4 Max via OpenCode Go at high/xhigh effort respectively.
#                  Go free / low-cost models: ochy4flash = Hy4 Flash Free
#                  (opencode-go/hy4-flash-free) at high, its highest effort;
#                  oclongcat = LongCat 2.5 (opencode-go/longcat-2.5; Go
#                  deprecated -free) and ociceman = Iceman Contributor Free
#                  (opencode-go/iceman-contributor-free) advertise no
#                  selectable variant, so they pin none.
#                  The Zen free wrappers pin no effort.
#                  Direct API-key wrappers bill the user's own vendor keys
#                  (OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY), never
#                  OpenRouter or Go/Zen.
#                  ocs62x/ocs62mm = GPT-6.2 Sol xhigh/max;
#                  oca62m/oca62h/oca62x/oca62mm = GPT-6.2 Astra medium/high/xhigh/max;
#                  ocopm/ocoph/ocopx/ocopmm = Claude Opus 5.5 medium/high/xhigh/max;
#                  ochl/ochm/ochh/ochx = Gemini 4 Hydrogen low/medium/high/xhigh;
#                  ocnl/ocnm/ocnh/ocnx = Gemini 4 Neon low/medium/high/xhigh;
#                  occl/occm/occh = Gemini 4 Carbon low/medium/high (the direct
#                  google catalog advertises no xhigh variant for Carbon).
#                  2026-11-20: ocnl was repurposed from Nemotron 3.5 Lightning
#                  Free (Zen) to Neon low, and ocnm/ocnh moved from Zen neon
#                  (opencode/gemini-4-neon) to the direct google provider.
#                  v2 notes: the interactive TUI no longer accepts --model,
#                  so _oc_launch pins the model as most-recent (_oc_pin_model)
#                  plus the variant (_oc_pin_variant) in
#                  ~/.local/state/opencode/model.json before running
#                  `opencode --auto`; headless runs use
#                  `opencode run --model provider/model#variant --auto`.
#   * Pi:          pms, par, phy, pqh, pqx, pmm, pihy4flash, pilongcat, piiceman
#                  (plus the shared _pi_launch
#                  base). No YOLO flag needed: pi has no permission prompts or
#                  sandbox by design. The lineup mirrors the opencode Go oc
#                  wrappers (same models and efforts): pms = Muse Spark 1.3
#                  Contributor/xhigh, par = Gemini 4 Argon/high, phy = Hy4/high,
#                  pqh/pqx = Qwen4 Max high/xhigh, pmm = MiMo-V2.6-Pro with no
#                  thinking level pinned (all via opencode Go).
#                  pihy4flash/pilongcat/piiceman mirror ochy4flash/oclongcat/
#                  ociceman (oc -> pi): Hy4 Flash Free/high, LongCat 2.5
#                  and Iceman Contributor Free with no thinking level pinned.
#                  POLICY: whenever an opencode Go wrapper is added or its
#                  model/effort changes, port the same model/effort to the pi
#                  lineup so the two stay in sync.
#   * Usage:       usage (Claude, Codex, Antigravity, Devin, Grok, Kimi, Command Code,
#                  Amp, OpenCode Go, and TypeSafe console spend and credit
#                  balance)
#                  -a harness[,harness...] filters providers; short aliases
#                  oc (OpenCode) and agy (Antigravity) are accepted.
#                  --records (first) prints the summary's quota windows as
#                  tab-separated lines instead of the report:
#                  window, provider, reset epoch, label, period, used%,
#                  remaining%, window seconds; and unranked, provider, label,
#                  reason. The delegate skill's pick-launcher reads them.
#                  TypeSafe reads a self-refreshing console cookie jar seeded
#                  by typesafe-login.
#   * Inventory:   agents (lists wrappers and pinned settings; filter by provider,
#                  e.g. agents --codex / agents --opencode)
# This file is sourced from .bash_functions; do not source it twice.

usage() (
  local -a providers=(claude codex antigravity devin grok kimi cmd amp opencode typesafe)
  local records=0
  if [[ "${1-}" == --records ]]; then
    records=1
    shift
  fi
  if (( $# )); then
    if [[ "$1" != -a || $# -lt 2 ]]; then
      printf 'Usage: usage [--records] [-a harness[, harness...]]\nHarnesses: %s\n' "${providers[*]}" >&2
      return 2
    fi
    shift
    # Join shell-split arguments before splitting commas, so quotes are optional.
    local requested="$*," provider candidate found
    local -a selected=()
    while [[ -n "$requested" ]]; do
      provider="${requested%%,*}"
      requested="${requested#*,}"
      provider="${provider#"${provider%%[![:space:]]*}"}"
      provider="${provider%"${provider##*[![:space:]]}"}"
      # Short harness aliases, matching the agents inventory flags.
      case "$provider" in
        agy) provider=antigravity ;;
        oc)  provider=opencode ;;
      esac
      found=0
      for candidate in "${providers[@]}"; do
        if [[ "$provider" == "$candidate" ]]; then
          found=1
          break
        fi
      done
      if (( ! found )); then
        printf 'usage: unknown or empty harness "%s"; choose from: %s\n' \
          "$provider" "${providers[*]}" >&2
        return 2
      fi
      [[ " ${selected[*]} " == *" $provider "* ]] || selected+=("$provider")
    done
    providers=("${selected[@]}")
  fi

  local usage_is_tty=0
  [[ -t 1 ]] && usage_is_tty=1
  local usage_started_pacific
  usage_started_pacific="$(TZ=America/Los_Angeles date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null)"

  _usage_compact_duration() {
    local seconds="$1" total_minutes days hours minutes

    [[ "$seconds" =~ ^[0-9]+$ ]] || return 1
    total_minutes=$(((seconds + 59) / 60))
    days=$((total_minutes / 1440))
    hours=$(((total_minutes % 1440) / 60))
    minutes=$((total_minutes % 60))
    if (( days > 0 )); then
      printf '%dd %dh' "$days" "$hours"
    elif (( hours > 0 )); then
      printf '%dh %dm' "$hours" "$minutes"
    else
      printf '%dm' "$minutes"
    fi
  }

  # Print two rate numbers for a quota window:
  #   avg = used% / elapsed <unit>s   (burn rate so far)
  #   cap = remaining% / remaining <unit>s  (max rate to land at 100% at reset)
  # Until a full unit has elapsed, show the raw usage and elapsed time instead
  # of extrapolating a tiny sample into a misleading >100%/unit average.
  # With under one <unit> left, cap balloons past the remaining budget
  # ("48%/day max" with 13% left and 6h to go), so print the leftover budget
  # and an hourly target instead. On a tty the line is bold green when
  # avg <= cap (on pace) and bold red when avg > cap (runs out early).
  # $1 used%, $2 remaining%, $3 reset_epoch, $4 window_seconds, $5 unit
  # (day|hour); $6 and $7 optionally provide more precise percentages for math.
  # $8 optionally provides indentation (defaulting to 4 spaces).
  _usage_print_daily_rates() {
    local used="$1" remaining="$2" reset_epoch="$3" window_sec="$4" unit="${5:-day}"
    local calc_used="${6:-$used}" calc_remaining="${7:-$remaining}"
    local indent="${8:-    }"
    local color_override="$9"
    local now_epoch remaining_sec elapsed_sec divisor fmt avg avg_label cap suffix
    local spent elapsed_label disp_remaining
    local verdict_color color_off

    [[ "$used" =~ ^[0-9]+([.][0-9]+)?$ &&
       "$remaining" =~ ^[0-9]+([.][0-9]+)?$ &&
       "$calc_used" =~ ^[0-9]+([.][0-9]+)?$ &&
       "$calc_remaining" =~ ^[0-9]+([.][0-9]+)?$ &&
       "$reset_epoch" =~ ^[0-9]+$ && "$window_sec" =~ ^[0-9]+$ ]] || return 1

    now_epoch="$(date +%s 2>/dev/null)"
    [[ "$now_epoch" =~ ^[0-9]+$ ]] || return 1

    remaining_sec=$(( reset_epoch - now_epoch ))
    (( remaining_sec < 0 )) && remaining_sec=0
    elapsed_sec=$(( window_sec - remaining_sec ))
    (( elapsed_sec < 0 )) && elapsed_sec=0
    (( elapsed_sec > window_sec )) && elapsed_sec="$window_sec"

    if [[ "$unit" == "hour" ]]; then
      divisor=3600; fmt=hour
    else
      divisor=86400; fmt=day
    fi

    if (( elapsed_sec > 0 )); then
      avg="$(awk -v u="$calc_used" -v e="$elapsed_sec" -v d="$divisor" \
        'BEGIN { printf "%.0f", u / (e/d) }')"
      if (( elapsed_sec < divisor )); then
        spent="$(awk -v u="$calc_used" 'BEGIN { printf "%.1f", u }')"
        spent="${spent%.0}"
        elapsed_label="$(_usage_compact_duration "$elapsed_sec")"
        avg_label="${spent}% used in first ${elapsed_label}"
      else
        avg_label="${avg}%/${fmt} avg so far"
      fi
    else
      avg=0
      avg_label="0%/${fmt} avg so far"
    fi

    # On pace when used/elapsed <= remaining/remaining_sec. Color only on a tty
    # so pipes stay clean.
    verdict_color='' color_off=''
    if [[ -t 1 || "$usage_is_tty" == 1 ]]; then
      color_off=$'\033[0m'
      if [[ -n "$color_override" ]]; then
        verdict_color="$color_override"
      elif (( remaining_sec > 0 )); then
        if (( elapsed_sec == 0 )) || awk -v u="$calc_used" -v rs="$remaining_sec" \
            -v r="$calc_remaining" -v es="$elapsed_sec" \
            'BEGIN { exit !(u * rs <= r * es) }'; then
          verdict_color=$'\033[1;32m'
        else
          verdict_color=$'\033[1;31m'
        fi
      fi
    fi

    disp_remaining="$(awk -v r="$remaining" 'BEGIN { printf "%.1f", r }')"
    disp_remaining="${disp_remaining%.0}"

    if (( remaining_sec > 0 )); then
      if (( remaining_sec < divisor )); then
        if (( remaining_sec >= 3600 )); then
          cap="$(awk -v r="$calc_remaining" -v rm="$remaining_sec" \
            'BEGIN { printf "%.0f", r / (rm/3600) }')"
          suffix=""
          (( cap > 0 )) && suffix=" (${cap}%/hour max)"
          printf '%s%s%s, %s%% left for the final %d hours%s%s\n' \
            "$verdict_color" "$indent" "$avg_label" "$disp_remaining" "$(( (remaining_sec + 1800) / 3600 ))" "$suffix" "$color_off"
        else
          printf '%s%s%s, %s%% left for the final %d minutes%s\n' \
            "$verdict_color" "$indent" "$avg_label" "$disp_remaining" "$(( (remaining_sec + 30) / 60 ))" "$color_off"
        fi
      else
        cap="$(awk -v r="$calc_remaining" -v rm="$remaining_sec" -v d="$divisor" \
          'BEGIN { printf "%.0f", r / (rm/d) }')"
        printf '%s%s%s, %s%%/%s max to stay under%s\n' \
          "$verdict_color" "$indent" "$avg_label" "$cap" "$fmt" "$color_off"
      fi
    else
      printf '%s%s%s, resets now%s\n' "$verdict_color" "$indent" "$avg_label" "$color_off"
    fi
  }

  # 20-cell usage bar for a 0-100 percentage: [████████████░░░░░░░░]
  _usage_bar() {
    local raw_pct="$1" pct fill_cells fill empty
    [[ "$raw_pct" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    pct="$(awk -v p="$raw_pct" \
      'BEGIN { if (p < 0) p = 0; if (p > 100) p = 100; printf "%.0f", p }')"
    fill_cells=$(( (pct * 20 + 50) / 100 ))
    printf -v fill '%*s' "$fill_cells" ''
    printf -v empty '%*s' "$(( 20 - fill_cells ))" ''
    printf '[%s%s]' "${fill// /█}" "${empty// /░}"
  }

  # Section banner: ── Title ───... padded to 76 columns.
  _usage_section_header() {
    local title="$1" rule
    printf -v rule '%*s' "$(( 72 - ${#title} ))" ''
    printf '── %s %s\n' "$title" "${rule// /─}"
  }

  # Save a quota window for the ranked summary printed after all
  # provider sections. Each record is sortable by its leading reset epoch.
  _usage_rank_add() {
    local rank_file="$1" label="$2" period="$3" used="$4" remaining="$5"
    local reset_epoch="$6" window_sec="$7"

    case "$period" in
      weekly|monthly|daily|5h) ;;
      *) return 0 ;;
    esac
    [[ "$used" =~ ^[0-9]+([.][0-9]+)?$ &&
       "$remaining" =~ ^[0-9]+([.][0-9]+)?$ &&
       "$reset_epoch" =~ ^[0-9]+$ && "$window_sec" =~ ^[0-9]+$ ]] || return 0
    awk -v u="$used" -v r="$remaining" -v w="$window_sec" \
      'BEGIN { exit !(u >= 0 && r >= 0 && w > 0) }' || return 0

    label="${label//$'\t'/ }"
    label="${label//$'\n'/ }"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$reset_epoch" "$label" "$period" "$used" "$remaining" "$window_sec" >> "$rank_file"
  }

  _usage_banked_reset_add() {
    local rank_file="$1" label="$2" count="$3" expires_epoch="$4"
    [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 )) || return 0
    [[ "$expires_epoch" == '-' || "$expires_epoch" =~ ^[0-9]+$ ]] || return 1
    printf '%s\t%s\t%s\n' "$label" "$count" "$expires_epoch" >> "${rank_file%.rank}.resets"
  }

  # One ranked section: two lines per credit so used/left and time-to-reset pop,
  # with the pace math collapsed to one compact rate line. Full rate detail
  # stays in each provider section above. Entries arrive as arguments and are
  # sorted by reset time.
  _usage_print_ranked_section() {
    local title="$1"; shift
    local reset_epoch label period used remaining window_sec
    local now_epoch remaining_sec elapsed_sec divisor unit
    local countdown target actual comparison rank=0
    local elapsed_label spent expiry_color pace_color budget_color
    local disp_used disp_remaining used_rounded
    local bar budget_line
    local bold dim red yellow green cyan color_off

    bold='' dim='' red='' yellow='' green='' cyan='' color_off=''
    if [[ -t 1 || "$usage_is_tty" == 1 ]]; then
      bold=$'\033[1m'
      dim=$'\033[2m'
      red=$'\033[1;31m'
      yellow=$'\033[1;33m'
      green=$'\033[1;32m'
      cyan=$'\033[1;36m'
      color_off=$'\033[0m'
    fi

    printf '\n'
    _usage_section_header "$title"
    if [[ -n "$usage_started_pacific" ]]; then
      printf '  %susage run %s%s\n' "$bold" "$usage_started_pacific" "$color_off"
    fi
    if (( $# == 0 )); then
      echo '  unavailable (no quota-window expiration data)'
      return
    fi

    printf '  %sBar = used%% · target = remaining / time left · pace = used / elapsed time.%s\n' \
      "$dim" "$color_off"
    now_epoch="$(date +%s 2>/dev/null)"
    [[ "$now_epoch" =~ ^[0-9]+$ ]] || now_epoch=0

    while IFS=$'\t' read -r reset_epoch label period used remaining window_sec; do
      ((rank += 1))
      remaining_sec=$((reset_epoch - now_epoch))
      (( remaining_sec < 0 )) && remaining_sec=0
      countdown="$(_usage_compact_duration "$remaining_sec")"
      if (( remaining_sec < 86400 )); then
        expiry_color="$red"
      elif (( remaining_sec < 259200 )); then
        expiry_color="$yellow"
      else
        expiry_color=''
      fi

      disp_used="$(awk -v u="$used" 'BEGIN { printf "%.1f", u }')"
      disp_used="${disp_used%.0}"
      disp_remaining="$(awk -v r="$remaining" 'BEGIN { printf "%.1f", r }')"
      disp_remaining="${disp_remaining%.0}"
      used_rounded="$(awk -v u="$used" 'BEGIN { printf "%.0f", u }')"
      if (( used_rounded >= 80 )); then
        budget_color="$red"
      elif (( used_rounded >= 50 )); then
        budget_color="$yellow"
      else
        budget_color="$green"
      fi
      bar="$(_usage_bar "$used")"

      # Line 1: identity + the budget numbers people scan for + urgency.
      if (( remaining_sec == 0 )); then
        printf '  %s%2d.%s %s %s[%s]%s · %s%s%% used%s · %s%s%% left%s · %sreset due now%s\n' \
          "$bold" "$rank" "$color_off" "$label" \
          "$dim" "$period" "$color_off" \
          "$budget_color" "$disp_used" "$color_off" \
          "$budget_color" "$disp_remaining" "$color_off" \
          "$red" "$color_off"
        printf '     %s%s%s\n' "$budget_color" "$bar" "$color_off"
        continue
      fi

      printf '  %s%2d.%s %s %s[%s]%s · %s%s%% used%s · %s%s%% left%s · resets in %s%s%s\n' \
        "$bold" "$rank" "$color_off" "$label" \
        "$dim" "$period" "$color_off" \
        "$budget_color" "$disp_used" "$color_off" \
        "$budget_color" "$disp_remaining" "$color_off" \
        "$expiry_color" "$countdown" "$color_off"

      elapsed_sec=$((window_sec - remaining_sec))
      (( elapsed_sec < 0 )) && elapsed_sec=0
      (( elapsed_sec > window_sec )) && elapsed_sec="$window_sec"
      if (( remaining_sec < 86400 )); then
        divisor=3600
        unit=hour
      else
        divisor=86400
        unit=day
      fi
      target="$(awk -v r="$remaining" -v s="$remaining_sec" -v d="$divisor" \
        'BEGIN { printf "%.1f", r / (s/d) }')"

      # Line 2: bar + one compact pace sentence (full rates stay per-provider).
      if (( elapsed_sec == 0 )); then
        budget_line="$(printf '%starget %s%%/%s%s · %sno elapsed-period baseline yet%s' \
          "$cyan" "$target" "$unit" "$color_off" "$dim" "$color_off")"
        printf '     %s%s%s %s\n' "$budget_color" "$bar" "$color_off" "$budget_line"
        continue
      fi

      comparison="$(awk -v r="$remaining" -v rs="$remaining_sec" \
        -v u="$used" -v es="$elapsed_sec" 'BEGIN {
        if (u <= 0) {
          printf "start at target"
        } else {
          ratio = (r * es) / (u * rs)
          if (ratio > 1.05) {
            printf "%.1f× needed", ratio
          } else if (ratio < 0.95) {
            printf "ease to %.1f×", ratio
          } else {
            printf "on pace"
          }
        }
      }')"
      if [[ "$comparison" == 'on pace' ]]; then
        pace_color="$green"
      else
        pace_color="$yellow"
      fi

      if (( elapsed_sec < divisor )); then
        spent="$(awk -v u="$used" 'BEGIN { printf "%.1f", u }')"
        spent="${spent%.0}"
        elapsed_label="$(_usage_compact_duration "$elapsed_sec")"
        budget_line="$(printf '%starget %s%%/%s%s · %s%% used in first %s · %s%s%s' \
          "$cyan" "$target" "$unit" "$color_off" \
          "$spent" "$elapsed_label" "$pace_color" "$comparison" "$color_off")"
      else
        actual="$(awk -v u="$used" -v s="$elapsed_sec" -v d="$divisor" \
          'BEGIN { printf "%.1f", u / (s/d) }')"
        budget_line="$(printf '%starget %s%%/%s%s · pace %s%%/%s · %s%s%s' \
          "$cyan" "$target" "$unit" "$color_off" \
          "$actual" "$unit" "$pace_color" "$comparison" "$color_off")"
      fi
      printf '     %s%s%s %s\n' "$budget_color" "$bar" "$color_off" "$budget_line"
    done < <(printf '%s\n' "$@" | LC_ALL=C sort -t $'\t' -k1,1n -k2,2)
  }

  # Summary split: five-hour windows cycle several times a day and run on a
  # different rhythm than the weekly/monthly budgets, so they lead in their own
  # section and the main ranked section covers the rest.
  _usage_print_ranked_expirations() {
    local entry fields period now_epoch
    local -a five_rankings=() window_rankings=()
    for entry in "${usage_rankings[@]}"; do
      fields="${entry#*$'\t'}"
      fields="${fields#*$'\t'}"
      period="${fields%%$'\t'*}"
      if [[ "$period" == 5h ]]; then
        five_rankings+=("$entry")
      else
        window_rankings+=("$entry")
      fi
    done

    if (( ${#five_rankings[@]} )); then
      _usage_print_ranked_section '5-hour limits' "${five_rankings[@]}"
    fi
    _usage_print_ranked_section 'Credits expiring soonest' "${window_rankings[@]}"

    if (( ${#usage_api_credits[@]} )); then
      local api_expires api_remaining api_granted api_expiry_label api_seconds
      now_epoch="$(date +%s)"
      printf '  API promotional credits (separate from subscription limits):\n'
      while IFS=$'\t' read -r api_expires api_remaining api_granted; do
        awk -v r="$api_remaining" -v g="$api_granted" \
          'BEGIN { printf "    Claude API: $%.2f / $%.2f remaining", r / 100, g / 100 }'
        if [[ "$api_expires" == '-' ]]; then
          printf ' · expiry unavailable\n'
          continue
        fi
        api_expiry_label="$(TZ=America/Los_Angeles date -r "$api_expires" '+%Y-%m-%d %H:%M %Z')"
        api_seconds=$((api_expires - now_epoch))
        (( api_seconds < 0 )) && api_seconds=0
        printf ' · expires %s · %s left\n' "$api_expiry_label" \
          "$(_usage_compact_duration "$api_seconds")"
      done < <(printf '%s\n' "${usage_api_credits[@]}" | LC_ALL=C sort -t $'\t' -k1,1n)
    fi

    if (( ${#usage_banked_resets[@]} )); then
      local reset_count expires_epoch expires_pacific remaining_minutes
      now_epoch="$(date +%s)"
      printf '  Banked resets (manual use):\n'
      while IFS=$'\t' read -r label reset_count expires_epoch; do
        printf '    %s: %s available' "$label" "$reset_count"
        if [[ "$expires_epoch" == '-' ]]; then
          printf ' · expiry unavailable\n'
          continue
        fi
        expires_pacific="$(TZ=America/Los_Angeles date -r "$expires_epoch" '+%Y-%m-%d %H:%M %Z')"
        remaining_sec=$((expires_epoch - now_epoch))
        (( remaining_sec < 0 )) && remaining_sec=0
        remaining_minutes=$(((remaining_sec + 59) / 60))
        printf ' · next expires %s · %d hours and %d minutes left\n' \
          "$expires_pacific" "$((remaining_minutes / 60))" "$((remaining_minutes % 60))"
      done < <(printf '%s\n' "${usage_banked_resets[@]}" | LC_ALL=C sort)
    fi

    # Providers that yielded no rankable window at all (failed quota
    # queries, idle windows without a scheduled reset) are named here so the
    # summary still accounts for them.
    if (( ${#usage_norank[@]} )); then
      printf '  Windows without expiration data:\n'
      local norank_line norank_label norank_reason
      for norank_line in "${usage_norank[@]}"; do
        norank_label="${norank_line%%$'\t'*}"
        norank_reason="${norank_line#*$'\t'}"
        printf '    %s: %s\n' "$norank_label" "$norank_reason"
      done
    fi
  }

  _usage_print_reset_countdown() {
    local now_epoch remaining_minutes

    if [[ ! $1 =~ ^[0-9]+$ ]]; then
      return 1
    fi
    now_epoch="$(date +%s 2>/dev/null)"
    if [[ ! $now_epoch =~ ^[0-9]+$ ]]; then
      return 1
    fi

    if (( $1 <= now_epoch )); then
      remaining_minutes=0
    else
      remaining_minutes=$((($1 - now_epoch + 59) / 60))
    fi
    printf '    %d hours and %d minutes until reset\n' \
      "$((remaining_minutes / 60))" "$((remaining_minutes % 60))"
  }

  _usage_fetch_claude_api_credits() {
    set +x
    local rank_file="$1" jar org response code rows now_epoch total
    jar="${CLAUDE_CONSOLE_COOKIE_JAR:-${XDG_CACHE_HOME:-$HOME/.cache}/agent-usage/claude-console-cookies.txt}"
    if [[ ! -r "$jar" ]]; then
      echo '  API promotional credits: unavailable (run claude-console-login to import a Console session)'
      return 0
    fi
    org="$(awk -F '\t' '$6 == "lastActiveOrg" && ($1 == "platform.claude.com" ||
      $1 == "#HttpOnly_platform.claude.com") { print $7 }' "$jar")"
    if [[ ! "$org" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      echo '  API promotional credits: unavailable (Console organization missing or invalid; rerun claude-console-login)'
      return 1
    fi
    if ! response="$(curl -q -s --max-time 15 -b "$jar" --write-out '\n%{http_code}' \
        -H 'Accept: application/json' \
        "https://platform.claude.com/api/organizations/$org/prepaid/credits" 2>/dev/null)"; then
      echo '  API promotional credits: unavailable (Console request failed; network/timeout)'
      return 1
    fi
    code="${response##*$'\n'}"
    response="${response%$'\n'*}"
    if [[ "$code" != 200 ]]; then
      printf '  API promotional credits: unavailable (Console HTTP %s; rerun claude-console-login if session expired)\n' "$code"
      return 1
    fi
    now_epoch="$(date +%s)" || return 1
    rows="$(jq -er --argjson now "$now_epoch" '
      def iso_epoch:
        if . == null then "-"
        else sub("\\.[0-9]+(Z|\\+00:00)$"; "Z")
          | sub("\\+00:00$"; "Z") | fromdateiso8601 | floor end;
      if (.promo_tranches | type) != "array" then error("missing promotional grants") else . end
      | [.promo_tranches[]
          | if .scope == null then .
            elif .scope.kind == "scoped" and (.scope.applies_to | type) == "array" then
              select(any(.scope.applies_to[]; .product == null or .product == "api"))
            else error("unsupported promotional scope") end
          | if (.granted_amount_minor_units | type) != "number"
              or (.remaining_amount_minor_units | type) != "number"
              or .granted_amount_minor_units <= 0 or .remaining_amount_minor_units < 0
              or .remaining_amount_minor_units > .granted_amount_minor_units
              or (.granted_amount_minor_units | floor) != .granted_amount_minor_units
              or (.remaining_amount_minor_units | floor) != .remaining_amount_minor_units
              or ((.currency | ascii_downcase) != "usd") then error("invalid grant") else . end
          | (.expires_at | iso_epoch) as $expiry
          | select($expiry == "-" or $expiry > $now)
          | [$expiry, .remaining_amount_minor_units, .granted_amount_minor_units] | @tsv]
      | join("\n")' <<<"$response" 2>/dev/null)" || {
      echo '  API promotional credits: unavailable (could not parse Console promotional grants)'
      return 1
    }
    if [[ -z "$rows" ]]; then
      echo '  API promotional credits: none active'
      return 0
    fi
    printf '%s\n' "$rows" >"${rank_file%.rank}.api-credits"
    total="$(awk -F '\t' '{ total += $2 } END { printf "%.2f", total / 100 }' <<<"$rows")"
    printf '  API promotional credits: $%s remaining (amounts and expiry below)\n' "$total"
  }

  _usage_fetch_claude() {
    # Credentials stay in this worker and curl's stdin, never command arguments.
    set +x
    local rank_file="$1"
    local config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    local credentials token expires_at has_refresh response="" http_status="" rows=""
    local label used remaining reset_epoch window_sec reset_pacific unit
    local ranked_weekly=0 reason="" api_status=0
    local now_epoch backoff_until=0 retry_after backoff_pacific cooldown_note
    local header_tmp="${rank_file%.rank}.headers" cache_tmp
    local cred_store="" cred_blob="" renew_reason=""
    local ua_version banked_rows banked_count banked_expires
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-usage"
    local backoff_file="$cache_dir/claude-backoff"
    local recovery_file="$cache_dir/claude-renewed-credentials.json"
    # Claude Code's own public OAuth client and token endpoint.
    local oauth_client=9d1c250a-e61b-44d9-88ed-5944d1962f5e
    local oauth_token_url=https://platform.claude.com/v1/oauth/token

    now_epoch="$(date +%s)" || return 1

    _usage_claude_norank() {
      printf 'Claude\t%s\n' "$1" >"${rank_file%.rank}.norank"
    }

    # Validate the live response before rendering any quota windows.
    _usage_claude_rows() {
      jq -er '
      def iso_epoch:
        if . == null then "-"
        else sub("\\.[0-9]+(Z|\\+00:00)$"; "Z")
          | sub("\\+00:00$"; "Z") | fromdateiso8601 | floor
        end;
      def scope_name:
        if type == "object" then (.display_name // .id // "")
        elif type == "string" then . else "" end;
      (if (.limits | type) == "array" and (.limits | length) > 0 then
        [.limits[] | select(.group == "session" or .group == "weekly")
          | {label: ((if .group == "session" then "5h" else "Weekly" end)
              + ([.scope.model, .scope.surface] | map(scope_name)
                | map(select(length > 0)) | join(" / ")
                | if length > 0 then " (" + . + ")" else "" end)),
             used: .percent, reset: .resets_at,
             window: (if .group == "session" then 18000 else 604800 end)}]
      else
        [to_entries[]
          | select(.key == "five_hour" or (.key | startswith("seven_day")))
          | select((.value | type) == "object" and (.value | has("utilization")))
          | {label: (if .key == "five_hour" then "5h"
                     elif .key == "seven_day" then "Weekly"
                     else "Weekly (" + (.key | ltrimstr("seven_day_")
                       | {opus:"Opus", sonnet:"Sonnet", fable:"Fable",
                          oauth_apps:"OAuth apps", cowork:"Cowork"}[.] // .) + ")" end),
             used: .value.utilization, reset: .value.resets_at,
             window: (if .key == "five_hour" then 18000 else 604800 end)}]
      end)
      | if length == 0 then error("no quota windows") else . end
      | .[]
      | if (.used | type) != "number" or .used < 0 then error("invalid usage") else . end
      | [(.label | gsub("[[:cntrl:]]"; " ")),
         .used, ([0, 100 - .used] | max), (.reset | iso_epoch), .window]
      | @tsv
    ' <<<"$1" 2>/dev/null
    }

    # Reads the stored credential into cred_blob and records which store it came
    # from, so a renewed credential is written back to exactly that store. The
    # result is not printed: command substitution would lose cred_store.
    _usage_claude_read_credentials() {
      cred_store=""
      cred_blob=""
      if [[ "$config_dir" == "$HOME/.claude" ]] && type -P security >/dev/null 2>&1; then
        cred_blob="$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null)"
        [[ -n "$cred_blob" ]] && cred_store=keychain
      fi
      if [[ -z "$cred_blob" && -r "$config_dir/.credentials.json" ]]; then
        cred_blob="$(cat "$config_dir/.credentials.json" 2>/dev/null)"
        [[ -n "$cred_blob" ]] && cred_store=file
      fi
    }

    # Stores a renewed credential in the store it came from. A rotated refresh
    # token that cannot be stored ends the login, so a failed write leaves a
    # mode-600 recovery copy rather than dropping it.
    _usage_claude_store_credentials() {
      local blob="$1" acct="" tmp hex
      if [[ "$cred_store" == keychain ]]; then
        acct="$(security find-generic-password -s 'Claude Code-credentials' 2>/dev/null |
          awk -F '"' '/"acct"<blob>=/ { print $4; exit }')"
        [[ -n "$acct" ]] || acct="$USER"
        # Hex-encoded, as Claude Code's own writer does: the -w prompt silently
        # truncates the value at 128 bytes, and security refuses more than 4032
        # hex characters. Feeding the command to security -i instead of running
        # it directly keeps the credential out of the process arguments. The
        # write is read back, because a half-written credential ends the login.
        hex="$(printf '%s' "$blob" | xxd -p 2>/dev/null | tr -d '\n')"
        if [[ "$hex" =~ ^[0-9a-f]+$ ]] && (( ${#hex} <= 4032 )) &&
            printf 'add-generic-password -U -a "%s" -s "Claude Code-credentials" -X %s\n' \
              "$acct" "$hex" | security -i >/dev/null 2>&1 &&
            [[ "$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null)" \
               == "$blob" ]]; then
          return 0
        fi
      elif [[ "$cred_store" == file ]]; then
        tmp="$(mktemp "$config_dir/.credentials.json.XXXXXX" 2>/dev/null)"
        if [[ -n "$tmp" ]] && printf '%s\n' "$blob" >"$tmp" 2>/dev/null &&
            chmod 600 "$tmp" 2>/dev/null &&
            mv -f "$tmp" "$config_dir/.credentials.json" 2>/dev/null; then
          return 0
        fi
        [[ -n "$tmp" ]] && rm -f "$tmp"
      fi
      mkdir -p "$cache_dir" 2>/dev/null
      tmp="$(mktemp "$cache_dir/.claude-renewed.XXXXXX" 2>/dev/null)"
      if [[ -n "$tmp" ]] && printf '%s\n' "$blob" >"$tmp" 2>/dev/null &&
          chmod 600 "$tmp" 2>/dev/null && mv -f "$tmp" "$recovery_file" 2>/dev/null; then
        renew_reason="renewed credential could not be stored; recover it from $recovery_file"
      else
        [[ -n "$tmp" ]] && rm -f "$tmp"
        renew_reason='renewed credential could not be stored; run claude auth login'
      fi
      return 1
    }

    # Exchanges the stored refresh token for a fresh access token, exactly as
    # Claude Code does. No model request and no metered usage.
    _usage_claude_renew() {
      local blob refresh renew_response renew_status renewed merged ua_version
      local renew_now expiry
      _usage_claude_read_credentials
      blob="$cred_blob"
      cred_blob=""
      expiry="$(jq -r '.claudeAiOauth.expiresAt |
        if type == "number" and . >= 0 then floor else "invalid" end' <<<"$blob" 2>/dev/null)"
      # Claude Code may have renewed the credential since this run started.
      if [[ "$expiry" =~ ^[0-9]+$ ]] && (( expiry > $(date +%s) * 1000 )); then
        token="$(jq -r '.claudeAiOauth.accessToken // empty' <<<"$blob" 2>/dev/null)"
        [[ -n "$token" ]] && return 0
      fi
      refresh="$(jq -r '.claudeAiOauth.refreshToken // empty' <<<"$blob" 2>/dev/null)"
      if [[ -z "$refresh" ]]; then
        renew_reason='access token expired and no refresh token is stored; run claude auth login'
        return 1
      fi
      # The endpoint rejects unrecognised clients, so identify as Claude Code.
      ua_version="$(claude --version 2>/dev/null | awk '{ print $1 }')"
      [[ "$ua_version" =~ ^[0-9]+(\.[0-9]+)*$ ]] || ua_version=2.1.278
      renew_response="$(curl -q -s --max-time 15 -X POST \
        -H 'Content-Type: application/json' \
        -H "User-Agent: claude-cli/$ua_version (external, cli)" \
        -H 'anthropic-beta: oauth-2025-04-20' \
        --data-binary @<(jq -n --arg t "$refresh" --arg c "$oauth_client" \
          '{grant_type: "refresh_token", refresh_token: $t, client_id: $c}') \
        --write-out '\n%{http_code}' "$oauth_token_url" 2>/dev/null)" || {
        renew_reason='access token expired and its renewal request failed (network/timeout)'
        return 1
      }
      renew_status="${renew_response##*$'\n'}"
      renew_response="${renew_response%$'\n'*}"
      if [[ "$renew_status" != 200 ]]; then
        renew_reason="access token expired and its renewal was refused (HTTP $renew_status)"
        [[ "$renew_status" == 400 || "$renew_status" == 401 ]] &&
          renew_reason+='; run claude auth login'
        return 1
      fi
      renew_now="$(date +%s)" || return 1
      renewed="$(jq -ec --argjson now "$(( renew_now * 1000 ))" '
        if (.access_token | type) == "string" and (.access_token | length) > 0
            and (.expires_in | type) == "number" and .expires_in > 0 then
          {accessToken: .access_token,
           expiresAt: ($now + (.expires_in * 1000 | floor)),
           refreshToken: (if (.refresh_token | type) == "string" then .refresh_token else null end),
           refreshTokenExpiresAt: (if (.refresh_token_expires_in | type) == "number"
             then ($now + (.refresh_token_expires_in * 1000 | floor)) else null end),
           scopes: (if (.scope | type) == "string" then (.scope | split(" ")) else null end)}
          | with_entries(select(.value != null))
        else error("incomplete token response") end' <<<"$renew_response" 2>/dev/null)" || {
        renew_reason='access token expired and its renewal response was incomplete'
        return 1
      }
      merged="$(jq -c --argjson renewed "$renewed" \
        '.claudeAiOauth = ((.claudeAiOauth // {}) + $renewed)' <<<"$blob" 2>/dev/null)" || {
        renew_reason='access token expired and its renewal could not be merged'
        return 1
      }
      _usage_claude_store_credentials "$merged" || return 1
      token="$(jq -r '.claudeAiOauth.accessToken' <<<"$merged" 2>/dev/null)"
      [[ -n "$token" ]]
    }

    # Claude Code serialises credential writes with this lock; honouring it
    # keeps a renewal here from racing a renewal there.
    _usage_claude_renew_locked() {
      local lock="$config_dir/.storage-write.lock" lock_epoch status
      mkdir -p "$config_dir" 2>/dev/null
      if ! mkdir "$lock" 2>/dev/null; then
        lock_epoch="$(stat -f %m "$lock" 2>/dev/null)"
        # proper-lockfile, which Claude Code uses, treats 15s without an update
        # as stale; anything older than that is a crashed holder.
        if [[ "$lock_epoch" =~ ^[0-9]+$ ]] && (( $(date +%s) - lock_epoch > 15 )); then
          rmdir "$lock" 2>/dev/null
        fi
        if ! mkdir "$lock" 2>/dev/null; then
          renew_reason='access token expired; another process is updating the credential'
          return 1
        fi
      fi
      _usage_claude_renew
      status=$?
      rmdir "$lock" 2>/dev/null
      return "$status"
    }

    _usage_section_header Claude
    _usage_fetch_claude_api_credits "$rank_file" || api_status=1
    _usage_claude_read_credentials
    credentials="$cred_blob"
    cred_blob=""
    token="$(jq -r '.claudeAiOauth.accessToken // empty' <<<"$credentials" 2>/dev/null)"
    expires_at="$(jq -r '.claudeAiOauth.expiresAt |
      if . == null then "unknown"
      elif type == "number" and . >= 0 then floor else "invalid" end
    ' <<<"$credentials" 2>/dev/null)"
    has_refresh="$(jq -r '.claudeAiOauth.refreshToken | type == "string" and length > 0' \
      <<<"$credentials" 2>/dev/null)"
    unset credentials
    if [[ ! "$token" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
      unset token
      echo '  unavailable (no Claude subscription login; run claude auth login)'
      _usage_claude_norank 'no subscription login; run claude auth login'
      return 1
    fi

    # Renew only once the stored token is certainly past its expiry: a live
    # token is never rotated, so a working Claude Code login is never disturbed.
    if [[ "$expires_at" =~ ^[0-9]+$ ]] && (( expires_at <= now_epoch * 1000 )); then
      if [[ "$has_refresh" != true ]]; then
        reason='access token expired and no refresh token is stored; run claude auth login'
      elif [[ "${USAGE_CLAUDE_RENEW:-1}" != 1 ]]; then
        reason='access token expired; renewal disabled by USAGE_CLAUDE_RENEW'
      elif _usage_claude_renew_locked; then
        echo '  (renewed the expired access token)'
      else
        reason="$renew_reason"
      fi
    elif [[ "$expires_at" != unknown && ! "$expires_at" =~ ^[0-9]+$ ]]; then
      reason='invalid stored access-token expiry; open Claude Code to check authentication'
    fi

    if [[ -z "$reason" && -r "$backoff_file" ]]; then
      backoff_until="$(cat "$backoff_file" 2>/dev/null)"
      if [[ "$backoff_until" =~ ^[0-9]+$ ]] && (( backoff_until > now_epoch )); then
        backoff_pacific="$(TZ=America/Los_Angeles date -r "$backoff_until" '+%Y-%m-%d %H:%M:%S %Z')"
        reason="local cooldown after an earlier HTTP 429; no request sent; retry after $backoff_pacific"
      fi
    fi

    if [[ -z "$reason" ]]; then
      ua_version="$(claude --version 2>/dev/null | awk '{ print $1 }')"
      [[ "$ua_version" =~ ^[0-9]+(\.[0-9]+)*$ ]] || ua_version=2.1.278
      # One request only: the first 429 determines the cooldown, never a retry.
      if response="$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
          curl -q -s --max-time 15 --config - -D "$header_tmp" --write-out '\n%{http_code}' \
            -H 'anthropic-beta: oauth-2025-04-20' -H 'Accept: application/json' \
            -H "User-Agent: claude-cli/$ua_version (external, cli)" \
            'https://api.anthropic.com/api/oauth/usage?cedar_ember=1&skip_spend=1' 2>/dev/null)"; then
        http_status="${response##*$'\n'}"
        response="${response%$'\n'*}"
        now_epoch="$(date +%s)" || return 1
        case "$http_status" in
          200)
            if ! rows="$(_usage_claude_rows "$response")"; then
              reason='could not parse Claude usage limits'
            fi
            ;;
          401)
            reason='access token rejected (HTTP 401)'
            if [[ "$has_refresh" == true ]]; then
              reason+='; open Claude Code to refresh/check authentication'
            else
              reason+='; no refresh token is stored; run claude auth login'
            fi
            ;;
          403)
            reason='usage endpoint access denied (HTTP 403)'
            ;;
          429)
            retry_after="$(awk 'tolower($1) == "retry-after:" {
              sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); value=$0
            } END { print value }' "$header_tmp" 2>/dev/null)"
            backoff_until=0
            cooldown_note='server Retry-After'
            if [[ "$retry_after" =~ ^[0-9]+$ ]]; then
              backoff_until="$(awk -v now="$now_epoch" -v delay="$retry_after" \
                'BEGIN { printf "%.0f", now + delay }')"
            elif [[ -n "$retry_after" ]]; then
              backoff_until="$(LC_ALL=C date -j -u -f '%a, %d %b %Y %H:%M:%S GMT' \
                "$retry_after" '+%s' 2>/dev/null)"
            fi
            if [[ ! "$backoff_until" =~ ^[0-9]+$ ]] || (( backoff_until <= now_epoch )); then
              backoff_until=$(( now_epoch + 900 ))
              cooldown_note='15-minute fallback cooldown; no usable Retry-After'
            fi
            mkdir -p "$cache_dir" 2>/dev/null
            cache_tmp="$(mktemp "$cache_dir/.claude-backoff.XXXXXX" 2>/dev/null)"
            if [[ -n "$cache_tmp" ]]; then
              printf '%s\n' "$backoff_until" >"$cache_tmp" &&
                mv -f "$cache_tmp" "$backoff_file" 2>/dev/null || rm -f "$cache_tmp"
            fi
            backoff_pacific="$(TZ=America/Los_Angeles date -r "$backoff_until" '+%Y-%m-%d %H:%M:%S %Z')"
            reason="usage endpoint rate limited (HTTP 429); retry after $backoff_pacific ($cooldown_note)"
            ;;
          5[0-9][0-9]) reason="usage endpoint returned an error (HTTP $http_status)" ;;
          *) reason="usage endpoint returned an error (HTTP $http_status)" ;;
        esac
      else
        reason='usage request failed (network/timeout)'
      fi
      rm -f "$header_tmp"
    fi
    unset token

    if [[ -n "$reason" ]]; then
      printf '  unavailable (%s)\n' "$reason"
      _usage_claude_norank "$reason"
      return 1
    fi

    while IFS=$'\t' read -r label used remaining reset_epoch window_sec; do
      printf '  %s: %s %s%% used, %s%% remaining' \
        "$label" "$(_usage_bar "$used")" "$used" "$remaining"
      if [[ "$reset_epoch" == '-' ]]; then
        printf '; reset not scheduled\n'
        continue
      fi
      reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
      printf '; resets %s\n' "$reset_pacific"
      _usage_print_reset_countdown "$reset_epoch"
      unit=hour
      if (( window_sec == 604800 )); then
        unit=day
        _usage_rank_add "$rank_file" "Claude · $label" weekly \
          "$used" "$remaining" "$reset_epoch" "$window_sec"
        ranked_weekly=$((ranked_weekly + 1))
      else
        _usage_rank_add "$rank_file" "Claude · $label" 5h \
          "$used" "$remaining" "$reset_epoch" "$window_sec"
      fi
      _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" "$unit"
    done <<<"$rows"
    if jq -e '.cedar_ember != null' >/dev/null 2>&1 <<<"$response"; then
      banked_rows="$(jq -er --argjson now "$now_epoch" '
        def iso_epoch:
          if . == null then null
          else sub("\\.[0-9]+(Z|\\+00:00)$"; "Z")
            | sub("\\+00:00$"; "Z") | fromdateiso8601 | floor end;
        .cedar_ember
        | if .eligible == false then [0, "-"]
          elif .eligible != true or (.grants | type) != "array" then
            error("invalid reset grants")
          else
            [.grants[]
              | if (.resets_left | type) != "number" or .resets_left < 0
                  or (.resets_left | floor) != .resets_left then
                  error("invalid reset count") else . end
              | (.starts_at | iso_epoch) as $start
              | (.ends_at | iso_epoch) as $end
              | select(.resets_left > 0 and .paused != true
                  and ($start == null or $start <= $now)
                  and ($end == null or $end > $now))
              | {count: .resets_left, expires: $end}] as $grants
            | [($grants | map(.count) | add // 0),
               ($grants | map(.expires | select(. != null)) | min // "-")]
          end | @tsv' <<<"$response" 2>/dev/null)" || {
        echo '  Banked resets: unavailable (could not parse Claude reset grants)'
        return 1
      }
      IFS=$'\t' read -r banked_count banked_expires <<<"$banked_rows"
      printf '  Banked resets: %s available\n' "$banked_count"
      _usage_banked_reset_add "$rank_file" Claude "$banked_count" "$banked_expires"
    else
      echo '  Banked resets: unavailable (reset grants not provided)'
    fi
    if (( ranked_weekly == 0 )); then
      _usage_claude_norank 'no weekly window with a scheduled reset'
    fi
    return "$api_status"
  }

  _usage_fetch_codex() {
    local rank_file="$1"
    local codex_bin response reset_pacific status=0
    local name used remaining duration reset_epoch window_sec limit_key
    local account_home account_label rank_prefix
    local codex_in_fd codex_out_fd codex_pid line
    local banked_count banked_expires banked_title expires_pacific next_banked_expires

    _usage_section_header Codex
    codex_bin="$(type -P codex)"
    if [[ -z "$codex_bin" ]]; then
      echo '  unavailable (codex is not on PATH)'
      return 1
    fi

    local -a accounts=("$HOME/.codex")
    if [[ -r "${CODEX2_HOME:-$HOME/.codex2}/auth.json" ]]; then
      accounts+=("${CODEX2_HOME:-$HOME/.codex2}")
    fi

    for account_home in "${accounts[@]}"; do
      if [[ "$account_home" == "$HOME/.codex" ]]; then
        account_label=""
        rank_prefix="Codex"
      else
        account_label=" (codex2)"
        rank_prefix="Codex 2"
      fi

      coproc CODEX_USAGE { CODEX_HOME="$account_home" "$codex_bin" app-server 2>/dev/null; }
      codex_out_fd="${CODEX_USAGE[0]}"
      codex_in_fd="${CODEX_USAGE[1]}"
      codex_pid="$CODEX_USAGE_PID"
      printf '%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"agent-usage","version":"1"}}}' \
        >&"$codex_in_fd"

      response=""
      while IFS= read -r -t 10 line <&"$codex_out_fd"; do
        if jq -e '.id == 1' >/dev/null 2>&1 <<<"$line"; then
          printf '%s\n' \
            '{"jsonrpc":"2.0","method":"initialized","params":{}}' \
            '{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read","params":{}}' \
            >&"$codex_in_fd"
          break
        fi
      done
      while IFS= read -r -t 15 line <&"$codex_out_fd"; do
        if jq -e '.id == 2' >/dev/null 2>&1 <<<"$line"; then
          response="$line"
          break
        fi
      done
      exec {codex_in_fd}>&-
      exec {codex_out_fd}<&-
      kill "$codex_pid" 2>/dev/null || true
      wait "$codex_pid" 2>/dev/null || true

      if [[ -n "$response" ]] && jq -e '.result.rateLimitsByLimitId' >/dev/null 2>&1 <<<"$response"; then
        while IFS=$'\t' read -r limit_key name used remaining duration reset_epoch window_sec; do
          reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
          if [[ -n "$reset_pacific" ]]; then
            printf '  %s%s: %s %s%% used, %s%% remaining; %s window; resets %s\n' \
              "$name" "$account_label" "$(_usage_bar "$used")" "$used" "$remaining" "$duration" "$reset_pacific"
            if ! _usage_print_reset_countdown "$reset_epoch"; then
              echo "    unavailable (invalid reset countdown)"
              status=1
            fi
            _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" day ||
              echo "    unavailable (daily-rate calc failed)"
            # Spark runs on its own pool, shown above but never ranked below.
            if [[ "$limit_key" == "codex_bengalfox" ]]; then
              :
            elif (( window_sec == 18000 )); then
              _usage_rank_add "$rank_file" "$rank_prefix · $name" 5h "$used" "$remaining" "$reset_epoch" "$window_sec"
            elif (( window_sec == 604800 )); then
              _usage_rank_add "$rank_file" "$rank_prefix · $name" weekly "$used" "$remaining" "$reset_epoch" "$window_sec"
            elif (( window_sec >= 2419200 && window_sec <= 2678400 )); then
              _usage_rank_add "$rank_file" "$rank_prefix · $name" monthly "$used" "$remaining" "$reset_epoch" "$window_sec"
            fi
          else
            echo "  ${name}${account_label}: unavailable (invalid Codex reset time)"
            status=1
          fi
        done < <(jq -r '
          .result.rateLimitsByLimitId
          | to_entries[]
          | . as $entry
          | ($entry.value.limitName // (if $entry.key == "codex" then "Codex" else $entry.key end)) as $name
          | (
              ($entry.value.primary | select(. != null) | {window: ., tag: ""}),
              ($entry.value.secondary | select(. != null) | {window: ., tag: (
                # Minute equivalents of the weekly/monthly window_sec bounds
                # used for ranking below (604800s; 2419200-2678400s).
                if .windowDurationMins == 10080 then " (weekly)"
                elif .windowDurationMins >= 40320 and .windowDurationMins <= 44640 then " (monthly)"
                else " (secondary)" end)})
            )
          | .window as $window
          | "\($name)\(.tag)" as $label
          | ($window.windowDurationMins
              | if . % 1440 == 0 then "\(. / 1440)d"
                elif . % 60 == 0 then "\(. / 60)h"
                else "\(.)m"
                end) as $duration
          | [$entry.key, $label, ($window.usedPercent | tostring), (100 - $window.usedPercent | tostring), $duration, ($window.resetsAt | tostring), ($window.windowDurationMins * 60 | tostring)]
          | @tsv
        ' <<<"$response")
        # Banked rate-limit reset credits ship in the same response at
        # .result.rateLimitResetCredits (availableCount + credits[] with
        # expiresAt/grantedAt/title/status).
        if jq -e '.result.rateLimitResetCredits' >/dev/null 2>&1 <<<"$response"; then
          banked_count="$(jq -r '.result.rateLimitResetCredits.availableCount' <<<"$response")"
          if [[ ! "$banked_count" =~ ^[0-9]+$ ]]; then
            printf '  Banked resets%s: unavailable (invalid reset count)\n' "$account_label"
            status=1
          elif (( banked_count > 0 )); then
            printf '  Banked resets%s: %s available\n' "$account_label" "$banked_count"
            next_banked_expires="$(jq -r --argjson now "$(date +%s)" '
              [.result.rateLimitResetCredits.credits // [] | .[]
                | select(.status == "available") | .expiresAt
                | select(type == "number" and . > $now) | floor]
              | min // "-"' <<<"$response")"
            _usage_banked_reset_add "$rank_file" "$rank_prefix" "$banked_count" "$next_banked_expires"
            while IFS=$'\t' read -r banked_expires banked_title; do
              if [[ "$banked_expires" == '-' ]]; then
                echo '    no expiry provided'
                continue
              fi
              [[ "$banked_expires" =~ ^[0-9]+$ ]] || {
                echo "    unavailable (invalid banked reset time)"
                status=1
                continue
              }
              expires_pacific="$(TZ=America/Los_Angeles date -r "$banked_expires" '+%Y-%m-%d %H:%M' 2>/dev/null)"
              if [[ -n "$expires_pacific" ]]; then
                if [[ -n "$banked_title" ]]; then
                  printf '    expires %s (%s)\n' "$expires_pacific" "$banked_title"
                else
                  printf '    expires %s\n' "$expires_pacific"
                fi
              else
                echo "    unavailable (invalid banked reset time)"
                status=1
              fi
            done < <(jq -r '
              .result.rateLimitResetCredits.credits // []
              | map(select(.status == "available"))
              | sort_by(.expiresAt)[]
              | "\(.expiresAt // "-")\t\(.title // "")"
            ' <<<"$response")
          else
            printf '  Banked resets%s: none available\n' "$account_label"
          fi
        else
          printf '  Banked resets%s: unavailable\n' "$account_label"
        fi
      else
        echo "  ${account_label# }: unavailable (rate-limit query failed)"
        status=1
      fi
    done
    return "$status"
  }

  _usage_fetch_antigravity() {
    local rank_file="$1"
    local agy_bin response reset_pacific status=0
    local bucket_state label name used remaining duration reset_epoch precise_used precise_remaining
    local timeout_sec="${USAGE_ANTIGRAVITY_TIMEOUT:-25}"
    local agy_out agy_pid deadline query_status=0 timed_out=0

    # Exhausting a weekly quota disables its five-hour bucket, which then has
    # no reset time. It is a valid state, not a failed usage request.
    _usage_antigravity_valid() {
      jq -e '
        .status == "SUCCESS"
        and .command.name == "usage"
        and (.command.data.groups | type) == "array"
        and (.command.data.groups | length) > 0
        and all(.command.data.groups[];
          (.name | type) == "string"
          and (.name | length) > 0
          and (.buckets | type) == "array"
          and (.buckets | length) > 0
          and all(.buckets[];
            (.name | type) == "string"
            and (.name | length) > 0
            and (.window == "weekly" or .window == "5h")
            and (.disabled == null or (.disabled | type) == "boolean")
            and (if .disabled == true then true else
              (.remaining_fraction | type) == "number"
              and .remaining_fraction >= 0
              and .remaining_fraction <= 1
              and (try (.reset_time | fromdateiso8601 | type == "number") catch false)
            end)
          )
        )
      ' >/dev/null 2>&1 <<<"$1"
    }

    _usage_section_header Antigravity
    agy_bin="$(type -P agy)"
    if [[ -z "$agy_bin" ]]; then
      echo "  unavailable (agy is not on PATH)"
      return 1
    fi

    # home|label|rank prefix; the second account (HOME=~/.agy2, see
    # _agy_prepare_home) appears once it holds a login. Both query at once.
    local -a accounts=("$HOME||Antigravity") agy_pids=() agy_outs=() account_env=()
    local agy2_home="${AGY2_HOME:-$HOME/.agy2}" account_home account_label rank_prefix index running pid
    [[ -s "$agy2_home/.gemini/antigravity-cli/antigravity-oauth-token" ]] &&
      accounts+=("$agy2_home| (agy2)|Antigravity 2")

    # Always query the backend. --print-timeout is a turn budget, not a wall
    # clock (a 5s budget has returned after 20s), so preserve the watchdog.
    [[ "$timeout_sec" =~ ^[0-9]+$ ]] && (( timeout_sec > 0 )) || timeout_sec=25
    for index in "${!accounts[@]}"; do
      IFS='|' read -r account_home account_label rank_prefix <<<"${accounts[index]}"
      agy_outs[index]="${rank_file%.rank}.agy$index"
      # The second account presents an SSH session; see _agy2_ssh_connection.
      account_env=(HOME="$account_home")
      [[ "$account_home" == "$HOME" ]] ||
        account_env+=(SSH_CONNECTION="$(_agy2_ssh_connection)")
      env "${account_env[@]}" "$agy_bin" --print '/usage' --output-format json \
        --print-timeout "${timeout_sec}s" >"${agy_outs[index]}" 2>/dev/null &
      agy_pids[index]=$!
    done
    deadline=$(( $(date +%s) + timeout_sec ))
    while (( $(date +%s) < deadline )); do
      running=0
      for pid in "${agy_pids[@]}"; do
        kill -0 "$pid" 2>/dev/null && running=1
      done
      (( running )) || break
      sleep 0.2
    done

    for index in "${!accounts[@]}"; do
      IFS='|' read -r account_home account_label rank_prefix <<<"${accounts[index]}"
      agy_pid="${agy_pids[index]}" agy_out="${agy_outs[index]}" timed_out=0 query_status=0
      if kill -0 "$agy_pid" 2>/dev/null; then
        kill "$agy_pid" 2>/dev/null
        sleep 1
        kill -9 "$agy_pid" 2>/dev/null
        timed_out=1
      fi
      wait "$agy_pid" 2>/dev/null || query_status=$?
      response="$(cat "$agy_out" 2>/dev/null)"
      rm -f "$agy_out"
      if (( timed_out )); then
        echo "  ${account_label# }${account_label:+: }unavailable (usage query timed out after ${timeout_sec}s)"
        status=1
        continue
      fi
      if (( query_status != 0 )); then
        echo "  ${account_label# }${account_label:+: }unavailable (usage query failed)"
        status=1
        continue
      fi
      if ! _usage_antigravity_valid "$response"; then
        echo "  ${account_label# }${account_label:+: }unavailable (invalid usage response)"
        status=1
        continue
      fi

      while IFS=$'\t' read -r bucket_state label name used remaining duration reset_epoch precise_used precise_remaining; do
        if [[ "$bucket_state" == disabled ]]; then
          printf '  %s%s · %s: disabled\n' "$label" "$account_label" "$name"
          continue
        fi
        reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
        if [[ -z "$reset_pacific" ]]; then
          echo "  ${account_label# }${account_label:+: }unavailable (invalid Antigravity reset time)"
          status=1
          continue
        fi
        printf '  %s%s · %s: %s %s%% used, %s%% remaining; %s window; resets %s\n' \
          "$label" "$account_label" "$name" "$(_usage_bar "$used")" "$used" "$remaining" "$duration" "$reset_pacific"
        if ! _usage_print_reset_countdown "$reset_epoch"; then
          echo "    unavailable (invalid reset countdown)"
          status=1
        fi
        case "$duration" in
          weekly)
            _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" 604800 day \
              "$precise_used" "$precise_remaining" ||
              echo "    unavailable (daily-rate calc failed)"
            _usage_rank_add "$rank_file" "$rank_prefix · $label" weekly \
              "$used" "$remaining" "$reset_epoch" 604800
            ;;
          5h)
            _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" 18000 hour \
              "$precise_used" "$precise_remaining" ||
              echo "    unavailable (hourly-rate calc failed)"
            _usage_rank_add "$rank_file" "$rank_prefix · $label" 5h \
              "$used" "$remaining" "$reset_epoch" 18000
            ;;
        esac
      done < <(jq -r '
      def display_percent:
        (. * 10 | round) / 10
        | if . == floor then floor else . end
        | tostring;
      .command.data.groups[]
      | .name as $group
      | .buckets[]
      | if .disabled == true then
          ["disabled", $group, .name, "-", "-", .window, "-", "-", "-"]
        else
          (.remaining_fraction * 100) as $precise_remaining
          | (100 - $precise_remaining) as $precise_used
          | ["active", $group, .name, ($precise_used | display_percent),
             ($precise_remaining | display_percent), .window,
             (.reset_time | fromdateiso8601 | floor),
             ($precise_used | tostring), ($precise_remaining | tostring)]
        end
      | @tsv
      ' <<<"$response")
    done
    return "$status"
  }

  _usage_fetch_devin() {
    local rank_file="$1"
    local devin_creds devin_api_key devin_api_url devin_version devin_body response status=0
    local label used remaining reset_epoch window_sec reset_pacific summary_name

    _usage_section_header Devin
    devin_creds="$HOME/.local/share/devin/credentials.toml"
    if [[ -r "$devin_creds" ]]; then
      devin_api_key="$(grep -E '^windsurf_api_key *=' "$devin_creds" | sed -E 's/^[^=]+= *//; s/^"//; s/"$//')"
      devin_api_url="$(grep -E '^api_server_url *=' "$devin_creds" | sed -E 's/^[^=]+= *//; s/^"//; s/"$//')"
      # The server rejects non-semver client versions; ask the CLI for its real one.
      devin_version="$(devin --version 2>/dev/null | awk 'NR==1 {print $2}')"
      [[ "$devin_version" =~ ^[0-9] ]] || devin_version="3000.4.25"
      devin_body="$(jq -nc --arg k "$devin_api_key" --arg v "$devin_version" \
        '{metadata:{apiKey:$k,ideName:"devin-cli",ideVersion:$v,extensionName:"devin",extensionVersion:$v,locale:"en"}}')"
      response="$(curl -s --max-time 10 -X POST "${devin_api_url%/}/exa.seat_management_pb.SeatManagementService/GetUserStatus" \
        -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' \
        -d "$devin_body" 2>/dev/null)"
      if jq -e '.userStatus.planStatus
          | (.dailyQuotaResetAtUnix // .weeklyQuotaResetAtUnix) != null' >/dev/null 2>&1 <<<"$response"; then
        while IFS=$'\t' read -r label used remaining reset_epoch window_sec; do
          if [[ ! "$reset_epoch" =~ ^[0-9]+$ ]]; then
            echo "  unavailable (invalid Devin reset time)"
            status=1
            continue
          fi
          reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
          printf '  %s: %s %s%% used, %s%% remaining; resets %s\n' \
            "$label" "$(_usage_bar "$used")" "$used" "$remaining" "$reset_pacific"
          if ! _usage_print_reset_countdown "$reset_epoch"; then
            echo "    unavailable (invalid reset countdown)"
            status=1
          fi
          _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" day ||
            echo "    unavailable (daily-rate calc failed)"
          if (( window_sec == 604800 )); then
            summary_name="${label% Weekly}"
            _usage_rank_add "$rank_file" "Devin · $summary_name" weekly \
              "$used" "$remaining" "$reset_epoch" "$window_sec"
          elif (( window_sec == 86400 )); then
            summary_name="${label% Daily}"
            _usage_rank_add "$rank_file" "Devin · $summary_name" daily \
              "$used" "$remaining" "$reset_epoch" "$window_sec"
          fi
        done < <(jq -r '
          .userStatus.planStatus as $p
          | ($p.planInfo.planName // "Devin") as $plan
          | (["\($plan) Daily",  $p.dailyQuotaRemainingPercent,  $p.dailyQuotaResetAtUnix,  86400],
             ["\($plan) Weekly", $p.weeklyQuotaRemainingPercent, $p.weeklyQuotaResetAtUnix, 604800])
          | select(.[2] != null)
          | [.[0], (100 - (.[1] // 0) | tostring), ((.[1] // 0) | tostring), (.[2] | tonumber | tostring), (.[3] | tostring)]
          | @tsv
        ' <<<"$response")
      else
        echo "  unavailable (quota query failed)"
        status=1
      fi
    else
      echo "  unavailable ($devin_creds not readable)"
      status=1
    fi
    return "$status"
  }

  _usage_fetch_grok() {
    local rank_file="$1"
    local grok_bin grok_in_fd grok_out_fd grok_pid line response reset_pacific status=0
    local name used remaining duration reset_epoch window_sec
    local account account_home account_label rank_prefix initialized attempt billing_error

    _usage_section_header Grok
    grok_bin="$(type -P grok)"
    if [[ -z "$grok_bin" ]]; then
      echo "  unavailable (grok is not on PATH)"
      return 1
    fi

    # home|label|rank prefix; extra accounts appear once they hold a login.
    local -a accounts=("$HOME/.grok||Grok")
    if [[ -r "${GROK2_HOME:-$HOME/.grok2}/auth.json" ]]; then
      accounts+=("${GROK2_HOME:-$HOME/.grok2}| (grok2)|Grok 2")
    fi
    if [[ -r "${GROK3_HOME:-$HOME/.grok3}/auth.json" ]]; then
      accounts+=("${GROK3_HOME:-$HOME/.grok3}| (grok3)|Grok 3")
    fi

    for account in "${accounts[@]}"; do
      IFS='|' read -r account_home account_label rank_prefix <<<"$account"

      coproc GROK_USAGE { GROK_HOME="$account_home" "$grok_bin" agent stdio 2>/dev/null; }
      grok_out_fd="${GROK_USAGE[0]}"
      grok_in_fd="${GROK_USAGE[1]}"
      grok_pid="$GROK_USAGE_PID"
      printf '%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":1,"clientCapabilities":{},"clientInfo":{"name":"agent-usage","version":"1"}}}' \
        >&"$grok_in_fd"

      response="" initialized=0
      while IFS= read -r -t 10 line <&"$grok_out_fd"; do
        if jq -e '.id == 1' >/dev/null 2>&1 <<<"$line"; then
          printf '%s\n' '{"jsonrpc":"2.0","method":"initialized","params":{}}' >&"$grok_in_fd"
          initialized=1
          break
        fi
      done
      # xAI's billing service fails single requests on some accounts (~/.grok3, 10-29:
      # 2 in 3 calls, "meter unavailable"); a resend in the same session can succeed.
      for (( attempt = 1; initialized && attempt <= 4; attempt++ )); do
        printf '%s\n' '{"jsonrpc":"2.0","id":2,"method":"_x.ai/billing","params":{}}' >&"$grok_in_fd"
        response=""
        while IFS= read -r -t 10 line <&"$grok_out_fd"; do
          if jq -e '.id == 2' >/dev/null 2>&1 <<<"$line"; then
            response="$line"
            break
          fi
        done
        jq -e '.error' >/dev/null 2>&1 <<<"$response" || break
      done
      exec {grok_in_fd}>&-
      kill "$grok_pid" 2>/dev/null || true
      wait "$grok_pid" 2>/dev/null || true

      if [[ -n "$response" ]] && jq -e '
        .result.config as $config
        | ($config | type) == "object"
          and (($config.currentPeriod.start // $config.billingPeriodStart) | type == "string")
          and (($config.currentPeriod.end // $config.billingPeriodEnd) | type == "string")
      ' >/dev/null 2>&1 <<<"$response"; then
        IFS=$'\t' read -r name used remaining duration reset_epoch window_sec < <(jq -r '
          def display_percent:
            if . == floor then floor else . end | tostring;
          def clamp_percent:
            if . < 0 then 0 elif . > 100 then 100 else . end;
          def iso_epoch:
            sub("\\.[0-9]+Z$"; "Z")
            | sub("\\.[0-9]+\\+00:00$"; "Z")
            | sub("\\+00:00$"; "Z")
            | fromdateiso8601;
          .result as $result
          | $result.config as $config
          | ($config.monthlyLimit.val // 0) as $limit
          | ($config.used.val // 0) as $legacy_used
          | (if ($config.creditUsagePercent | type) == "number" then
               $config.creditUsagePercent
             elif ($limit | type) == "number" and $limit > 0 and ($legacy_used | type) == "number" then
               $legacy_used / $limit * 100
             else
               0
             end | clamp_percent) as $used
          | ($result.subscription_tier
              | if type == "string" and length > 0 then . else "Usage" end) as $name
          | (($config.currentPeriod.type // "period")
              | sub("^USAGE_PERIOD_TYPE_"; "") | ascii_downcase) as $period
          | (($config.currentPeriod.start // $config.billingPeriodStart) | iso_epoch) as $start_epoch
          | (($config.currentPeriod.end // $config.billingPeriodEnd) | iso_epoch) as $reset_epoch
          | [$name, ($used | display_percent), ((100 - $used) | display_percent),
             $period, ($reset_epoch | floor | tostring),
             ($reset_epoch - $start_epoch | floor | tostring)]
          | @tsv
        ' <<<"$response")
        reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
        if [[ -n "$reset_pacific" ]]; then
          printf '  %s%s: %s %s%% used, %s%% remaining; %s; resets %s\n' \
            "$name" "$account_label" "$(_usage_bar "$used")" "$used" "$remaining" "$duration" "$reset_pacific"
          if ! _usage_print_reset_countdown "$reset_epoch"; then
            echo "    unavailable (invalid reset countdown)"
            status=1
          fi
          case "$duration" in
            weekly|monthly)
              _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" day ||
                echo "    unavailable (daily-rate calc failed)"
              _usage_rank_add "$rank_file" "$rank_prefix · $name" "$duration" \
                "$used" "$remaining" "$reset_epoch" "$window_sec"
              ;;
          esac
        else
          echo "  ${name}${account_label}: unavailable (invalid Grok reset time)"
          status=1
        fi
      else
        billing_error="$(jq -r '.error | (.data // .message) | strings' 2>/dev/null <<<"$response")"
        echo "  ${account_label# }: unavailable (billing query failed${billing_error:+: $billing_error})"
        status=1
      fi
    done
    return "$status"
  }

  _usage_fetch_kimi() {
    # Query Kimi's managed /usages API directly. The TUI /usage panel reads
    # usages.limit_*.used_ratio, which is often a stale 0 while the absolute
    # usage/limits fields hold the real numbers. Access tokens expire quickly
    # (~15m); refresh via the OAuth token endpoint before querying.
    local rank_file="$1"
    local kimi_home cred_file token base_url response http_status rows status=0
    local label used remaining reset_epoch window_sec reset_pacific
    local expires_at now_epoch refresh client_id oauth_host
    local new_access new_refresh new_expires_in new_scope new_token_type

    _usage_section_header Kimi
    kimi_home="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
    cred_file="$kimi_home/credentials/kimi-code.json"
    token=""
    if [[ -r "$cred_file" ]]; then
      now_epoch="$(date +%s 2>/dev/null)"
      expires_at="$(jq -r '.expires_at // 0' "$cred_file" 2>/dev/null)"
      [[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0
      if (( expires_at < now_epoch + 30 )); then
        refresh="$(jq -r '.refresh_token // empty' "$cred_file" 2>/dev/null)"
        client_id="${KIMI_CODE_OAUTH_CLIENT_ID:-17e5f671-d194-4dfb-9706-5516cb48c098}"
        oauth_host="${KIMI_CODE_OAUTH_HOST:-${KIMI_OAUTH_HOST:-https://auth.kimi.com}}"
        oauth_host="${oauth_host%/}"
        if [[ -n "$refresh" ]]; then
          response="$(curl -sS --max-time 15 --write-out $'\n%{http_code}' \
            -X POST "$oauth_host/api/oauth/token" \
            -H 'Content-Type: application/x-www-form-urlencoded' \
            -H 'Accept: application/json' \
            --data-urlencode "client_id=$client_id" \
            --data-urlencode 'grant_type=refresh_token' \
            --data-urlencode "refresh_token=$refresh" 2>/dev/null)" || response=""
          if [[ -n "$response" ]]; then
            http_status="${response##*$'\n'}"
            response="${response%$'\n'*}"
            if [[ "$http_status" == "200" ]]; then
              new_access="$(jq -r '.access_token // empty' <<<"$response" 2>/dev/null)"
              new_refresh="$(jq -r '.refresh_token // empty' <<<"$response" 2>/dev/null)"
              new_expires_in="$(jq -r '.expires_in // empty' <<<"$response" 2>/dev/null)"
              new_scope="$(jq -r '.scope // empty' <<<"$response" 2>/dev/null)"
              new_token_type="$(jq -r '.token_type // empty' <<<"$response" 2>/dev/null)"
              if [[ -n "$new_access" && "$new_expires_in" =~ ^[0-9]+$ ]]; then
                [[ -n "$new_refresh" ]] || new_refresh="$refresh"
                [[ -n "$new_scope" ]] || new_scope="$(jq -r '.scope // "kimi-code"' "$cred_file" 2>/dev/null)"
                [[ -n "$new_token_type" ]] || new_token_type="Bearer"
                now_epoch="$(date +%s 2>/dev/null)"
                if jq -n \
                    --arg access "$new_access" \
                    --arg refresh "$new_refresh" \
                    --argjson expires_at "$((now_epoch + new_expires_in))" \
                    --argjson expires_in "$new_expires_in" \
                    --arg scope "$new_scope" \
                    --arg token_type "$new_token_type" \
                    '{access_token:$access, refresh_token:$refresh, expires_at:$expires_at,
                      expires_in:$expires_in, scope:$scope, token_type:$token_type}' \
                    >"$cred_file.tmp" 2>/dev/null; then
                  mv -f "$cred_file.tmp" "$cred_file" 2>/dev/null || rm -f "$cred_file.tmp"
                fi
              fi
            fi
          fi
        fi
      fi
      token="$(jq -r '.access_token // empty' "$cred_file" 2>/dev/null)"
      expires_at="$(jq -r '.expires_at // 0' "$cred_file" 2>/dev/null)"
      [[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0
      now_epoch="$(date +%s 2>/dev/null)"
      if [[ -n "$token" && "$expires_at" -lt $((now_epoch + 30)) ]]; then
        # Expired and refresh failed or was unavailable.
        echo "  unavailable (Kimi Code login needs renewal; run kimi login)"
        return 1
      fi
    fi
    if [[ -z "$token" ]]; then
      echo "  unavailable (no Kimi Code login in $kimi_home/credentials)"
      return 1
    fi

    base_url="${KIMI_CODE_BASE_URL:-https://api.kimi.com/coding/v1}"
    base_url="${base_url%/}"
    if ! response="$(printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' "$token" |
      curl -q -s --max-time 10 --config - --write-out $'\n%{http_code}' \
        "$base_url/usages" 2>/dev/null)"; then
      echo "  unavailable (usage request failed)"
      return 1
    fi
    unset token
    http_status="${response##*$'\n'}"
    response="${response%$'\n'*}"
    case "$http_status" in
      200) ;;
      401|403)
        echo "  unavailable (Kimi Code login needs renewal; run kimi login)"
        return 1 ;;
      *)
        echo "  unavailable (usage endpoint returned HTTP $http_status)"
        return 1 ;;
    esac

    if ! rows="$(jq -er '
      def iso_epoch:
        if . == null or . == "" then ""
        else
          sub("\\.[0-9]+Z$"; "Z")
          | sub("\\.[0-9]+\\+00:00$"; "Z")
          | sub("\\+00:00$"; "Z")
          | fromdateiso8601
          | floor
          | tostring
        end;
      def num:
        if type == "number" then .
        elif type == "string" and test("^[0-9]+([.][0-9]+)?$") then tonumber
        else null end;
      # The API reports limit/remaining and, on older shapes, used. Either
      # pair yields the used percentage; neither present means no window.
      def pct_of($detail):
        ($detail.used|num) as $u | ($detail.limit|num) as $l
        | ($detail.remaining|num) as $rem
        | (if $u != null then $u
           elif $l != null and $rem != null then ($l - $rem)
           else null end) as $spent
        | if $spent == null or $l == null or $l <= 0 then null
          else
            ([$spent / $l * 100, 0] | max) as $p
            | ([$p, 100] | min) | round
          end;
      def window_sec:
        if . == null then 0
        else
          (.duration // 0 | num // 0) as $d
          | if .timeUnit == "TIME_UNIT_HOUR" then ($d * 3600)
            elif .timeUnit == "TIME_UNIT_DAY" then ($d * 86400)
            else ($d * 60)
            end
        end;

      . as $root
      | [
          (if ($root.usage|type) == "object" then
             pct_of($root.usage) as $p
             | select($p != null)
             | ["Weekly", ($p|tostring), (100 - $p | tostring),
                ($root.usage.resetTime|iso_epoch), "604800"]
           else empty end),
          (if ($root.limits|type) == "array" then
             $root.limits[]
             | select((.window|window_sec) >= 14400 and (.window|window_sec) <= 21600)
             | pct_of(.detail) as $p
             | select($p != null)
             | ["5h", ($p|tostring), (100 - $p | tostring),
                (.detail.resetTime|iso_epoch), "18000"]
           else empty end),
          # Fallback: ratio fields only when absolute windows are missing.
          (if ($root.usage|type) != "object"
              and ($root.usages.limit_5h.used_ratio|num) != null then
             ["5h", ($root.usages.limit_5h.used_ratio|num|round|tostring),
              (100 - ($root.usages.limit_5h.used_ratio|num|round) | tostring),
              ($root.usages.limit_5h.reset_time|iso_epoch), "18000"]
           else empty end),
          (if (($root.usage|type) != "object"
               and (($root.limits|type) != "array"
                    or ([ $root.limits[]
                         | select((.window|window_sec) >= 14400
                                  and (.window|window_sec) <= 21600)
                       ] | length) == 0))
              and ($root.usages.limit_7d.used_ratio|num) != null then
             ["Weekly", ($root.usages.limit_7d.used_ratio|num|round|tostring),
              (100 - ($root.usages.limit_7d.used_ratio|num|round) | tostring),
              ($root.usages.limit_7d.reset_time|iso_epoch), "604800"]
           else empty end)
        ]
      | .[]
      | @tsv
    ' <<<"$response" 2>/dev/null)"; then
      echo "  unavailable (could not parse Kimi usage limits)"
      return 1
    fi

    if [[ -z "$rows" ]]; then
      echo "  unavailable (usage response had no quota windows)"
      return 1
    fi

    while IFS=$'\t' read -r label used remaining reset_epoch window_sec; do
      [[ -n "$label" && -n "$used" ]] || continue
      if [[ "$reset_epoch" =~ ^[0-9]+$ ]]; then
        reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
      else
        reset_pacific=""
      fi
      if [[ -n "$reset_pacific" ]]; then
        printf '  %s: %s %s%% used, %s%% remaining; resets %s\n' \
          "$label" "$(_usage_bar "$used")" "$used" "$remaining" "$reset_pacific"
        if ! _usage_print_reset_countdown "$reset_epoch"; then
          echo "    unavailable (invalid reset countdown)"
          status=1
        fi
      else
        printf '  %s: %s %s%% used, %s%% remaining; reset not scheduled\n' \
          "$label" "$(_usage_bar "$used")" "$used" "$remaining"
      fi
      if [[ "$window_sec" == "604800" ]]; then
        _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" day ||
          echo "    unavailable (daily-rate calc failed)"
        [[ "$reset_epoch" =~ ^[0-9]+$ ]] &&
          _usage_rank_add "$rank_file" Kimi weekly "$used" "$remaining" "$reset_epoch" "$window_sec"
      else
        _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" hour ||
          echo "    unavailable (hourly-rate calc failed)"
        # Feed the 5-hour window into the ranked "5-hour limits" summary.
        [[ "$reset_epoch" =~ ^[0-9]+$ ]] &&
          _usage_rank_add "$rank_file" Kimi 5h "$used" "$remaining" "$reset_epoch" "$window_sec"
      fi
    done <<<"$rows"
    return "$status"
  }

  _usage_fetch_cmd() {
    local rank_file="$1"
    local auth_file api_key sub_resp cred_resp since sum_resp status=0
    local plan summary_name pool_used pool_total pool_left purchased free req_count
    local period_start_epoch renewal_epoch five_used five_cap five_reset_epoch
    local weekly_used weekly_cap weekly_reset_epoch
    local now_epoch detail renews_in pct five_pct weekly_pct weekly_left pace_left pace_pct
    local spend_rows spendable spendable_note extra has_extra

    # One cap line: label, used $, cap $, trailing detail.
    _usage_cmd_window() {
      local pct
      pct="$(awk -v u="$2" -v c="$3" 'BEGIN { printf "%.1f", u / c * 100 }')"
      printf '  %-8s %s %s%s\n' "$1:" "$(_usage_bar "$pct")" \
        "$(awk -v u="$2" -v c="$3" 'BEGIN {
          l = c - u; if (l < 0) l = 0
          printf "$%.2f / $%.2f used (%.0f%%) · $%.2f left", u, c, u / c * 100, l
        }')" "$4"
    }

    _usage_section_header 'Command Code'
    auth_file="$HOME/.commandcode/auth.json"
    api_key="${COMMAND_CODE_API_KEY:-}"
    if [[ -z "$api_key" && -r "$auth_file" ]]; then
      api_key="$(jq -r '.apiKey // empty' "$auth_file" 2>/dev/null)"
    fi

    if [[ -z "$api_key" ]]; then
      if ! type -P cmd >/dev/null 2>&1; then
        echo "  unavailable (cmd is not on PATH)"
      else
        echo "  unavailable ($auth_file not readable or has no apiKey)"
      fi
      return 1
    fi

    sub_resp="$(curl -s --max-time 10 -A "cli" \
      -H "Authorization: Bearer $api_key" \
      https://api.commandcode.ai/alpha/billing/subscriptions 2>/dev/null)"
    cred_resp="$(curl -s --max-time 10 -A "cli" \
      -H "Authorization: Bearer $api_key" \
      https://api.commandcode.ai/alpha/billing/credits 2>/dev/null)"

    if [[ -z "$cred_resp" ]] || ! jq -e '.credits' >/dev/null 2>&1 <<<"$cred_resp"; then
      if jq -e '.error.status == 401' >/dev/null 2>&1 <<<"$cred_resp"; then
        if [[ -n "${COMMAND_CODE_API_KEY:-}" ]]; then
          echo "  unavailable (authentication rejected (HTTP 401); update or unset COMMAND_CODE_API_KEY)"
        else
          echo "  unavailable (authentication rejected (HTTP 401); run cmd logout then cmd login)"
        fi
      else
        echo "  unavailable (usage query failed)"
      fi
      return 1
    fi

    since="$(jq -r '.data.currentPeriodStart // empty' <<<"$sub_resp" 2>/dev/null)"
    if [[ -n "$since" ]]; then
      sum_resp="$(curl -s --max-time 10 -A "cli" \
        -H "Authorization: Bearer $api_key" \
        "https://api.commandcode.ai/alpha/usage/summary?since=$since" 2>/dev/null)"
    else
      sum_resp="{}"
    fi

    # Unit-separator delimited: tab is IFS whitespace, so empty fields would collapse.
    IFS=$'\x1f' read -r plan summary_name pool_used pool_total pool_left \
      purchased free req_count \
      period_start_epoch renewal_epoch five_used five_cap five_reset_epoch \
      weekly_used weekly_cap weekly_reset_epoch < <(
      jq -r --argjson sub "${sub_resp:-{\}}" --argjson sum "${sum_resp:-{\}}" '
        def plan_name(id):
          if id == null then "Command Code"
          elif id | startswith("individual-go") then "Go"
          elif id | startswith("individual-goat") then "GOAT"
          elif id | startswith("individual-pro-v1") then "Pro"
          elif id | startswith("individual-pro") then "Pro"
          elif id | startswith("individual-provider") then "Provider"
          elif id | startswith("individual-max") then "Max"
          elif id | startswith("individual-ultra") then "Ultra"
          elif id | startswith("teams-pro") then "Teams"
          else id end;

        def plan_credits(id):
          if id == null then 0
          elif id | startswith("individual-go") then 10
          elif id | startswith("individual-goat") then 70
          elif id | startswith("individual-pro-v1") then 80
          elif id | startswith("individual-pro") then 30
          elif id | startswith("individual-provider") then 15
          elif id | startswith("individual-max") then 150
          elif id | startswith("individual-ultra") then 300
          elif id | startswith("teams-pro") then 40
          else 0 end;

        def iso_epoch:
          sub("\\.[0-9]+Z$"; "Z")
          | sub("\\.[0-9]+\\+00:00$"; "Z")
          | sub("\\+00:00$"; "Z")
          | fromdateiso8601
          | floor;

        $sub.data as $s |
        .credits as $c |
        .windowLimits as $wl |

        ($s.planId // "") as $planId |
        (plan_name($planId)) as $pName |
        (plan_credits($planId)) as $pCredits |
        ($s.status // "") as $status |

        (if $pName != "" and $status != "" then "\($pName) Plan · \($status)"
         elif $pName != "" then "\($pName) Plan"
         else "Command Code" end) as $planLabel |

        ($c.monthlyCredits // 0) as $monthly |
        ($c.purchasedCredits // 0) as $purchased |
        ($c.freeCredits // 0) as $free |
        ($sum.totalCost // 0) as $totalCost |

        # Plan credits only: purchased and free credits are "extra credits",
        # which the 5-hour and weekly windows never meter.
        (if $status == "active" and $pCredits > 0 then
           [$pCredits, $monthly] | max
         elif $monthly > 0 then
           $totalCost + $monthly
         else 0 end) as $planPool |

        def money: . * 10000 | round / 10000;
        def window(w):
          if $wl.limited == true and (w.cap // 0) > 0 then
            [(w.used | money), (w.cap | money), (w.resetAt / 1000 | floor)]
          else ["", "", ""] end;

        ($sum.totalCount // "") as $reqCount |
        (try ($s.currentPeriodStart | iso_epoch) catch "") as $periodStartEpoch |
        (try ($s.currentPeriodEnd | iso_epoch) catch "") as $renewalEpoch |

        [
          $planLabel,
          $pName,
          ($planPool - $monthly | money),
          ($planPool | money),
          ($monthly | money),
          ($purchased | money),
          ($free | money),
          $reqCount,
          $periodStartEpoch,
          $renewalEpoch,
          window($wl.fiveHour)[],
          window($wl.weekly)[]
        ] | map(tostring) | join("\u001f")
      ' <<<"$cred_resp"
    )

    # Monthly plan credits, the weekly cap, and the 5-hour cap all meter the
    # same plan dollars; whichever has the least left limits plan spending.
    # Extra credits (purchased + free) sit outside all three and add on top.
    now_epoch="$(date +%s)"
    printf '  %s\n' "${plan:-Command Code}"
    spend_rows=""

    if [[ "$pool_total" =~ ^[0-9]+([.][0-9]+)?$ && "$pool_used" =~ ^-?[0-9]+([.][0-9]+)?$ ]] &&
        awk -v c="$pool_total" 'BEGIN { exit !(c > 0) }'; then
      detail=""
      if [[ "$req_count" =~ ^[0-9]+$ ]]; then
        detail+=" · $(jq -nr --arg n "$req_count" '$n | [scan(".{1,3}(?=(?:.{3})*$)")] | join(",")') requests"
      fi
      renews_in=""
      if [[ "$renewal_epoch" =~ ^[0-9]+$ ]]; then
        renews_in="$(_usage_compact_duration "$(( renewal_epoch > now_epoch ? renewal_epoch - now_epoch : 0 ))")"
        detail+=" · renews in $renews_in"
      fi
      _usage_cmd_window Monthly "$pool_used" "$pool_total" "$detail"
      spend_rows+="$pool_left"$'\t'"monthly credits${renews_in:+ (renew in $renews_in)}"$'\n'

      if [[ "$period_start_epoch" =~ ^[0-9]+$ && "$renewal_epoch" =~ ^[0-9]+$ ]] &&
          (( renewal_epoch > period_start_epoch )); then
        pct="$(awk -v u="$pool_used" -v c="$pool_total" \
          'BEGIN { p = u / c * 100; if (p < 0) p = 0; if (p > 100) p = 100; printf "%.1f", p }')"
        _usage_rank_add "$rank_file" "Command Code · ${summary_name:-Plan} Plan" monthly \
          "$pct" "$(awk -v p="$pct" 'BEGIN { printf "%.1f", 100 - p }')" "$renewal_epoch" \
          "$((renewal_epoch - period_start_epoch))"
      fi
    fi

    if [[ -n "$weekly_cap" && "$weekly_reset_epoch" =~ ^[0-9]+$ ]]; then
      # Command Code uses resetAt=0 until the window starts on first use.
      detail=" · window not started yet; starts on first use"
      if (( weekly_reset_epoch > 0 )); then
        detail=" · resets in $(_usage_compact_duration "$(( weekly_reset_epoch > now_epoch ? weekly_reset_epoch - now_epoch : 0 ))")"
      fi
      _usage_cmd_window Weekly "$weekly_used" "$weekly_cap" "$detail"
      weekly_left="$(awk -v u="$weekly_used" -v c="$weekly_cap" \
        'BEGIN { l = c - u; if (l < 0) l = 0; printf "%.4f", l }')"
      spend_rows+="$weekly_left"$'\t'"weekly cap"$'\n'

      if (( weekly_reset_epoch > 0 )); then
        # Monthly credits shrink this week's headroom only if they will not
        # renew before the weekly reset.
        pace_left="$weekly_left"
        if [[ -n "$pool_left" && "$renewal_epoch" =~ ^[0-9]+$ ]] &&
            (( renewal_epoch >= weekly_reset_epoch )) &&
            awk -v p="$pool_left" -v w="$weekly_left" 'BEGIN { exit !(p < w) }'; then
          pace_left="$pool_left"
          printf '    monthly credits ($%.2f left) run out before this weekly cap; pace uses them\n' "$pool_left"
        fi
        weekly_pct="$(awk -v u="$weekly_used" -v c="$weekly_cap" \
          'BEGIN { p = u / c * 100; if (p > 100) p = 100; printf "%.1f", p }')"
        pace_pct="$(awk -v l="$pace_left" -v c="$weekly_cap" 'BEGIN { printf "%.1f", l / c * 100 }')"
        _usage_print_daily_rates "$weekly_pct" "$pace_pct" "$weekly_reset_epoch" 604800 day ||
          echo "    unavailable (daily-rate calc failed)"
        _usage_rank_add "$rank_file" "Command Code · ${summary_name:-Plan} Plan" weekly \
          "$weekly_pct" "$(awk -v p="$weekly_pct" 'BEGIN { printf "%.1f", 100 - p }')" \
          "$weekly_reset_epoch" 604800
      else
        printf '%s\t%s\n' 'Command Code' 'weekly window not started yet; starts on first use' >> "${rank_file%.rank}.norank"
      fi
    fi

    if [[ -n "$five_cap" && "$five_reset_epoch" =~ ^[0-9]+$ ]]; then
      detail=" · window not started yet; starts on first use"
      if (( five_reset_epoch > 0 )); then
        detail=" · resets in $(_usage_compact_duration "$(( five_reset_epoch > now_epoch ? five_reset_epoch - now_epoch : 0 ))")"
      fi
      _usage_cmd_window 5-hour "$five_used" "$five_cap" "$detail"
      spend_rows+="$(awk -v u="$five_used" -v c="$five_cap" \
        'BEGIN { l = c - u; if (l < 0) l = 0; printf "%.4f", l }')"$'\t'"5-hour cap"$'\n'
      if (( five_reset_epoch > 0 )); then
        five_pct="$(awk -v u="$five_used" -v c="$five_cap" \
          'BEGIN { p = u / c * 100; if (p > 100) p = 100; printf "%.1f", p }')"
        _usage_rank_add "$rank_file" "Command Code · ${summary_name:-Plan} Plan" 5h \
          "$five_pct" "$(awk -v p="$five_pct" 'BEGIN { printf "%.1f", 100 - p }')" \
          "$five_reset_epoch" 18000
      else
        printf '%s\t%s\n' 'Command Code' '5-hour window not started yet; starts on first use' >> "${rank_file%.rank}.norank"
      fi
    fi

    extra="$(awk -v p="${purchased:-0}" -v f="${free:-0}" 'BEGIN { printf "%.4f", p + f }')"
    has_extra=0
    awk -v e="$extra" 'BEGIN { exit !(e > 0) }' && has_extra=1
    if (( has_extra )); then
      printf '  %-8s $%.2f left ($%.2f purchased, $%.2f free) · not limited by the 5-hour or weekly caps\n' \
        'Extra:' "$extra" "${purchased:-0}" "${free:-0}"
    fi

    if [[ -n "$spend_rows" ]]; then
      IFS=$'\t' read -r spendable spendable_note < <(printf '%s' "$spend_rows" | sort -t $'\t' -k1,1g | head -n 1)
      if (( has_extra )); then
        printf '  Spendable now: $%.2f = $%.2f plan (limited by the %s) + $%.2f extra\n' \
          "$(awk -v s="$spendable" -v e="$extra" 'BEGIN { print s + e }')" \
          "$spendable" "$spendable_note" "$extra"
      else
        printf '  Spendable now: $%.2f, limited by the %s\n' "$spendable" "$spendable_note"
      fi
    elif (( has_extra )); then
      printf '  Spendable now: $%.2f extra credits\n' "$extra"
    fi

    return "$status"
  }

  _usage_fetch_amp() {
    # Amp CLI details shifted from subscription-token "## From" tables to a
    # cost-oriented report (Range, Total tokens, Total recorded cost) that
    # omits ## From when nothing was recorded. Parse both shapes.
    local rank_file="$1"
    local amp_bin response line label name source tokens usage_range total_tokens
    local recorded_cost in_from=0 status=0
    local -a summary_lines=() token_rows=()

    _usage_section_header Amp
    amp_bin="$(type -P amp)"
    if [[ -n "$amp_bin" ]]; then
      response="$("$amp_bin" --no-color usage --details 2>/dev/null)"
      if [[ $? -eq 0 && -n "$response" ]]; then
        while IFS= read -r line; do
          case "$line" in
            '# Usage') continue ;;
            '# Run `amp usage'*) continue ;;
            'Range: '*) usage_range="${line#Range: }"; continue ;;
            'Total tokens: '*) total_tokens="${line#Total tokens: }"; continue ;;
            'Total recorded cost: '*) recorded_cost="${line#Total recorded cost: }"; continue ;;
            '## From'|'## Models')
              in_from=1
              continue
              ;;
            '## '*) in_from=0; continue ;;
          esac

          if (( in_from )); then
            if [[ "$line" == '|'*'|' ]]; then
              IFS='|' read -r _ source tokens _ <<<"$line"
              source="${source#"${source%%[![:space:]]*}"}"
              source="${source%"${source##*[![:space:]]}"}"
              tokens="${tokens#"${tokens%%[![:space:]]*}"}"
              tokens="${tokens%"${tokens##*[![:space:]]}"}"
              # Models tables can have a cost column; keep the token column.
              if [[ -n "$source" && "$tokens" =~ ^[0-9][0-9,]*$ ]]; then
                token_rows+=("$source"$'\t'"$tokens")
              fi
            fi
            continue
          fi

          [[ -z "$line" || "$line" == '<!--'* || "$line" == '|'* ]] && continue
          if [[ "$line" == 'Signed in as '* || "$line" == '**'* ]]; then
            summary_lines+=("${line%% - https://*}")
          fi
        done <<<"$response"

        for line in "${summary_lines[@]}"; do
          printf '  %s\n' "$line"
        done
        if [[ -n "$usage_range" && "$total_tokens" =~ ^[0-9][0-9,]*$ ]]; then
          echo '  Token usage by source:'
          if (( ${#token_rows[@]} == 0 )); then
            echo '    none recorded'
          else
            for line in "${token_rows[@]}"; do
              IFS=$'\t' read -r source tokens <<<"$line"
              printf '    %s: %s tokens\n' "$source" "$tokens"
            done
          fi
          printf '    Total: %s tokens\n' "$total_tokens"
          [[ -n "$recorded_cost" ]] && printf '    Recorded cost: %s\n' "$recorded_cost"
          printf '    Range: %s\n' "$usage_range"
        elif [[ -n "$usage_range" ]]; then
          printf '    Range: %s\n' "$usage_range"
          echo "  unavailable (could not parse detailed token usage)"
          status=1
        else
          echo "  unavailable (could not parse detailed token usage)"
          status=1
        fi
      else
        echo "  unavailable (usage query failed)"
        status=1
      fi

      response="$("$amp_bin" --no-color config model-providers list 2>/dev/null)"
      if [[ $? -eq 0 && -n "$response" ]]; then
        while IFS= read -r line; do
          [[ "$line" =~ ^(active|inactive)[[:space:]]+(.+)[[:space:]]+([0-9a-fA-F-]{36})$ ]] || continue
          label="${BASH_REMATCH[1]}"
          name="${BASH_REMATCH[2]}"
          name="${name%"${name##*[![:space:]]}"}"
          name="$(printf '%s' "$name" | sed -E 's/[[:space:]]{2,}/ · /g')"
          [[ "$name" == *' · Subscription' ]] && name="${name%' · Subscription'}"
          printf '  %-8s  %s\n' "$label" "$name"
        done <<<"$response"
      else
        echo "  unavailable (model-provider list failed)"
        status=1
      fi
    else
      echo "  unavailable (amp is not on PATH)"
      status=1
    fi
    return "$status"
  }

  _usage_fetch_opencode() {
    local rank_file="$1"
    local opencode_bin opencode_auth opencode_key response http_status reset_pacific status=0
    local label used remaining reset_epoch window_sec

    _usage_section_header 'OpenCode Go'
    # Match native Console auth: the environment overrides saved credentials.
    opencode_key="${OPENCODE_API_KEY:-}"
    if [[ -z "$opencode_key" ]]; then
      # V2 keeps active credentials in SQLite; auth.json is a stale migration input.
      opencode_bin="$(type -P opencode)"
      if [[ -z "$opencode_bin" ]]; then
        echo "  unavailable (opencode is not on PATH)"
        return 1
      fi
      if ! opencode_auth="$("$opencode_bin" auth export opencode-go 2>/dev/null)"; then
        echo "  unavailable (could not export OpenCode Go credentials)"
        return 1
      fi
      opencode_key="$(jq -er '
        select(type == "array")
        | map(select(.integrationID == "opencode-go" and .active == true))
        | select(length == 1) | .[0].value
        | select(.type == "key") | .key | select(type == "string" and length > 0)
      ' <<<"$opencode_auth" 2>/dev/null)"
    fi
    if [[ -n "$opencode_key" ]]; then
      if ! response="$(curl -s --max-time 10 --write-out $'\n%{http_code}' \
        -H "Authorization: Bearer $opencode_key" \
        https://opencode.ai/zen/go/v1/usage 2>/dev/null)"; then
        echo "  unavailable (usage request failed)"
        return 1
      fi
      http_status="${response##*$'\n'}"
      response="${response%$'\n'*}"
      if [[ "$http_status" != 200 ]]; then
        if [[ "$http_status" == 401 ]] &&
            jq -e '.error.code == "api_key_expired"' >/dev/null 2>&1 <<<"$response"; then
          # Any agent reading this code should carry out recovery when needed:
          # use opencode.ai/console/account -> Personal API keys in the subscribed
          # Go workspace (Models=Request, Usage=Read), then install via /connect
          # or opencode auth login opencode-go --method key, not auth.json.
          # Never log the key; verify a native model request and usage -a opencode.
          # Reuse browser sign-in; ask only if interactive sign-in is unavoidable.
          # Preserve other accounts and do not revoke unrelated keys.
          echo "  unavailable (OpenCode Go API key expired; create a new key in OpenCode Console)"
          echo "    Replace it via /connect -> OpenCode Go; signing in again does not renew the key."
          echo "    Any agent reading this code should complete recovery and verify both model access and usage -a opencode."
        else
          echo "  unavailable (usage endpoint returned HTTP $http_status)"
        fi
        return 1
      fi
      if jq -e '
        .usage as $u
        | ($u | type) == "object"
          and all(["rolling", "weekly", "monthly"][];
            $u[.] |
            (.status | type) == "string"
            and (.percent | type) == "number"
            and (.resetsAt | type) == "string")
      ' >/dev/null 2>&1 <<<"$response"; then
        while IFS=$'\t' read -r label used remaining reset_epoch window_sec; do
          reset_pacific="$(TZ=America/Los_Angeles date -r "$reset_epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)"
          if [[ -z "$reset_pacific" ]]; then
            echo "  unavailable (invalid OpenCode Go reset time)"
            status=1
            continue
          fi
          printf '  %s: %s %s%% used, %s%% remaining; resets %s\n' \
            "$label" "$(_usage_bar "$used")" "$used" "$remaining" "$reset_pacific"
          if ! _usage_print_reset_countdown "$reset_epoch"; then
            echo "    unavailable (invalid reset countdown)"
            status=1
          fi
          case "$window_sec" in
            18000)
              _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" hour ||
                echo "    unavailable (hourly-rate calc failed)"
              _usage_rank_add "$rank_file" 'OpenCode Go' 5h "$used" "$remaining" "$reset_epoch" "$window_sec"
              ;;
            604800)
              _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" day ||
                echo "    unavailable (daily-rate calc failed)"
              _usage_rank_add "$rank_file" 'OpenCode Go' weekly "$used" "$remaining" "$reset_epoch" "$window_sec"
              ;;
            *)
              _usage_print_daily_rates "$used" "$remaining" "$reset_epoch" "$window_sec" day ||
                echo "    unavailable (daily-rate calc failed)"
              _usage_rank_add "$rank_file" 'OpenCode Go' monthly "$used" "$remaining" "$reset_epoch" "$window_sec"
              ;;
          esac
        done < <(jq -r '
          def iso_epoch:
            sub("\\.[0-9]+Z$"; "Z")
            | sub("\\.[0-9]+\\+00:00$"; "Z")
            | sub("\\+00:00$"; "Z")
            | fromdateiso8601;
          .usage as $u
          | [["5h",      $u.rolling, 18000],
             ["Weekly",  $u.weekly,  604800],
             ["Monthly", $u.monthly, 2592000]]
          | .[]
          | .[0] as $label | .[1] as $w | .[2] as $window_sec
          | [$label,
             ($w.percent | tostring),
             ((100 - $w.percent) | tostring),
             ($w.resetsAt | iso_epoch | floor | tostring),
             ($window_sec | tostring)]
          | @tsv
        ' <<<"$response")
      else
        echo "  unavailable (could not parse OpenCode Go usage limits)"
        status=1
      fi
    else
      echo "  unavailable (could not resolve exactly one active OpenCode Go API key; run opencode auth login opencode-go)"
      status=1
    fi
    return "$status"
  }

  # TypeSafe's public API has no usage or balance endpoint; both live in the
  # console behind Stytch login cookies. The `session` JWT lasts five minutes,
  # but the server re-mints it from the durable `session_id` cookie whenever
  # both are sent, so the cookie jar refreshes itself and only needs reseeding
  # (`typesafe-login`) when the Stytch session itself ends, fourteen days
  # after login. The balance comes from a Next.js server action whose id is
  # rebuilt on every console deploy, so the id is cached and rediscovered from
  # the page's own chunks when the console reports it is gone.
  _usage_fetch_typesafe() {
    local rank_file="$1"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-usage"
    local jar="${TYPESAFE_COOKIE_JAR:-$cache_dir/typesafe-cookies.txt}"
    local action_file="$cache_dir/typesafe-billing-action"
    local work action response http_status billing usage_rows status=0
    local plan cycle spent balance free_left purchased resets_in_days
    local label amount remaining created_epoch expires_epoch used_pct remaining_pct
    local window_sec expires_pacific countdown now_epoch session_expiry
    local scope key_name requests input_tokens output_tokens
    local usd_per_mtok=0.042

    _usage_usd() {
      awk -v v="$1" 'BEGIN { sign = ""; if (v < 0) { sign = "-"; v = -v }; printf "%s$%.2f", sign, v }'
    }

    # The Stytch session end is carried in the JWT, so the report can say when
    # a reseed becomes necessary instead of only failing once it has.
    _usage_typesafe_session_end() {
      local raw payload pad decoded
      raw="$(awk -F'\t' '$6 == "session" { print $7 }' "$1" 2>/dev/null)"
      [[ -n "$raw" ]] || return 1
      payload="$(cut -d. -f2 <<<"$raw" | tr '_-' '/+')"
      pad=$(( (4 - ${#payload} % 4) % 4 ))
      payload="$payload$(printf '%*s' "$pad" '' | tr ' ' '=')"
      decoded="$(base64 -d <<<"$payload" 2>/dev/null)" || return 1
      jq -er '.["https://stytch.com/session"].expires_at
              | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601' <<<"$decoded" 2>/dev/null
    }

    _usage_typesafe_billing_post() {
      printf '%s' "$(curl -q -s --max-time 20 -b "$work" -c "$work" --write-out $'\n%{http_code}' \
        -X POST --data '[]' -H "Next-Action: $1" -H 'Accept: text/x-component' \
        -H 'Content-Type: text/plain;charset=UTF-8' \
        https://console.typesafe.ai/settings/billing 2>/dev/null)"
    }

    # Read the action id straight out of the chunks the billing page loads,
    # stopping at the first chunk that registers the function by name.
    _usage_typesafe_discover_action() {
      local page chunk body id
      page="$(curl -q -s --max-time 20 -b "$work" \
        https://console.typesafe.ai/settings/billing 2>/dev/null)" || return 1
      while read -r chunk; do
        [[ -n "$chunk" ]] || continue
        body="$(curl -q -s --max-time 20 "https://console.typesafe.ai$chunk" 2>/dev/null)" || continue
        id="$(grep -o -E 'createServerReference\)\("[0-9a-f]+",[^,]+,[^,]+,[^,]+,"getBillingOverviewResult"' \
          <<<"$body" | grep -o '"[0-9a-f]\{16,\}"' | tr -d '"' | head -1)"
        [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
      done < <(grep -o '/_next/static/chunks/[A-Za-z0-9_.-]*\.js' <<<"$page" | sort -u)
      return 1
    }

    _usage_section_header TypeSafe
    if [[ ! -r "$jar" ]]; then
      echo '  unavailable (no console session; copy the Cookie header from a logged-in console.typesafe.ai request and run typesafe-login)'
      return 1
    fi

    # Work on a copy: a rejected request makes the console blank the session
    # cookie, and writing that back would destroy a still-valid login.
    mkdir -p "$cache_dir" 2>/dev/null
    work="$(mktemp "$cache_dir/typesafe.XXXXXX")" || return 1
    cp "$jar" "$work" 2>/dev/null || { rm -f "$work"; return 1; }

    action="$(cat "$action_file" 2>/dev/null)"
    [[ "$action" =~ ^[0-9a-f]{16,}$ ]] || action=''
    if [[ -n "$action" ]]; then
      response="$(_usage_typesafe_billing_post "$action")"
    else
      response=$'\n404'
    fi
    http_status="${response##*$'\n'}"
    response="${response%$'\n'*}"

    # A console deploy rebuilds every action id; rediscover once, then retry.
    if [[ "$http_status" == 404 ]]; then
      if action="$(_usage_typesafe_discover_action)" && [[ -n "$action" ]]; then
        printf '%s' "$action" >"$action_file" 2>/dev/null
        response="$(_usage_typesafe_billing_post "$action")"
        http_status="${response##*$'\n'}"
        response="${response%$'\n'*}"
      else
        echo '  unavailable (could not locate the console billing action; the console may have changed)'
        rm -f "$work"
        return 1
      fi
    fi

    case "$http_status" in
      200) ;;
      3[0-9][0-9]|401|403)
        echo '  unavailable (console session ended; copy a fresh Cookie header and run typesafe-login)'
        rm -f "$work"
        return 1 ;;
      *)
        echo "  unavailable (billing overview returned HTTP $http_status)"
        rm -f "$work"
        return 1 ;;
    esac

    # Server actions answer in RSC flight rows ("<id>:<json>"); the return
    # value is the row carrying data.billing.
    billing="$(jq -Rr '
      sub("^[0-9a-f]+:"; "") | try fromjson catch empty
      | select(type == "object")
      | if (.data.billing? | type) == "object" then "billing\t" + (.data.billing | tojson)
        elif .ok == false then "error\t" + ((.error // .message // "unknown error") | tostring)
        else empty end' <<<"$response" 2>/dev/null | head -n1)"
    case "$billing" in
      billing$'\t'*) billing="${billing#billing$'\t'}" ;;
      error$'\t'*)
        echo "  unavailable (billing overview error: ${billing#error$'\t'})"
        rm -f "$work"
        return 1 ;;
      *)
        echo '  unavailable (could not parse billing overview; the console billing action may have changed)'
        rm -f "$work"
        return 1 ;;
    esac

    IFS=$'\t' read -r plan cycle spent balance free_left purchased resets_in_days < <(jq -r '
      [ (.plan // "pay_as_you_go" | gsub("_"; " ") | (.[:1] | ascii_upcase) + .[1:]),
        (.cycleLabel // ""), (.spent // "" | tostring), (.balance // "" | tostring),
        (.freeCreditsRemaining // "" | tostring), (.purchased // "" | tostring),
        (.resetsInDays // "" | tostring) ] | @tsv' <<<"$billing")
    printf '  %s' "$plan"
    if [[ "$balance" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
      printf ' · credit balance %s' "$(_usage_usd "$balance")"
      if [[ "$free_left" =~ ^-?[0-9]+([.][0-9]+)?$ && "$purchased" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
        printf ' (%s free, %s purchased)' "$(_usage_usd "$free_left")" "$(_usage_usd "$purchased")"
      fi
    fi
    printf '\n'
    if [[ -n "$cycle" && "$spent" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
      printf '  %s cycle: %s spent' "$cycle" "$(_usage_usd "$spent")"
      [[ "$resets_in_days" =~ ^[0-9]+$ ]] && printf '; resets in %s days' "$resets_in_days"
      printf '\n'
    fi

    now_epoch="$(date +%s)"
    while IFS=$'\t' read -r label amount remaining created_epoch expires_epoch used_pct remaining_pct; do
      [[ -n "$label" ]] || continue
      printf '  %s: %s of %s left' "$label" "$(_usage_usd "$remaining")" "$(_usage_usd "$amount")"
      [[ -n "$used_pct" ]] && printf ' %s %s%% used' "$(_usage_bar "$used_pct")" "$used_pct"
      if [[ "$expires_epoch" =~ ^[0-9]+$ ]]; then
        expires_pacific="$(TZ=America/Los_Angeles date -r "$expires_epoch" '+%Y-%m-%d %H:%M %Z' 2>/dev/null)"
        countdown="$(_usage_compact_duration "$(( expires_epoch > now_epoch ? expires_epoch - now_epoch : 0 ))")"
        printf '; expires %s (in %s)' "$expires_pacific" "$countdown"
      fi
      printf '\n'
      # Only month-scale grants (the free tier credit) are paced and ranked; a
      # year-long purchased balance has no meaningful daily target.
      if [[ -n "$used_pct" && "$created_epoch" =~ ^[0-9]+$ && "$expires_epoch" =~ ^[0-9]+$ ]] &&
          (( expires_epoch > created_epoch && expires_epoch - created_epoch <= 31 * 86400 )); then
        window_sec=$(( expires_epoch - created_epoch ))
        _usage_print_reset_countdown "$expires_epoch" ||
          echo "    unavailable (invalid reset countdown)"
        _usage_print_daily_rates "$used_pct" "$remaining_pct" "$expires_epoch" "$window_sec" day ||
          echo "    unavailable (daily-rate calc failed)"
        _usage_rank_add "$rank_file" "TypeSafe · $label" monthly \
          "$used_pct" "$remaining_pct" "$expires_epoch" "$window_sec"
      fi
    done < <(jq -r '
      def iso_epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
      def pct1: (. * 10 | round) / 10 | if . < 0 then 0 elif . > 100 then 100 else . end;
      (.credits // [])[]
      | (.amount // 0) as $amount
      | (.remaining // $amount) as $remaining
      | [ ({free_tier_credit: "Free tier credit", purchased_credits: "Purchased credit"}[.reason // ""]
            // ((.reason // "credit") | gsub("_"; " "))),
          $amount, $remaining,
          (try (.createdAt | iso_epoch) catch ""),
          (try (.expiresAt | iso_epoch) catch ""),
          (if $amount > 0 then (($amount - $remaining) / $amount * 100 | pct1) else "" end),
          (if $amount > 0 then ($remaining / $amount * 100 | pct1) else "" end) ]
      | @tsv' <<<"$billing" 2>/dev/null)

    response="$(curl -q -s --max-time 20 -b "$work" -c "$work" --write-out $'\n%{http_code}' \
      -H 'Accept: application/json' \
      'https://console.typesafe.ai/api/usage?granularity=hour' 2>/dev/null)"
    http_status="${response##*$'\n'}"
    response="${response%$'\n'*}"
    if [[ "$http_status" != 200 ]]; then
      echo "  unavailable (console usage returned HTTP $http_status)"
      status=1
    elif ! usage_rows="$(jq -er '
      def iso_epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
      def commas: tostring | [scan(".{1,3}(?=(?:.{3})*$)")] | join(",");
      def total(bs): [ (bs | map(.requests) | add // 0 | commas),
                       (bs | map(.inputTokens) | add // 0),
                       (bs | map(.outputTokens) | add // 0) ];
      (now | floor) as $now
      | [ .buckets[] | .epoch = (.day | iso_epoch) ] as $b
      | [ $b[] | select(.epoch >= $now - 604800) ] as $week
      | (["24h", "-"] + total([ $b[] | select(.epoch >= $now - 86400) ])),
        (["7d", "-"] + total($week)),
        ($week | group_by(.apiKeyId)[]
          | ["key", (if (.[0].apiKeyName // "") != "" then .[0].apiKeyName else (.[0].apiKeyId // "unnamed") end)]
            + total(.))
      | @tsv' <<<"$response" 2>/dev/null)"; then
      echo '  unavailable (could not parse console usage)'
      status=1
    else
      printf '  Usage, estimated at $%s/MTok input (output is free):\n' "$usd_per_mtok"
      while IFS=$'\t' read -r scope key_name requests input_tokens output_tokens; do
        case "$scope" in
          24h) label='last 24h' ;;
          7d) label='last 7d' ;;
          key) label="$key_name (7d)" ;;
          *) continue ;;
        esac
        awk -v label="$label" -v req="$requests" -v inp="$input_tokens" -v out="$output_tokens" \
          -v rate="$usd_per_mtok" 'BEGIN {
            printf "    %s: $%.2f · %s requests · %.1fM in / %.1fM out\n",
              label, inp / 1e6 * rate, req, inp / 1e6, out / 1e6 }'
      done <<<"$usage_rows"
    fi

    # Promote the refreshed cookies only when the session survived; a blanked
    # session cookie means the jar copy is worthless and the original is not.
    if [[ -s "$work" ]] && [[ -n "$(awk -F'\t' '$6 == "session" { print $7 }' "$work" 2>/dev/null)" ]]; then
      mv "$work" "$jar" 2>/dev/null && chmod 600 "$jar" 2>/dev/null
    fi
    rm -f "$work"

    if session_expiry="$(_usage_typesafe_session_end "$jar")" && [[ "$session_expiry" =~ ^[0-9]+$ ]]; then
      now_epoch="$(date +%s)"
      printf '  Console session ends %s (in %s); rerun typesafe-login after that\n' \
        "$(TZ=America/Los_Angeles date -r "$session_expiry" '+%Y-%m-%d %H:%M %Z' 2>/dev/null)" \
        "$(_usage_compact_duration "$(( session_expiry > now_epoch ? session_expiry - now_epoch : 0 ))")"
    fi
    return "$status"
  }

  if ! command -v jq >/dev/null 2>&1; then
    echo "usage requires jq" >&2
    return 127
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "usage requires python3" >&2
    return 127
  fi

  local tmp_dir
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/usage.XXXXXX")" || return 1

  local status=0
  local -a usage_rankings=()
  local -a usage_norank=()
  local -a usage_banked_resets=()
  local -a usage_api_credits=()
  local -a pids=()
  local provider i pid line printed=0

  _usage_cleanup() {
    for pid in "${pids[@]}"; do
      kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    done
    for pid in "${pids[@]}"; do
      wait "$pid" 2>/dev/null || true
    done
    rm -rf "$tmp_dir"
  }
  trap _usage_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # Each worker owns a process group so cancellation can stop CLI children.
  # Parent bash `set -m` is avoided: job-control setpgid in usage subshells
  # can fail with EPERM in non-tty / nested shells. Instead the worker bash
  # is session leader via setsid, so its pgid equals its pid.
  printf 'usage_is_tty=%q\nusage_started_pacific=%q\n' \
    "$usage_is_tty" "$usage_started_pacific" >"$tmp_dir/usage_vars.sh"
  declare -f \
    _usage_compact_duration \
    _usage_print_daily_rates \
    _usage_bar \
    _usage_section_header \
    _usage_rank_add \
    _usage_banked_reset_add \
    _usage_print_reset_countdown \
    _usage_fetch_claude_api_credits \
    _usage_fetch_claude \
    _usage_fetch_codex \
    _usage_fetch_antigravity \
    _agy2_ssh_connection \
    _usage_fetch_devin \
    _usage_fetch_grok \
    _usage_fetch_kimi \
    _usage_fetch_cmd \
    _usage_fetch_amp \
    _usage_fetch_opencode \
    _usage_fetch_typesafe \
    >"$tmp_dir/usage_funcs.sh"

  for provider in "${providers[@]}"; do
    # Use the running bash ($BASH), not /bin/bash: macOS /bin/bash 3.2 cannot
    # reparse declare -f output that contains coproc (Codex/Grok workers).
    python3 -c 'import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
      "${BASH:-/bin/bash}" -c \
      "source \"$tmp_dir/usage_vars.sh\"; source \"$tmp_dir/usage_funcs.sh\"; _usage_fetch_$provider \"\$0\"" \
      "$tmp_dir/$provider.rank" \
      >"$tmp_dir/$provider.out" 2>"$tmp_dir/$provider.err" &
    pids+=("$!")
  done

  while (( ${#pids[@]} )); do
    for i in "${!pids[@]}"; do
      pid="${pids[i]}"
      kill -0 "$pid" 2>/dev/null && continue
      wait "$pid" 2>/dev/null || status=1
      unset 'pids[i]'
      provider="${providers[i]}"
      if (( records )); then
        cat "$tmp_dir/$provider.err" >&2
        if [[ -f "$tmp_dir/$provider.rank" ]]; then
          while IFS= read -r line; do
            [[ -n "$line" ]] && printf 'window\t%s\t%s\n' "$provider" "$line"
          done < "$tmp_dir/$provider.rank"
        fi
        if [[ -s "$tmp_dir/$provider.norank" ]]; then
          while IFS= read -r line; do
            [[ -n "$line" ]] && printf 'unranked\t%s\t%s\n' "$provider" "$line"
          done < "$tmp_dir/$provider.norank"
        fi
        continue
      fi
      (( printed )) && printf '\n'
      printed=1
      cat "$tmp_dir/$provider.out"
      cat "$tmp_dir/$provider.err" >&2
      if [[ -f "$tmp_dir/$provider.rank" ]]; then
        while IFS= read -r line; do
          [[ -n "$line" ]] && usage_rankings+=("$line")
        done < "$tmp_dir/$provider.rank"
      fi
      # A provider may rank some windows and still report a gap, such as a
      # weekly window with no scheduled reset behind a live five-hour one.
      if [[ -s "$tmp_dir/$provider.norank" ]]; then
        while IFS= read -r line; do
          [[ -n "$line" ]] && usage_norank+=("$line")
        done < "$tmp_dir/$provider.norank"
      fi
      if [[ -s "$tmp_dir/$provider.resets" ]]; then
        while IFS= read -r line; do
          [[ -n "$line" ]] && usage_banked_resets+=("$line")
        done < "$tmp_dir/$provider.resets"
      fi
      if [[ -s "$tmp_dir/$provider.api-credits" ]]; then
        while IFS= read -r line; do
          [[ -n "$line" ]] && usage_api_credits+=("$line")
        done < "$tmp_dir/$provider.api-credits"
      fi
    done
    (( ${#pids[@]} )) && sleep 0.05
  done

  (( records )) || _usage_print_ranked_expirations

  return "$status"
)

# Import the Console session without changing the Claude Code login.
claude-console-login() (
  set +x
  local jar cookie
  jar="${CLAUDE_CONSOLE_COOKIE_JAR:-${XDG_CACHE_HOME:-$HOME/.cache}/agent-usage/claude-console-cookies.txt}"
  if [[ -t 0 ]]; then cookie="$(pbpaste 2>/dev/null)"; else cookie="$(cat)"; fi
  printf '%s' "$cookie" | python3 -c '
import http.cookies, os, pathlib, re, sys, tempfile
raw = sys.stdin.read().strip()
header = re.search(r"^cookie:\s*(.+)$", raw, re.I | re.M)
raw = header.group(1).strip() if header else raw
cookies = http.cookies.SimpleCookie()
try:
    cookies.load(raw)
except http.cookies.CookieError:
    cookies.clear()
org = cookies.get("lastActiveOrg")
if not org or not re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", org.value) or not any(
    cookies.get(name) and cookies[name].value for name in ("sessionKey", "sessionKeyLC", "sessionKeyV3LC")
):
    sys.exit("Copy the Cookie request header from a logged-in platform.claude.com billing request (session and lastActiveOrg required).")
path = pathlib.Path(sys.argv[1]).expanduser()
os.umask(0o077)
path.parent.mkdir(parents=True, exist_ok=True)
fd, temp = tempfile.mkstemp(prefix=".claude-console-", dir=path.parent)
try:
    with os.fdopen(fd, "w") as stream:
        stream.write("# Netscape HTTP Cookie File\n")
        for name in ("lastActiveOrg", "sessionKey", "sessionKeyLC", "sessionKeyV3LC", "cf_clearance", "__cf_bm"):
            if name not in cookies:
                continue
            item = cookies[name]
            if any(c in item.value for c in "\r\n\t"):
                raise ValueError("Invalid Console cookie value")
            stream.write(f"#HttpOnly_platform.claude.com\tFALSE\t/\tTRUE\t0\t{name}\t{item.value}\n")
    os.replace(temp, path)
finally:
    if os.path.exists(temp):
        os.unlink(temp)
print(f"Console session stored in {path}; run usage -a claude to check API credits.")
' "$jar"
)

# Seed the console cookie jar that `usage` reads for TypeSafe. Copy the Cookie
# request header from any logged-in console.typesafe.ai request (DevTools ->
# Network -> pick a request -> Copy value, or Copy request headers), then run
# this with nothing else copied in between. `usage` keeps the short-lived JWT
# in the jar fresh on every run, so this is only needed after the Stytch
# session itself ends, fourteen days after a browser login.
typesafe-login() {
  local clip cookie sid oid jwt cache_dir jar exp code
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-usage"
  jar="${TYPESAFE_COOKIE_JAR:-$cache_dir/typesafe-cookies.txt}"

  if [[ ! -t 0 ]]; then
    clip="$(cat)"
  else
    clip="$(pbpaste 2>/dev/null)"
  fi
  if [[ -z "$clip" ]]; then
    echo 'nothing to read; copy the Cookie header from console.typesafe.ai, or pipe it in' >&2
    return 1
  fi

  # Accept a bare Cookie value, a "Copy request headers" block, or "Copy as cURL".
  cookie="$(grep -i -m1 -E '^[[:space:]]*cookie:' <<<"$clip" |
    sed -E 's/^[[:space:]]*[Cc][Oo][Oo][Kk][Ii][Ee]:[[:space:]]*//')"
  if [[ -z "$cookie" ]]; then
    cookie="$(grep -o -i -m1 -E "(-b|-H '[Cc]ookie:) *'[^']*'" <<<"$clip" |
      sed -E "s/^[^']*'//; s/'\$//; s/^[Cc][Oo][Oo][Kk][Ii][Ee]: *//")"
  fi
  [[ -n "$cookie" ]] || cookie="$(tr -d '\r\n' <<<"$clip")"

  sid="$(tr ';' '\n' <<<"$cookie" | sed -E 's/^ *//' | sed -n 's/^session_id=//p' | head -1)"
  oid="$(tr ';' '\n' <<<"$cookie" | sed -E 's/^ *//' | sed -n 's/^organization_id=//p' | head -1)"
  jwt="$(tr ';' '\n' <<<"$cookie" | sed -E 's/^ *//' | sed -n 's/^session=//p' | head -1)"
  if [[ -z "$sid" || -z "$jwt" ]]; then
    echo 'that clipboard has no console.typesafe.ai login (both session_id and session cookies are required)' >&2
    return 1
  fi

  # The jar holds a live login, so it is created private and never echoed.
  ( umask 077
    mkdir -p "$cache_dir" && chmod 700 "$cache_dir" 2>/dev/null
    exp=$(( $(date +%s) + 30 * 86400 ))
    {
      echo '# Netscape HTTP Cookie File'
      printf '#HttpOnly_console.typesafe.ai\tFALSE\t/\tTRUE\t%s\tsession_id\t%s\n' "$exp" "$sid"
      [[ -n "$oid" ]] &&
        printf '#HttpOnly_console.typesafe.ai\tFALSE\t/\tTRUE\t%s\torganization_id\t%s\n' "$exp" "$oid"
      printf '#HttpOnly_console.typesafe.ai\tFALSE\t/\tTRUE\t%s\tsession\t%s\n' "$exp" "$jwt"
    } >"$jar" ) || return 1
  chmod 600 "$jar" 2>/dev/null

  code="$(curl -q -s --max-time 20 -b "$jar" -c "$jar" -o /dev/null --write-out '%{http_code}' \
    https://console.typesafe.ai/api/me 2>/dev/null)"
  if [[ "$code" != 200 ]]; then
    echo "saved, but console.typesafe.ai rejected it (HTTP $code); copy a fresh Cookie header while logged in" >&2
    return 1
  fi
  chmod 600 "$jar" 2>/dev/null
  printf 'console session stored in %s\n' "$jar"
  return 0
}


# ---- Agent Wrapper Inventory ---------------------------------------
# agents [--provider ...] lists the coding-CLI launch wrappers defined in
# this file and the settings each one pins. With no flags every provider is
# shown; one or more provider flags restrict the listing (union).
agents() {
  local -a want=()
  local arg

  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        printf 'Usage: agents [--claude] [--grok] [--antigravity] [--codex] [--kimi] [--devin] [--cmd] [--opencode] [--pi]\n'
        printf '  Lists coding-CLI launch wrappers and the settings each pins.\n'
        printf '  With no flags, lists every provider; flags select providers.\n'
        return 0
        ;;
      --claude|--grok|--antigravity|--agy|--codex|--kimi|--devin|--cmd|--command-code|--opencode|--oc|--pi)
        arg="${arg#--}"
        case "$arg" in
          agy) arg="antigravity" ;;
          command-code) arg="cmd" ;;
          oc) arg="opencode" ;;
        esac
        want+=("$arg")
        ;;
      *)
        printf 'agents: unrecognized option %q\n' "$arg" >&2
        printf 'Usage: agents [--claude] [--grok] [--antigravity] [--codex] [--kimi] [--devin] [--cmd] [--opencode] [--pi]\n' >&2
        return 1
        ;;
    esac
  done

  # provider|wrapper|model|effort|mode. Keep in sync with the wrapper
  # definitions below (this is a static inventory, not introspection).
  local table
  table="$(cat <<'EOF'
claude|ccm|opus[1m]|max|sub
claude|ccmM|opus[1m]|max|sub, 16 subagents, depth 2, tool concurrency 16, workflow agents 18
claude|ccu|opus[1m]|ultracode|sub
claude|ccx|opus[1m]|xhigh|sub
claude|ccxX|opus[1m]|xhigh|sub, 16 subagents, depth 2, tool concurrency 16, workflow agents 18
claude|cch|opus[1m]|high|sub
claude|ccmm|opus[1m]|medium|sub
claude|ccbm|opus[1m]|max|sub+safe
claude|ccbu|opus[1m]|ultracode|sub+safe
claude|ccbx|opus[1m]|xhigh|sub+safe
claude|ccbh|opus[1m]|high|sub+safe
claude|ccbmm|opus[1m]|medium|sub+safe
claude|ccfm|fable[1m]|max|sub
claude|ccfu|fable[1m]|ultracode|sub
claude|ccfx|fable[1m]|xhigh|sub
claude|ccfh|fable[1m]|high|sub
claude|ccfmm|fable[1m]|medium|sub
claude|ccbfm|fable[1m]|max|sub+safe
claude|ccbfu|fable[1m]|ultracode|sub+safe
claude|ccbfx|fable[1m]|xhigh|sub+safe
claude|ccbfh|fable[1m]|high|sub+safe
claude|ccbfmm|fable[1m]|medium|sub+safe
claude|csm|claude-sonnet-5-5[1m]|max|sub
